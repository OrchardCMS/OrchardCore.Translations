#: EmailPermissions.cs
msgctxt "OrchardCore.Email.EmailPermissions"
msgid "Manage Email Settings"
msgstr "管理电子邮件设置"

#: Services/DefaultEmailService.cs
msgctxt "OrchardCore.Email.Services.DefaultEmailService"
msgid "Email settings must be configured before an Email message can be sent."
msgstr "发送电子邮件前必须先配置电子邮件设置。"

#. Format arguments: {0}: address
#: Services/EmailMessageValidator.cs
#, csharp-format
msgctxt "OrchardCore.Email.Services.EmailMessageValidator"
msgid "Invalid email address for the recipient: '{0}'."
msgstr "收件人的电子邮件地址无效：'{0}'。"

#. Format arguments: {0}: address
#: Services/EmailMessageValidator.cs
#, csharp-format
msgctxt "OrchardCore.Email.Services.EmailMessageValidator"
msgid "Invalid email address for the sender: '{0}'."
msgstr "发件人的电子邮件地址无效：'{0}'。"

#: Services/EmailMessageValidator.cs
msgctxt "OrchardCore.Email.Services.EmailMessageValidator"
msgid ""
"The mail message should have at least one of these headers: To, Cc or Bcc."
msgstr "邮件至少应包含以下标头之一：To、Cc 或 Bcc。"
