#: Views/AutoroutePart.Edit.cshtml
msgctxt "OrchardCore.Autoroute.Views.AutoroutePart.Edit"
msgid "Absolute"
msgstr "Absolut"

#: Views/AutoroutePart.Edit.cshtml
msgctxt "OrchardCore.Autoroute.Views.AutoroutePart.Edit"
msgid "Check to disable autoroute for this content item."
msgstr "Markera för att inaktivera autoroute för detta innehållsobjekt."

#: Views/AutoroutePart.Edit.cshtml
msgctxt "OrchardCore.Autoroute.Views.AutoroutePart.Edit"
msgid "Check to enabling the routing of child content items."
msgstr "Markera för att aktivera routing av underordnade innehållsobjekt."

#: Views/AutoroutePart.Edit.cshtml
msgctxt "OrchardCore.Autoroute.Views.AutoroutePart.Edit"
msgid "Check to refresh the path. Warning: the previous URL won't be accessible anymore."
msgstr "Kryssa i för att uppdatera sökvägen. Varning: föregående URL kommer inte längre att vara tillgänglig."

#: Views/AutoroutePart.Edit.cshtml
msgctxt "OrchardCore.Autoroute.Views.AutoroutePart.Edit"
msgid "Check to set this content item as the homepage once published."
msgstr "Kryssa i för att sätta detta innehållsobjekt som startsida när den publicerats."

#: Views/AutoroutePart.Edit.cshtml
msgctxt "OrchardCore.Autoroute.Views.AutoroutePart.Edit"
msgid "Check to specify that a child content item will be routed to an absolute path."
msgstr "Markera för att ange att ett underordnat innehållsobjekt kommer att dirigeras till en absolut sökväg."

#: Views/AutoroutePart.Edit.cshtml
msgctxt "OrchardCore.Autoroute.Views.AutoroutePart.Edit"
msgid "Disabled"
msgstr "Inaktiverad"

#: Views/AutoroutePart.Edit.cshtml
msgctxt "OrchardCore.Autoroute.Views.AutoroutePart.Edit"
msgid "Permalink"
msgstr "Permalänk"

#: Views/AutoroutePart.Edit.cshtml
msgctxt "OrchardCore.Autoroute.Views.AutoroutePart.Edit"
msgid "Refresh the path"
msgstr "Uppdatera sökvägen"

#: Views/AutoroutePart.Edit.cshtml
msgctxt "OrchardCore.Autoroute.Views.AutoroutePart.Edit"
msgid "Route contained items"
msgstr "Dirigera underliggande objekt"

#: Views/AutoroutePart.Edit.cshtml
msgctxt "OrchardCore.Autoroute.Views.AutoroutePart.Edit"
msgid "Set as homepage"
msgstr "Sätt som startsida"

#: Views/AutoroutePart.Edit.cshtml
msgctxt "OrchardCore.Autoroute.Views.AutoroutePart.Edit"
msgid "The url of the content item. It will be automatically generated."
msgstr "URL:en för innehållsobjektet. Den kommer att automatiskt genereras."

#: Views/AutoroutePart.Edit.cshtml
msgctxt "OrchardCore.Autoroute.Views.AutoroutePart.Edit"
msgid "The url of the content item. Leave empty to auto-generate it."
msgstr "URL:en för innehållsobjektet. Lämna tomt för att regenerera den."

#: Views/AutoroutePart.Edit.cshtml
msgctxt "OrchardCore.Autoroute.Views.AutoroutePart.Edit"
msgid "This content item is the current homepage"
msgstr "Innehållsobjektet är den nuvarande startsidan"

#: Views/AutoroutePartSettings.Edit.cshtml
msgctxt "OrchardCore.Autoroute.Views.AutoroutePartSettings.Edit"
msgid "Allow absolute path"
msgstr "Tillåt absolut sökväg"

#: Views/AutoroutePartSettings.Edit.cshtml
msgctxt "OrchardCore.Autoroute.Views.AutoroutePartSettings.Edit"
msgid "Allow contained item routing"
msgstr "Tillåt dirigering av underordnade objekt"

#: Views/AutoroutePartSettings.Edit.cshtml
msgctxt "OrchardCore.Autoroute.Views.AutoroutePartSettings.Edit"
msgid "Allow custom path"
msgstr "Tillåt anpassad sökväg"

#: Views/AutoroutePartSettings.Edit.cshtml
msgctxt "OrchardCore.Autoroute.Views.AutoroutePartSettings.Edit"
msgid "Allow disabled"
msgstr "Tillåt inaktiverad"

#: Views/AutoroutePartSettings.Edit.cshtml
msgctxt "OrchardCore.Autoroute.Views.AutoroutePartSettings.Edit"
msgid "Allow path updates"
msgstr "Tillåt uppdateringar av sökväg"

#: Views/AutoroutePartSettings.Edit.cshtml
msgctxt "OrchardCore.Autoroute.Views.AutoroutePartSettings.Edit"
msgid "Check to allow the content items of this content type to be set as the homepage. It will only be visible to users with the appropriate permission."
msgstr "Kryssa i för att tillåta innehållsobjekt av denna innehållstyp att sättas till startsida. Den kommer endast vara synlig för användare med lämpliga rättigheter."

#: Views/AutoroutePartSettings.Edit.cshtml
msgctxt "OrchardCore.Autoroute.Views.AutoroutePartSettings.Edit"
msgid "Check to allow the content items of this content type to disable autoroute."
msgstr "Markera för att tillåta innehållsobjekt av den här innehållstypen att inaktivera autoroute."

#: Views/AutoroutePartSettings.Edit.cshtml
msgctxt "OrchardCore.Autoroute.Views.AutoroutePartSettings.Edit"
msgid "Check to allow this part to apply routes to child content items. This setting must be applied to the child content item."
msgstr "Markera för att tillåta användare att aktivera dirigering av underordnade innehållsobjekt. Denna inställning måste tillämpas på det överordnade innehållsobjektet."

#: Views/AutoroutePartSettings.Edit.cshtml
msgctxt "OrchardCore.Autoroute.Views.AutoroutePartSettings.Edit"
msgid "Check to allow users to enable absolute paths for child content items. When disabled the path is relative to the parents path."
msgstr "Markera för att tillåta användare att aktivera absoluta sökvägar för underordnade innehållsobjekt. När sökvägen är inaktiverad är sökvägen relativ till föräldrarnas sökväg."

#: Views/AutoroutePartSettings.Edit.cshtml
msgctxt "OrchardCore.Autoroute.Views.AutoroutePartSettings.Edit"
msgid "Check to allow users to enable routing of child content items. This setting must be applied to the parent content item."
msgstr "Markera för att tillåta användare att aktivera dirigering av underordnade innehållsobjekt. Denna inställning måste tillämpas på det överordnade innehållsobjektet."

#: Views/AutoroutePartSettings.Edit.cshtml
msgctxt "OrchardCore.Autoroute.Views.AutoroutePartSettings.Edit"
msgid "Check to allow users to refresh the path once a content item is already published."
msgstr "Kryssa i för att tillåta användare att uppdatera sökvägen när ett innehållsobjekt redan publicerats."

#: Views/AutoroutePartSettings.Edit.cshtml
msgctxt "OrchardCore.Autoroute.Views.AutoroutePartSettings.Edit"
msgid "Check to allow users to set a custom path, otherwise it will be automatically generated."
msgstr "Kryssa i för att tillåta användare att sätta en anpassad sökväg, annars kommer den att genereras automatiskt."

#: Views/AutoroutePartSettings.Edit.cshtml
msgctxt "OrchardCore.Autoroute.Views.AutoroutePartSettings.Edit"
msgid "Container Settings"
msgstr "Inställningar för behållare"

#: Views/AutoroutePartSettings.Edit.cshtml
msgctxt "OrchardCore.Autoroute.Views.AutoroutePartSettings.Edit"
msgid "Manage contained item routes"
msgstr "Hantera innehållsrutter för underliggande objekt"

#: Views/AutoroutePartSettings.Edit.cshtml
msgctxt "OrchardCore.Autoroute.Views.AutoroutePartSettings.Edit"
msgid "Pattern"
msgstr "Mönster"

#: Views/AutoroutePartSettings.Edit.cshtml
msgctxt "OrchardCore.Autoroute.Views.AutoroutePartSettings.Edit"
msgid "Settings for parent or child content items."
msgstr "Inställningar för överordnade eller underordnade innehållsobjekt."

#: Views/AutoroutePartSettings.Edit.cshtml
msgctxt "OrchardCore.Autoroute.Views.AutoroutePartSettings.Edit"
msgid "Show homepage options"
msgstr "Visa egenskaper för startsida"

#: Views/AutoroutePartSettings.Edit.cshtml
msgctxt "OrchardCore.Autoroute.Views.AutoroutePartSettings.Edit"
msgid "The pattern used to render the custom url of this content type. With Liquid support."
msgstr "Mönstret som används för att rendera den anpassade URL:en för denna innehållstyp. Med stöd för Liquid."

#: Views/AutoroutePartSettings.Edit.cshtml
msgctxt "OrchardCore.Autoroute.Views.AutoroutePartSettings.Edit"
msgid "When absolute : https://mysite.com/my-child-item."
msgstr "När absolut : https://mysite.com/my-child-item."

#: Views/AutoroutePartSettings.Edit.cshtml
msgctxt "OrchardCore.Autoroute.Views.AutoroutePartSettings.Edit"
msgid "When relative : https://mysite.com/my-parent/my-child-item."
msgstr "När relativ : https://mysite.com/my-parent/my-child-item."

