msgctxt "OrchardCore.Localization.DataAnnotations.DataAnnotationsDefaultErrorMessages"
msgid "The CustomValidationAttribute method '{0}' in type '{1}' must match the expected signature: public static ValidationResult {0}(object value, ValidationContext context). The value can be strongly typed. The ValidationContext parameter is optional."
msgstr "CustomValidationAttribute metóda '{0}' v type '{1}' musí mať rovnaký podpis: public static ValidationResult {0}(object value, ValidationContext context). Hodnota môže byť zadaná napevno. Parameter pre ValidationContext nie je povinný."

#. Format arguments: {0}; {1}
#: DataAnnotations/DataAnnotationsDefaultErrorMessages.cs
#, csharp-format
msgctxt "OrchardCore.Localization.DataAnnotations.DataAnnotationsDefaultErrorMessages"
msgid "The CustomValidationAttribute method '{0}' in type '{1}' must return System.ComponentModel.DataAnnotations.ValidationResult.  Use System.ComponentModel.DataAnnotations.ValidationResult.Success to represent success."
msgstr "CustomValidationAttribute metóda '{0}' v type '{1}' musí vracať 'System.ComponentModel.DataAnnotations.ValidationResult'. Použite 'System.ComponentModel.DataAnnotations.ValidationResult.Success' pre reprezentovanie úspešného výsledku (success)."

#: DataAnnotations/DataAnnotationsDefaultErrorMessages.cs
msgctxt "OrchardCore.Localization.DataAnnotations.DataAnnotationsDefaultErrorMessages"
