#: Drivers/AutoroutePartDisplayDriver.cs
msgctxt "OrchardCore.Autoroute.Drivers.AutoroutePartDisplayDriver"
msgid "Your permalink is already in use."
msgstr "Ваша постоянная ссылка уже используется."

#: GraphQL/AutorouteInputObjectType.cs
msgctxt "OrchardCore.Autoroute.GraphQL.AutorouteInputObjectType"
msgid "the custom URL part of the content item"
msgstr "настраиваемая часть URL-адреса элемента содержимого"

#: GraphQL/AutorouteInputObjectType.cs
msgctxt "OrchardCore.Autoroute.GraphQL.AutorouteInputObjectType"
msgid "the path of the content item to filter"
msgstr "путь элемента содержимого для фильтрации"

#: GraphQL/AutorouteQueryObjectType.cs
msgctxt "OrchardCore.Autoroute.GraphQL.AutorouteQueryObjectType"
msgid "Custom URLs (permalinks) for your content item."
msgstr "Пользовательские URL-адреса (постоянные ссылки) для вашего элемента содержимого."

#: GraphQL/AutorouteQueryObjectType.cs
msgctxt "OrchardCore.Autoroute.GraphQL.AutorouteQueryObjectType"
msgid "The permalinks for your content item."
msgstr "Постоянные ссылки для вашего элемента содержимого."

#: Handlers/AutoroutePartHandler.cs
msgctxt "OrchardCore.Autoroute.Handlers.AutoroutePartHandler"
msgid "Your permalink is already in use."
msgstr "Ваша постоянная ссылка уже используется."

#. Format arguments: {0}: invalidCharactersForMessage
#: Models/AutoroutePartExtensions.cs
#, csharp-format
msgctxt "OrchardCore.Autoroute.Models.AutoroutePartExtensions"
msgid "Please do not use any of the following characters in your permalink: {0}. No spaces, or consecutive slashes, are allowed (please use dashes or underscores instead)."
msgstr "Пожалуйста, не используйте в своей постоянной ссылке какие-либо из следующих символов: {0}. Использование пробелов или последовательности из косых черт не допускается (вместо этого используйте тире или подчеркивания)."

#: Models/AutoroutePartExtensions.cs
msgctxt "OrchardCore.Autoroute.Models.AutoroutePartExtensions"
msgid "Your permalink can't be set to the homepage, please use the homepage option instead."
msgstr "Постоянная ссылка не может быть установлена для домашней страницы. Пожалуйста, используйте настройки домашней страницы."

#. Format arguments: {0}: AutoroutePart.MaxPathLength
#: Models/AutoroutePartExtensions.cs
#, csharp-format
msgctxt "OrchardCore.Autoroute.Models.AutoroutePartExtensions"
msgid "Your permalink is too long. The permalink can only be up to {0} characters."
msgstr "Слишком длинная постоянная ссылка. Ссылка может быть до {0} символов."

#. Format arguments: {0}: string.Join(" ", errors)
#: Settings/AutoroutePartSettingsDisplayDriver.cs
#, csharp-format
msgctxt "OrchardCore.Autoroute.Settings.AutoroutePartSettingsDisplayDriver"
msgid "Pattern doesn't contain a valid Liquid expression. Details: {0}"
msgstr "Шаблон не содержит допустимое выражение Liquid. Подробности: {0}"

#: Views/AutoroutePart.Edit.cshtml
msgctxt "OrchardCore.Autoroute.Views.AutoroutePart.Edit"
msgid "Absolute"
msgstr "Абсолютный"

#: Views/AutoroutePart.Edit.cshtml
msgctxt "OrchardCore.Autoroute.Views.AutoroutePart.Edit"
msgid "Check to disable autoroute for this content item."
msgstr "Отметьте, чтобы отключить автоматический роутинг для этого элемента."

#: Views/AutoroutePart.Edit.cshtml
msgctxt "OrchardCore.Autoroute.Views.AutoroutePart.Edit"
msgid "Check to enabling the routing of child content items."
msgstr "Отметьте, чтобы включить маршрутизацию дочерних элементов содержимого."

#: Views/AutoroutePart.Edit.cshtml
msgctxt "OrchardCore.Autoroute.Views.AutoroutePart.Edit"
msgid "Check to refresh the path. Warning: the previous URL won't be accessible anymore."
msgstr "Отметьте, чтобы обновить путь. Внимание: предыдущий URL больше не будет доступен."

#: Views/AutoroutePart.Edit.cshtml
msgctxt "OrchardCore.Autoroute.Views.AutoroutePart.Edit"
msgid "Check to set this content item as the homepage once published."
msgstr "Отметьте, чтобы установить этот элемент содержимого как домашнюю страницу после публикации."

#: Views/AutoroutePart.Edit.cshtml
msgctxt "OrchardCore.Autoroute.Views.AutoroutePart.Edit"
msgid "Check to specify that a child content item will be routed to an absolute path."
msgstr "Отметьте, чтобы указать, что элемент дочернего контента будет маршрутизирован по абсолютному пути."

#: Views/AutoroutePart.Edit.cshtml
msgctxt "OrchardCore.Autoroute.Views.AutoroutePart.Edit"
msgid "Disabled"
msgstr "Отключено"

#: Views/AutoroutePart.Edit.cshtml
msgctxt "OrchardCore.Autoroute.Views.AutoroutePart.Edit"
msgid "Permalink"
msgstr "Постоянная ссылка"

#: Views/AutoroutePart.Edit.cshtml
msgctxt "OrchardCore.Autoroute.Views.AutoroutePart.Edit"
msgid "Refresh the path"
msgstr "Обновить путь"

#: Views/AutoroutePart.Edit.cshtml
msgctxt "OrchardCore.Autoroute.Views.AutoroutePart.Edit"
msgid "Route contained items"
msgstr "Содержимое маршрута"

#: Views/AutoroutePart.Edit.cshtml
msgctxt "OrchardCore.Autoroute.Views.AutoroutePart.Edit"
msgid "Set as homepage"
msgstr "Установить в качестве домашней страницы"

#: Views/AutoroutePart.Edit.cshtml
msgctxt "OrchardCore.Autoroute.Views.AutoroutePart.Edit"
msgid "The url of the content item. It will be automatically generated."
msgstr "Url элемента содержимого. Он будет автоматически сгенерирован."

#: Views/AutoroutePart.Edit.cshtml
msgctxt "OrchardCore.Autoroute.Views.AutoroutePart.Edit"
msgid "The url of the content item. Leave empty to auto-generate it."
msgstr "Url элемента содержимого. Оставьте пустым, чтобы автоматически сгенерировать его."

#: Views/AutoroutePart.Edit.cshtml
msgctxt "OrchardCore.Autoroute.Views.AutoroutePart.Edit"
msgid "This content item is the current homepage"
msgstr "Этот элемент содержимого является текущей домашней страницей"

#: Views/AutoroutePartSettings.Edit.cshtml
msgctxt "OrchardCore.Autoroute.Views.AutoroutePartSettings.Edit"
msgid "Allow absolute path"
msgstr "Разрешить абсолютный путь"

#: Views/AutoroutePartSettings.Edit.cshtml
msgctxt "OrchardCore.Autoroute.Views.AutoroutePartSettings.Edit"
msgid "Allow contained item routing"
msgstr "Разрешить маршрутизацию для элементов содержимого"

#: Views/AutoroutePartSettings.Edit.cshtml
msgctxt "OrchardCore.Autoroute.Views.AutoroutePartSettings.Edit"
msgid "Allow custom path"
msgstr "Разрешить пользовательский путь"

#: Views/AutoroutePartSettings.Edit.cshtml
msgctxt "OrchardCore.Autoroute.Views.AutoroutePartSettings.Edit"
msgid "Allow disabled"
msgstr "Разрешено отключение"

#: Views/AutoroutePartSettings.Edit.cshtml
msgctxt "OrchardCore.Autoroute.Views.AutoroutePartSettings.Edit"
msgid "Allow path updates"
msgstr "Разрешить обновления пути"

#: Views/AutoroutePartSettings.Edit.cshtml
msgctxt "OrchardCore.Autoroute.Views.AutoroutePartSettings.Edit"
msgid "Check to allow the content items of this content type to be set as the homepage. It will only be visible to users with the appropriate permission."
msgstr "Установите этот флажок, чтобы разрешить установку элементов контента этого типа в качестве домашней страницы. Он будет виден только пользователям с соответствующим разрешением."

#: Views/AutoroutePartSettings.Edit.cshtml
msgctxt "OrchardCore.Autoroute.Views.AutoroutePartSettings.Edit"
msgid "Check to allow the content items of this content type to disable autoroute."
msgstr "Отметьте, чтобы разрешить элементам содержимого этого типа контента отключать автоматическую маршрутизацию."

#: Views/AutoroutePartSettings.Edit.cshtml
msgctxt "OrchardCore.Autoroute.Views.AutoroutePartSettings.Edit"
msgid "Check to allow this part to apply routes to child content items. This setting must be applied to the child content item."
msgstr "Отметьте, чтобы разрешить этой секции применять маршрутизацию к дочерним элементам содержимого. Этот параметр должен применяться к дочернему элементу содержимого."

#: Views/AutoroutePartSettings.Edit.cshtml
msgctxt "OrchardCore.Autoroute.Views.AutoroutePartSettings.Edit"
msgid "Check to allow users to enable absolute paths for child content items. When disabled the path is relative to the parents path."
msgstr "Отметьте, чтобы разрешить пользователям включать абсолютные пути для дочерних элементов содержимого. Если отключено, путь будет относительным к родительскому пути."

#: Views/AutoroutePartSettings.Edit.cshtml
msgctxt "OrchardCore.Autoroute.Views.AutoroutePartSettings.Edit"
msgid "Check to allow users to enable routing of child content items. This setting must be applied to the parent content item."
msgstr "Отметьте, чтобы разрешить пользователям включать маршрутизацию дочерних элементов содержимого. Этот параметр должен применяться к родительскому элементу содержимого."

#: Views/AutoroutePartSettings.Edit.cshtml
msgctxt "OrchardCore.Autoroute.Views.AutoroutePartSettings.Edit"
msgid "Check to allow users to refresh the path once a content item is already published."
msgstr "Отметьте, чтобы пользователи могли обновить путь после публикации элемента содержимого."

#: Views/AutoroutePartSettings.Edit.cshtml
msgctxt "OrchardCore.Autoroute.Views.AutoroutePartSettings.Edit"
msgid "Check to allow users to set a custom path, otherwise it will be automatically generated."
msgstr "Отметьте, чтобы пользователи могли установить свой путь, иначе он будет автоматически сгенерирован."

#: Views/AutoroutePartSettings.Edit.cshtml
msgctxt "OrchardCore.Autoroute.Views.AutoroutePartSettings.Edit"
msgid "Container Settings"
msgstr "Настройки контейнера"

#: Views/AutoroutePartSettings.Edit.cshtml
msgctxt "OrchardCore.Autoroute.Views.AutoroutePartSettings.Edit"
msgid "Manage contained item routes"
msgstr "Управление маршрутами объектов"

#: Views/AutoroutePartSettings.Edit.cshtml
msgctxt "OrchardCore.Autoroute.Views.AutoroutePartSettings.Edit"
msgid "Pattern"
msgstr "Шаблон"

#: Views/AutoroutePartSettings.Edit.cshtml
msgctxt "OrchardCore.Autoroute.Views.AutoroutePartSettings.Edit"
msgid "Settings for parent or child content items."
msgstr "Настройки для родительских или дочерних элементов содержимого."

#: Views/AutoroutePartSettings.Edit.cshtml
msgctxt "OrchardCore.Autoroute.Views.AutoroutePartSettings.Edit"
msgid "Show homepage options"
msgstr "Показать параметры домашней страницы"

#: Views/AutoroutePartSettings.Edit.cshtml
msgctxt "OrchardCore.Autoroute.Views.AutoroutePartSettings.Edit"
msgid "The pattern used to render the custom url of this content type. With Liquid support."
msgstr "Шаблон, используемый для отображения пользовательского url данного типа содержимого. С поддержкой Liquid."

#: Views/AutoroutePartSettings.Edit.cshtml
msgctxt "OrchardCore.Autoroute.Views.AutoroutePartSettings.Edit"
msgid "When absolute : https://mysite.com/my-child-item."
msgstr "Если абсолютный: https://mysite.com/my-child-item."

#: Views/AutoroutePartSettings.Edit.cshtml
msgctxt "OrchardCore.Autoroute.Views.AutoroutePartSettings.Edit"
msgid "When relative : https://mysite.com/my-parent/my-child-item."
msgstr "Если относительный: https://mysite.com/my-parent/my-child-item."

