msgstr "Метод CustomValidationAttribute '{0}' типа '{1}' должен соответствовать ожидаемой сигнатуре: public static ValidationResult {0}(object value, ValidationContext context). Значение должно быть типизированным. Параметр ValidationContext является необязательным."

#. Format arguments: {0}; {1}
#: DataAnnotations/DataAnnotationsDefaultErrorMessages.cs
#, csharp-format
msgctxt "OrchardCore.Localization.DataAnnotations.DataAnnotationsDefaultErrorMessages"
msgid "The CustomValidationAttribute method '{0}' in type '{1}' must return System.ComponentModel.DataAnnotations.ValidationResult.  Use System.ComponentModel.DataAnnotations.ValidationResult.Success to represent success."
msgstr "Метод CustomValidationAttribute '{0}' типа '{1}' должен возвращать System.ComponentModel.DataAnnotations.ValidationResult. Используйте System.ComponentModel.DataAnnotations.ValidationResult.Success для успешного возврата."

#: DataAnnotations/DataAnnotationsDefaultErrorMessages.cs
msgctxt "OrchardCore.Localization.DataAnnotations.DataAnnotationsDefaultErrorMessages"
msgid "The CustomValidationAttribute.Method was not specified."
msgstr "CustomValidationAttribute.Method не указан."

#: DataAnnotations/DataAnnotationsDefaultErrorMessages.cs
msgctxt "OrchardCore.Localization.DataAnnotations.DataAnnotationsDefaultErrorMessages"
msgid "The CustomValidationAttribute.ValidatorType was not specified."
msgstr "Не указан CustomValidationAttribute.ValidatorType."

