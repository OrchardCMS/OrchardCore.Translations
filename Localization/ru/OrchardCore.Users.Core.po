msgctxt "OrchardCore.Users.Services.UserService"
msgid "Passwords must have at least one digit character ('0'-'9')."
msgstr "Пароли должны содержать хотя бы одну цифру ('0'-'9')."

#: Services/UserService.cs
msgctxt "OrchardCore.Users.Services.UserService"
