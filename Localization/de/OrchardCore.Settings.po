#: Drivers/DefaultSiteSettingsDisplayDriver.cs
msgctxt "OrchardCore.Settings.Drivers.DefaultSiteSettingsDisplayDriver"
msgid "Enter at least one page size when page size selection is allowed."
msgstr "Geben Sie mindestens eine Seitengröße ein, wenn die Auswahl der Seitengröße erlaubt ist."

#: Drivers/DefaultSiteSettingsDisplayDriver.cs
msgctxt "OrchardCore.Settings.Drivers.DefaultSiteSettingsDisplayDriver"
msgid "The Base url must be a fully qualified URL."
msgstr "Die Basis-URL muss eine voll qualifizierte URL sein."

#: Drivers/DefaultSiteSettingsDisplayDriver.cs
msgctxt "OrchardCore.Settings.Drivers.DefaultSiteSettingsDisplayDriver"
msgid "The CDN base url must be a fully qualified URL."
msgstr "Die CDN-Basis-URL muss eine vollständig qualifizierte URL sein."

#: Drivers/DefaultSiteSettingsDisplayDriver.cs
msgctxt "OrchardCore.Settings.Drivers.DefaultSiteSettingsDisplayDriver"
msgid "The page size must be greater than zero."
msgstr "Die Seitengröße muss größer als null sein."

#. Format arguments: {0}: site.MaxPageSize
#: Drivers/DefaultSiteSettingsDisplayDriver.cs
#, csharp-format
msgctxt "OrchardCore.Settings.Drivers.DefaultSiteSettingsDisplayDriver"
msgid "The page size must be less than or equal to {0}."
msgstr "Die Seitengröße muss kleiner oder gleich {0} sein."

#: Drivers/DefaultSiteSettingsDisplayDriver.cs
msgctxt "OrchardCore.Settings.Drivers.DefaultSiteSettingsDisplayDriver"
msgid "The page size options must be a comma-separated list of positive numbers."
msgstr "Die Optionen für die Seitengröße müssen eine durch Kommas getrennte Liste positiver Zahlen sein."

#. Format arguments: {0}: site.MaxPageSize
#: Drivers/DefaultSiteSettingsDisplayDriver.cs
#, csharp-format
msgctxt "OrchardCore.Settings.Drivers.DefaultSiteSettingsDisplayDriver"
msgid "The page size options must be less than or equal to {0}."
msgstr "Die Optionen für die Seitengröße müssen kleiner oder gleich {0} sein."

