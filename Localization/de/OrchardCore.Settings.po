msgid "Page size options"
msgstr "Seitengrößenoptionen"

#: Views/Settings-Site.Edit.cshtml
msgctxt "OrchardCore.Settings.Views.Settings-Site.Edit"
msgid "Page size selection"
msgstr "Seitengrößenauswahl"

#: Views/Settings-Site.Edit.cshtml
msgctxt "OrchardCore.Settings.Views.Settings-Site.Edit"
msgid "Page title format"
msgstr "Format des Seitentitels"

#: Views/Settings-Site.Edit.cshtml
msgctxt "OrchardCore.Settings.Views.Settings-Site.Edit"
msgid "Site name"
msgstr "Website-Name"

#: Views/Settings-Site.Edit.cshtml
msgctxt "OrchardCore.Settings.Views.Settings-Site.Edit"
msgid "The default format of page titles."
msgstr "Das Standardformat für Seitentitel."

#: Views/Settings-Site.Edit.cshtml
msgctxt "OrchardCore.Settings.Views.Settings-Site.Edit"
msgid "The default page size."
msgstr "Die Standardseitengröße."

#: Views/Settings-Site.Edit.cshtml
msgctxt "OrchardCore.Settings.Views.Settings-Site.Edit"
msgid "The site name."
msgstr "Der Name der Website."

#. Format arguments: {0}: Model.MaxPageSize
#: Views/Settings-Site.Edit.cshtml
#, csharp-format
msgctxt "OrchardCore.Settings.Views.Settings-Site.Edit"
msgid "Values cannot exceed the maximum page size of {0}."
msgstr "Die Werte dürfen die maximale Seitengröße von {0} nicht überschreiten."

#: Views/Settings-Site.Edit.cshtml
msgctxt "OrchardCore.Settings.Views.Settings-Site.Edit"
msgid "When enabled, a selector is shown on listing pages so users can choose how many items are displayed per page."
msgstr "Wenn diese Option aktiviert ist, wird auf Listenseiten eine Auswahl angezeigt, über die Benutzer festlegen können, wie viele Elemente pro Seite angezeigt werden."

