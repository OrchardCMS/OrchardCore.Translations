#: Views/Settings-Cache.Edit.cshtml
msgctxt "OrchardCore.Settings.Views.Settings-Cache.Edit"
msgid "Cache Mode"
msgstr "Cachemodus"

#: Views/Settings-Cache.Edit.cshtml
msgctxt "OrchardCore.Settings.Views.Settings-Cache.Edit"
msgid "Determines whether caches are enabled or disabled."
msgstr "Legt fest, ob Caches aktiviert oder deaktiviert sind."

#: Views/Settings-Cache.Edit.cshtml
msgctxt "OrchardCore.Settings.Views.Settings-Cache.Edit"
msgid "Disabled"
msgstr "Deaktiviert"

#: Views/Settings-Cache.Edit.cshtml
msgctxt "OrchardCore.Settings.Views.Settings-Cache.Edit"
msgid "Enabled"
msgstr "Aktiviert"

#: Views/Settings-Cache.Edit.cshtml
msgctxt "OrchardCore.Settings.Views.Settings-Cache.Edit"
msgid "Enabled with cache debug mode"
msgstr "Mit Cache-Debugmodus aktiviert"

#: Views/Settings-Cache.Edit.cshtml
msgctxt "OrchardCore.Settings.Views.Settings-Cache.Edit"
msgid "From environment — enabled in Production, disabled otherwise"
msgstr "Aus der Umgebung – in Production aktiviert, andernfalls deaktiviert"

#: Views/Settings-Cache.Edit.cshtml
msgctxt "OrchardCore.Settings.Views.Settings-Cache.Edit"
msgid "Settings for dynamic caches"
msgstr "Einstellungen für dynamische Caches"

#: Views/Settings-Reload.Wrapper.cshtml
msgctxt "OrchardCore.Settings.Views.Settings-Reload.Wrapper"
msgid "The website might be restarted upon saving the settings, potentially leading to temporary unresponsiveness during the process."
msgstr "Die Website wird möglicherweise beim Speichern der Einstellungen neu gestartet. Währenddessen kann sie vorübergehend nicht reagieren."

#: Views/Settings-Resources.Edit.cshtml
msgctxt "OrchardCore.Settings.Views.Settings-Resources.Edit"
msgid "A base CDN URL prefixed to the local scripts and stylesheets. It is disabled if the value is empty or if the Resource Debug Mode is enabled, e.g. <em>https://cdn.mysite.com</em>"
msgstr "Eine CDN-Basis-URL, die den lokalen Skripten und Stylesheets vorangestellt wird. Sie ist deaktiviert, wenn der Wert leer ist oder der Ressourcen-Debugmodus aktiviert ist, z. B. <em>https://cdn.mysite.com</em>"

#: Views/Settings-Resources.Edit.cshtml
msgctxt "OrchardCore.Settings.Views.Settings-Resources.Edit"
msgid "Determines whether scripts and stylesheets load in their debuggable or minified form."
msgstr "Legt fest, ob Skripte und Stylesheets in debugfähiger oder minimierter Form geladen werden."

#: Views/Settings-Resources.Edit.cshtml
msgctxt "OrchardCore.Settings.Views.Settings-Resources.Edit"
msgid "Disabled — use minified version of resources"
msgstr "Deaktiviert – minimierte Version der Ressourcen verwenden"

#: Views/Settings-Resources.Edit.cshtml
msgctxt "OrchardCore.Settings.Views.Settings-Resources.Edit"
msgid "Enabled — use debuggable version of resources"
msgstr "Aktiviert – debugfähige Version der Ressourcen verwenden"

#: Views/Settings-Resources.Edit.cshtml
msgctxt "OrchardCore.Settings.Views.Settings-Resources.Edit"
msgid "From environment — disabled in Production, enabled otherwise"
msgstr "Aus der Umgebung – in Production deaktiviert, andernfalls aktiviert"

#: Views/Settings-Resources.Edit.cshtml
msgctxt "OrchardCore.Settings.Views.Settings-Resources.Edit"
msgid "Resource Debug Mode"
msgstr "Ressourcen-Debugmodus"

#: Views/Settings-Resources.Edit.cshtml
msgctxt "OrchardCore.Settings.Views.Settings-Resources.Edit"
msgid "Settings for scripts and stylesheets"
msgstr "Einstellungen für Skripte und Stylesheets"

#: Views/Settings-Resources.Edit.cshtml
msgctxt "OrchardCore.Settings.Views.Settings-Resources.Edit"
msgid "Site CDN (Content Delivery Network) base url"
msgstr "Basis-URL des Website-CDN (Content Delivery Network)"

#: Views/Settings-Resources.Edit.cshtml
msgctxt "OrchardCore.Settings.Views.Settings-Resources.Edit"
msgid "Use framework CDN (Content Delivery Network)"
msgstr "Framework-CDN (Content Delivery Network) verwenden"

#: Views/Settings-Resources.Edit.cshtml
msgctxt "OrchardCore.Settings.Views.Settings-Resources.Edit"
msgid "Use resources cache busting"
msgstr "Cache-Busting für Ressourcen verwenden"

#: Views/Settings-Resources.Edit.cshtml
msgctxt "OrchardCore.Settings.Views.Settings-Resources.Edit"
msgid "Whether a framework CDN is used for registered scripts and stylesheets, such as jQuery, or their local version"
msgstr "Legt fest, ob für registrierte Skripte und Stylesheets, etwa jQuery, ein Framework-CDN oder die lokale Version verwendet wird."

#: Views/Settings-Resources.Edit.cshtml
msgctxt "OrchardCore.Settings.Views.Settings-Resources.Edit"
msgid "Whether cache busting (append a version) is used for scripts and stylesheets"
msgstr "Legt fest, ob für Skripte und Stylesheets Cache-Busting verwendet wird (Anhängen einer Version)."

#: Views/Settings-Site.Edit.cshtml
msgctxt "OrchardCore.Settings.Views.Settings-Site.Edit"
msgid "A comma-separated list of the page size values users can select from, for example 10, 25, 50, 100."
msgstr "Eine durch Kommas getrennte Liste der Seitengrößen, aus denen Benutzer auswählen können, z. B. 10, 25, 50, 100."

#: Views/Settings-Site.Edit.cshtml
msgctxt "OrchardCore.Settings.Views.Settings-Site.Edit"
msgid "Allow users to change the page size on listing pages"
msgstr "Benutzern erlauben, die Seitengröße auf Listenseiten zu ändern"

#: Views/Settings-Site.Edit.cshtml
msgctxt "OrchardCore.Settings.Views.Settings-Site.Edit"
msgid "Base url"
msgstr "Basis-URL"

#: Views/Settings-Site.Edit.cshtml
msgctxt "OrchardCore.Settings.Views.Settings-Site.Edit"
msgid "Default Time Zone"
msgstr "Standardzeitzone"

#: Views/Settings-Site.Edit.cshtml
msgctxt "OrchardCore.Settings.Views.Settings-Site.Edit"
msgid "Determines the default time zone used when displaying and editing dates and times. DST (daylight saving time) will be applied automatically per time zone if available."
msgstr "Legt die Standardzeitzone fest, die beim Anzeigen und Bearbeiten von Datums- und Zeitangaben verwendet wird. Die Sommerzeit (DST) wird, sofern verfügbar, automatisch je nach Zeitzone angewendet."

#: Views/Settings-Site.Edit.cshtml
msgctxt "OrchardCore.Settings.Views.Settings-Site.Edit"
msgid "Enter the fully qualified base URL of the web site."
msgstr "Geben Sie die vollständig qualifizierte Basis-URL der Website ein."

#: Views/Settings-Site.Edit.cshtml
msgctxt "OrchardCore.Settings.Views.Settings-Site.Edit"
msgid "Local to server"
msgstr "Lokal auf dem Server"

#: Views/Settings-Site.Edit.cshtml
msgctxt "OrchardCore.Settings.Views.Settings-Site.Edit"
msgid "Page size"
msgstr "Seitengröße"

#: Views/Settings-Site.Edit.cshtml
