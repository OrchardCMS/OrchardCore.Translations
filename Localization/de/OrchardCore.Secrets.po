msgctxt "OrchardCore.Secrets.Controllers.AdminController"
msgid "The certificate thumbprint is required."
msgstr "Der Fingerabdruck des Zertifikats ist erforderlich."

#: Controllers/AdminController.cs
msgctxt "OrchardCore.Secrets.Controllers.AdminController"
msgid "The secret value is required."
msgstr "Der Geheimniswert ist erforderlich."

#. Format arguments: {0}: count
#: Controllers/MigrationController.cs
#, csharp-format
msgctxt "OrchardCore.Secrets.Controllers.MigrationController"
msgid "1 credential was moved to a secret."
msgid_plural "{0} credentials were moved to secrets."
msgstr[0] "1 Anmeldeinformation wurde in ein Geheimnis verschoben."
msgstr[1] "{0} Anmeldeinformationen wurden in Geheimnisse verschoben."

#: Controllers/MigrationController.cs
msgctxt "OrchardCore.Secrets.Controllers.MigrationController"
msgid "Select a writable secret store."
msgstr "Wählen Sie einen beschreibbaren Geheimnisspeicher aus."

#: Controllers/MigrationController.cs
msgctxt "OrchardCore.Secrets.Controllers.MigrationController"
msgid "Select at least one credential to move."
msgstr "Wählen Sie mindestens eine zu verschiebende Anmeldeinformation aus."

#: Controllers/MigrationController.cs
msgctxt "OrchardCore.Secrets.Controllers.MigrationController"
msgid "Some credentials could not be moved. Their settings were left unchanged."
msgstr "Einige Anmeldeinformationen konnten nicht verschoben werden. Die zugehörigen Einstellungen wurden nicht geändert."

#: Controllers/StoreController.cs
msgctxt "OrchardCore.Secrets.Controllers.StoreController"
msgid "Confirm the operation before continuing."
msgstr "Bestätigen Sie den Vorgang, bevor Sie fortfahren."

#: Controllers/StoreController.cs
msgctxt "OrchardCore.Secrets.Controllers.StoreController"
msgid "Select a different writable destination store."
msgstr "Wählen Sie einen anderen beschreibbaren Zielspeicher aus."

#: Controllers/StoreController.cs
msgctxt "OrchardCore.Secrets.Controllers.StoreController"
msgid "Select an available writable source store."
msgstr "Wählen Sie einen verfügbaren, beschreibbaren Quellspeicher aus."

#: Controllers/StoreController.cs
msgctxt "OrchardCore.Secrets.Controllers.StoreController"
msgid "Some secrets could not be processed. Review the individual results before retrying or disabling the store."
msgstr "Einige Geheimnisse konnten nicht verarbeitet werden. Überprüfen Sie die einzelnen Ergebnisse, bevor Sie den Vorgang wiederholen oder den Speicher deaktivieren."

#: Controllers/StoreController.cs
msgctxt "OrchardCore.Secrets.Controllers.StoreController"
msgid "The store could not be inspected. Its cleanup status is unknown; do not disable it based on this page."
msgstr "Der Speicher konnte nicht überprüft werden. Der Status der Bereinigung ist unbekannt. Deaktivieren Sie ihn nicht aufgrund dieser Seite."

#: Controllers/StoreController.cs
msgctxt "OrchardCore.Secrets.Controllers.StoreController"
msgid "The store operation could not be completed. Check store availability, permissions, and whether another operation is in progress."
msgstr "Der Speichervorgang konnte nicht abgeschlossen werden. Überprüfen Sie die Verfügbarkeit und Berechtigungen des Speichers sowie, ob gerade ein anderer Vorgang ausgeführt wird."

#: Drivers/RsaSecretDisplayDriver.cs
msgctxt "OrchardCore.Secrets.Drivers.RsaSecretDisplayDriver"
msgid "Generate a new key pair to include a private key."
msgstr "Generieren Sie ein neues Schlüsselpaar, um einen privaten Schlüssel einzuschließen."

