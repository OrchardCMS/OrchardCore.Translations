#. context.ErrorMessage = S["The tenant should not be the '{0}' tenant.",
#. ShellSettings.DefaultShellName];
#: OrchardCore\Shell\Removing\ShellRemovalManager.cs:41
msgctxt "OrchardCore.Environment.Shell.Removing.ShellRemovalManager"
msgid "The tenant should not be the '{0}' tenant."
msgstr "Der Mandant darf nicht der '{0}'-Mandant sein."

#. context.ErrorMessage = S["The tenant '{0}' should be 'Disabled' or
#. 'Uninitialized'.", shellSettings.Name];
#: OrchardCore\Shell\Removing\ShellRemovalManager.cs:48
msgctxt "OrchardCore.Environment.Shell.Removing.ShellRemovalManager"
msgid "The tenant '{0}' should be 'Disabled' or 'Uninitialized'."
msgstr "Der Mandant '{0}' muss 'Disabled' oder 'Uninitialized' sein."

#. context.ErrorMessage = S["Failed to create a 'ShellContext' before removing
#. the tenant."];
#: OrchardCore\Shell\Removing\ShellRemovalManager.cs:68
msgctxt "OrchardCore.Environment.Shell.Removing.ShellRemovalManager"
msgid "Failed to create a 'ShellContext' before removing the tenant."
msgstr ""
"Vor dem Entfernen des Mandanten konnte kein 'ShellContext' erstellt werden."

#. context.ErrorMessage = S["Failed to acquire a lock before executing the
#. tenant handlers."];
#: OrchardCore\Shell\Removing\ShellRemovalManager.cs:82
msgctxt "OrchardCore.Environment.Shell.Removing.ShellRemovalManager"
msgid "Failed to acquire a lock before executing the tenant handlers."
msgstr ""
"Vor der Ausführung der Mandanten-Handler konnte keine Sperre erworben "
"werden."

#. context.ErrorMessage = S["Failed to execute the tenant handler '{0}'.",
#. type];
#: OrchardCore\Shell\Removing\ShellRemovalManager.cs:115
msgctxt "OrchardCore.Environment.Shell.Removing.ShellRemovalManager"
msgid "Failed to execute the tenant handler '{0}'."
msgstr "Der Mandanten-Handler '{0}' konnte nicht ausgeführt werden."

#. context.ErrorMessage = S["Failed to acquire a lock before executing the
#. host handlers."];
#: OrchardCore\Shell\Removing\ShellRemovalManager.cs:135
msgctxt "OrchardCore.Environment.Shell.Removing.ShellRemovalManager"
msgid "Failed to acquire a lock before executing the host handlers."
msgstr ""
"Vor der Ausführung der Host-Handler konnte keine Sperre erworben werden."

#. context.ErrorMessage = S["Failed to execute the host handler '{0}'.",
#. type];
#: OrchardCore\Shell\Removing\ShellRemovalManager.cs:170
msgctxt "OrchardCore.Environment.Shell.Removing.ShellRemovalManager"
msgid "Failed to execute the host handler '{0}'."
msgstr "Der Host-Handler '{0}' konnte nicht ausgeführt werden."

#. context.ErrorMessage = S["Failed to remove the shell settings."];
#: OrchardCore\Shell\Removing\ShellSettingsRemovingHandler.cs:46
msgctxt "OrchardCore.Environment.Shell.Removing.ShellSettingsRemovingHandler"
msgid "Failed to remove the shell settings."
msgstr "Die Shell-Einstellungen konnten nicht entfernt werden."

#. context.ErrorMessage = S["Failed to remove the site folder '{0}'.",
#. shellAppDataFolder];
#: OrchardCore\Shell\Removing\ShellSiteFolderRemovingHandler.cs:67
msgctxt ""
"OrchardCore.Environment.Shell.Removing.ShellSiteFolderRemovingHandler"
msgid "Failed to remove the site folder '{0}'."
msgstr "Der Websiteordner '{0}' konnte nicht entfernt werden."

#. context.ErrorMessage = S["Failed to remove the web root folder '{0}'.",
#. shellWebRootFolder];
#: OrchardCore\Shell\Removing\ShellWebRootRemovingHandler.cs:71
msgctxt "OrchardCore.Environment.Shell.Removing.ShellWebRootRemovingHandler"
msgid "Failed to remove the web root folder '{0}'."
msgstr "Der Webroot-Ordner '{0}' konnte nicht entfernt werden."
