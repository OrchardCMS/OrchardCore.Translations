#. RoleDescription = S["A system role that grants all permissions to the
#. assigned users."],
#: OrchardCore.Roles.Core\DefaultSystemRoleProvider.cs:22
msgctxt "OrchardCore.Roles.DefaultSystemRoleProvider"
msgid "A system role that grants all permissions to the assigned users."
msgstr ""
"Eine Systemrolle, die den zugewiesenen Benutzern alle Berechtigungen "
"gewährt."

#. RoleDescription = S["A system role representing all authenticated users."],
#: OrchardCore.Roles.Core\DefaultSystemRoleProvider.cs:32
msgctxt "OrchardCore.Roles.DefaultSystemRoleProvider"
msgid "A system role representing all authenticated users."
msgstr "Eine Systemrolle, die alle authentifizierten Benutzer repräsentiert."

#. RoleDescription = S["A system role representing all non-authenticated
#. users."],
#: OrchardCore.Roles.Core\DefaultSystemRoleProvider.cs:39
msgctxt "OrchardCore.Roles.DefaultSystemRoleProvider"
msgid "A system role representing all non-authenticated users."
msgstr ""
"Eine Systemrolle, die alle nicht authentifizierten Benutzer repräsentiert."

