#: DefaultSystemRoleProvider.cs
msgctxt "OrchardCore.Roles.DefaultSystemRoleProvider"
msgid "A system role representing all authenticated users."
msgstr "Eine Systemrolle, die alle authentifizierten Benutzer repräsentiert."

#: DefaultSystemRoleProvider.cs
msgctxt "OrchardCore.Roles.DefaultSystemRoleProvider"
msgid "A system role representing all non-authenticated users."
msgstr "Eine Systemrolle, die alle nicht authentifizierten Benutzer repräsentiert."

#: DefaultSystemRoleProvider.cs
msgctxt "OrchardCore.Roles.DefaultSystemRoleProvider"
msgid "A system role that grants all permissions to the assigned users."
msgstr "Eine Systemrolle, die den zugewiesenen Benutzern alle Berechtigungen gewährt."

#: RolesPermissions.cs
msgctxt "OrchardCore.Roles.RolesPermissions"
msgid "Manage Roles"
msgstr "Rollen verwalten"

#: RolesPermissions.cs
msgctxt "OrchardCore.Roles.RolesPermissions"
msgid "View Roles"
msgstr "Rollen anzeigen"

