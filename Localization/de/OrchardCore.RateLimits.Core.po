#: RateLimitsPermissions.cs
msgctxt "OrchardCore.RateLimits.Core.RateLimitsPermissions"
msgid "Manage Rate Limits"
msgstr "Ratenbegrenzungen verwalten"

#: Recipes/CreateOrUpdateRateLimitPoliciesStep.cs
msgctxt "OrchardCore.RateLimits.Recipes.CreateOrUpdateRateLimitPoliciesStep"
msgid "The 'policies' array is required."
msgstr "Das Array 'policies' ist erforderlich."

#. Format arguments: {0}: policy.Name ?? policy.PolicyId ?? string.Empty
#: Recipes/CreateOrUpdateRateLimitPoliciesStep.cs
#, csharp-format
msgctxt "OrchardCore.RateLimits.Recipes.CreateOrUpdateRateLimitPoliciesStep"
msgid "The endpoint policy '{0}' must define a request path."
msgstr "Die Endpunktrichtlinie '{0}' muss einen Anforderungspfad definieren."

#. Format arguments: {0}: policy.Name ?? policy.PolicyId ?? string.Empty
#: Recipes/CreateOrUpdateRateLimitPoliciesStep.cs
#, csharp-format
msgctxt "OrchardCore.RateLimits.Recipes.CreateOrUpdateRateLimitPoliciesStep"
msgid "The endpoint policy '{0}' must use a request path that starts with '/'."
msgstr "Die Endpunktrichtlinie '{0}' muss einen Anforderungspfad verwenden, der mit '/' beginnt."

#. Format arguments: {0}: policy.Name ?? policy.PolicyId ?? string.Empty
#: Recipes/CreateOrUpdateRateLimitPoliciesStep.cs
#, csharp-format
msgctxt "OrchardCore.RateLimits.Recipes.CreateOrUpdateRateLimitPoliciesStep"
msgid "The group policy '{0}' must define a rate-limit group."
msgstr "Die Gruppenrichtlinie '{0}' muss eine Ratenbegrenzungsgruppe definieren."

#. Format arguments: {0}: policy.Name ?? policy.PolicyId ?? string.Empty
#: Recipes/CreateOrUpdateRateLimitPoliciesStep.cs
#, csharp-format
msgctxt "OrchardCore.RateLimits.Recipes.CreateOrUpdateRateLimitPoliciesStep"
msgid "The policy '{0}' has an unsupported scope."
msgstr "Die Richtlinie '{0}' hat einen nicht unterstützten Geltungsbereich."

