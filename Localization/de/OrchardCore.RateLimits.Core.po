#. context.Errors.Add(S["The 'policies' array is required."]);
#: OrchardCore.RateLimits.Core\Recipes\CreateOrUpdateRateLimitPoliciesStep.cs:48
msgctxt "OrchardCore.RateLimits.Recipes.CreateOrUpdateRateLimitPoliciesStep"
msgid "The 'policies' array is required."
msgstr "Das Array 'policies' ist erforderlich."

#. context.Errors.Add(S["The policy '{0}' has an unsupported scope.",
#. policy.Name ?? policy.PolicyId ?? string.Empty]);
#: OrchardCore.RateLimits.Core\Recipes\CreateOrUpdateRateLimitPoliciesStep.cs:104
msgctxt "OrchardCore.RateLimits.Recipes.CreateOrUpdateRateLimitPoliciesStep"
msgid "The policy '{0}' has an unsupported scope."
msgstr "Die Richtlinie '{0}' hat einen nicht unterstützten Geltungsbereich."

#. context.Errors.Add(S["The endpoint policy '{0}' must define a request
#. path.", policy.Name ?? policy.PolicyId ?? string.Empty]);
#: OrchardCore.RateLimits.Core\Recipes\CreateOrUpdateRateLimitPoliciesStep.cs:112
msgctxt "OrchardCore.RateLimits.Recipes.CreateOrUpdateRateLimitPoliciesStep"
msgid "The endpoint policy '{0}' must define a request path."
msgstr "Die Endpunktrichtlinie '{0}' muss einen Anforderungspfad definieren."

#. context.Errors.Add(S["The endpoint policy '{0}' must use a request path
#. that starts with '/'.", policy.Name ?? policy.PolicyId ?? string.Empty]);
#: OrchardCore.RateLimits.Core\Recipes\CreateOrUpdateRateLimitPoliciesStep.cs:118
msgctxt "OrchardCore.RateLimits.Recipes.CreateOrUpdateRateLimitPoliciesStep"
msgid ""
"The endpoint policy '{0}' must use a request path that starts with '/'."
msgstr ""
"Die Endpunktrichtlinie '{0}' muss einen Anforderungspfad verwenden, der mit "
"'/' beginnt."

#. context.Errors.Add(S["The group policy '{0}' must define a rate-limit
#. group.", policy.Name ?? policy.PolicyId ?? string.Empty]);
#: OrchardCore.RateLimits.Core\Recipes\CreateOrUpdateRateLimitPoliciesStep.cs:125
msgctxt "OrchardCore.RateLimits.Recipes.CreateOrUpdateRateLimitPoliciesStep"
msgid "The group policy '{0}' must define a rate-limit group."
msgstr ""
"Die Gruppenrichtlinie '{0}' muss eine Ratenbegrenzungsgruppe definieren."

