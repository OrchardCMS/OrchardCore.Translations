msgid "Allow any origin"
msgstr "Beliebigen Ursprung zulassen"

#: Services/CorsJSLocalizer.cs
msgctxt "OrchardCore.Cors.Services.CorsJSLocalizer"
msgid "Allow certain or all headers to be used by the external client."
msgstr "Bestimmte oder alle Header zulassen, die vom externen Client verwendet werden dürfen."

#: Services/CorsJSLocalizer.cs
msgctxt "OrchardCore.Cors.Services.CorsJSLocalizer"
msgid "Allow credentials"
msgstr "Zugangsdaten zulassen"

#: Services/CorsJSLocalizer.cs
msgctxt "OrchardCore.Cors.Services.CorsJSLocalizer"
msgid "Allowed headers"
msgstr "Zulässige Header"

#: Services/CorsJSLocalizer.cs
msgctxt "OrchardCore.Cors.Services.CorsJSLocalizer"
msgid "Allowed methods"
msgstr "Zulässige Methoden"

#: Services/CorsJSLocalizer.cs
msgctxt "OrchardCore.Cors.Services.CorsJSLocalizer"
msgid "Allowed origins"
msgstr "Zulässige Ursprünge"

#: Services/CorsJSLocalizer.cs
msgctxt "OrchardCore.Cors.Services.CorsJSLocalizer"
msgid "Allows credentials to be transported in requests. This setting is not allowed in combination with Allow Any Origin."
msgstr "Ermöglicht die Übertragung von Zugangsdaten in Anfragen. Diese Einstellung darf nicht mit „Beliebigen Ursprung zulassen“ kombiniert werden."

#: Services/CorsJSLocalizer.cs
msgctxt "OrchardCore.Cors.Services.CorsJSLocalizer"
msgid "Allows requests from any origin. This will bypass any origin that is configured below."
msgstr "Ermöglicht Anfragen von jedem Ursprung. Dadurch werden alle unten konfigurierten Ursprünge umgangen."

#: Services/CorsJSLocalizer.cs
msgctxt "OrchardCore.Cors.Services.CorsJSLocalizer"
msgid "Allows requests with any header. This will bypass any headers that are configured below."
msgstr "Ermöglicht Anfragen mit beliebigen Headern. Dadurch werden alle unten konfigurierten Header umgangen."

#: Services/CorsJSLocalizer.cs
msgctxt "OrchardCore.Cors.Services.CorsJSLocalizer"
msgid "Allows requests with any method. This will bypass any methods that are configured below."
msgstr "Ermöglicht Anfragen mit beliebigen Methoden. Dadurch werden alle unten konfigurierten Methoden umgangen."

#: Services/CorsJSLocalizer.cs
msgctxt "OrchardCore.Cors.Services.CorsJSLocalizer"
