#, csharp-format
msgctxt "OrchardCore.Users.Services.UserService"
msgid "User name '{0}' is invalid, can only contain letters or digits."
msgstr "Benutzername '{0}' ist ungültig, kann nur Buchstaben oder Ziffern enthalten."

