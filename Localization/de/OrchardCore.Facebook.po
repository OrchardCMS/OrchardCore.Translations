#: OrchardCore.Facebook\Views\Items\MetaConversionsApiEventTask.Fields.Edit.cshtml:48
msgctxt ""
"OrchardCore.Facebook.Views.Items.MetaConversionsApiEventTask.Fields.Edit"
msgid ""
"Optional. A unique id for this event, used to deduplicate it against the "
"same event reported by the browser Meta Pixel. With Liquid support."
msgstr ""
"Optional. Eine eindeutige ID für dieses Ereignis, anhand derer es mit "
"demselben vom browserseitigen Meta Pixel gemeldeten Ereignis dedupliziert "
"wird. Unterstützt Liquid."

