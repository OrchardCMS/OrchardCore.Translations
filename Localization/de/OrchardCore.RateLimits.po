#. <label asp-for="PermitLimit" class="ocat-label">@T["Permit limit"]</label>
#: OrchardCore.RateLimits\Views\ConcurrencyRateLimiter.Edit.cshtml:4
msgctxt "OrchardCore.RateLimits.Views.ConcurrencyRateLimiter.Edit"
msgid "Permit limit"
msgstr "Genehmigungslimit"

#. <span class="hint">@T["How many matching requests can run at the same time.
#. For example, 3 means a fourth request must wait or be rejected."]</span>
#: OrchardCore.RateLimits\Views\ConcurrencyRateLimiter.Edit.cshtml:8
msgctxt "OrchardCore.RateLimits.Views.ConcurrencyRateLimiter.Edit"
msgid ""
"How many matching requests can run at the same time. For example, 3 means a "
"fourth request must wait or be rejected."
msgstr ""
"Wie viele übereinstimmende Anforderungen gleichzeitig ausgeführt werden "
"können. Bei 3 muss beispielsweise eine vierte Anforderung warten oder wird "
"abgelehnt."

#. <label asp-for="QueueLimit" class="ocat-label">@T["Queue limit"]</label>
#: OrchardCore.RateLimits\Views\ConcurrencyRateLimiter.Edit.cshtml:13
msgctxt "OrchardCore.RateLimits.Views.ConcurrencyRateLimiter.Edit"
msgid "Queue limit"
msgstr "Warteschlangenlimit"

#. <span class="hint">@T["How many extra requests can wait for a free slot
#. while all running slots are busy. Use 0 to reject extras
#. immediately."]</span>
#: OrchardCore.RateLimits\Views\ConcurrencyRateLimiter.Edit.cshtml:17
msgctxt "OrchardCore.RateLimits.Views.ConcurrencyRateLimiter.Edit"
msgid ""
"How many extra requests can wait for a free slot while all running slots are"
" busy. Use 0 to reject extras immediately."
msgstr ""
"Wie viele zusätzliche Anforderungen warten können, während alle verfügbaren "
"Plätze belegt sind. Mit 0 werden weitere Anforderungen sofort abgelehnt."

#. <label asp-for="QueueProcessingOrder" class="ocat-label">@T["Queue
#. processing order"]</label>
#: OrchardCore.RateLimits\Views\ConcurrencyRateLimiter.Edit.cshtml:22
msgctxt "OrchardCore.RateLimits.Views.ConcurrencyRateLimiter.Edit"
msgid "Queue processing order"
msgstr "Reihenfolge der Warteschlangenverarbeitung"

#. <span class="hint">@T["Choose whether waiting requests are handled in
#. arrival order or whether the newest waiting request gets the next free slot
#. first."]</span>
#: OrchardCore.RateLimits\Views\ConcurrencyRateLimiter.Edit.cshtml:26
msgctxt "OrchardCore.RateLimits.Views.ConcurrencyRateLimiter.Edit"
msgid ""
"Choose whether waiting requests are handled in arrival order or whether the "
"newest waiting request gets the next free slot first."
msgstr ""
"Wählen Sie aus, ob wartende Anforderungen in der Reihenfolge ihres "
"Eintreffens verarbeitet werden oder ob die zuletzt eingetroffene wartende "
