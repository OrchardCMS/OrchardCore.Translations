#. public override LocalizedString DisplayName => S["Concurrency"];
#: OrchardCore.RateLimits\Services\ConcurrencyRateLimiterSource.cs:32
msgctxt "OrchardCore.RateLimits.Services.ConcurrencyRateLimiterSource"
msgid "Concurrency"
msgstr "Gleichzeitigkeit"

#. public override LocalizedString Description => S["Limits how many matching
#. requests can run at the same time, which is useful for expensive
#. operations."];
#: OrchardCore.RateLimits\Services\ConcurrencyRateLimiterSource.cs:35
msgctxt "OrchardCore.RateLimits.Services.ConcurrencyRateLimiterSource"
msgid ""
"Limits how many matching requests can run at the same time, which is useful "
"for expensive operations."
msgstr ""
"Begrenzt die Anzahl übereinstimmender Anforderungen, die gleichzeitig "
"ausgeführt werden können. Das ist bei ressourcenintensiven Vorgängen "
"hilfreich."

#. return S["{0} concurrent requests, queue limit {1}, queue order {2}",
#. model.PermitLimit, model.QueueLimit, model.QueueProcessingOrder];
#: OrchardCore.RateLimits\Services\ConcurrencyRateLimiterSource.cs:51
msgctxt "OrchardCore.RateLimits.Services.ConcurrencyRateLimiterSource"
msgid "{0} concurrent requests, queue limit {1}, queue order {2}"
msgstr ""
"{0} gleichzeitige Anforderungen, Warteschlangenlimit {1}, Reihenfolge {2}"

#. public override LocalizedString DisplayName => S["Fixed window"];
#: OrchardCore.RateLimits\Services\FixedWindowRateLimiterSource.cs:32
msgctxt "OrchardCore.RateLimits.Services.FixedWindowRateLimiterSource"
msgid "Fixed window"
msgstr "Festes Zeitfenster"

#. public override LocalizedString Description => S["Allows a set number of
#. requests during each time period, then resets the count all at once."];
#: OrchardCore.RateLimits\Services\FixedWindowRateLimiterSource.cs:35
msgctxt "OrchardCore.RateLimits.Services.FixedWindowRateLimiterSource"
msgid ""
"Allows a set number of requests during each time period, then resets the "
"count all at once."
msgstr ""
"Ermöglicht eine festgelegte Anzahl von Anforderungen pro Zeitraum und setzt "
"den Zähler anschließend auf einmal zurück."

#. return S["{0} requests every {1} seconds, queue limit {2}",
#. model.PermitLimit, model.WindowSeconds, model.QueueLimit];
#: OrchardCore.RateLimits\Services\FixedWindowRateLimiterSource.cs:52
msgctxt "OrchardCore.RateLimits.Services.FixedWindowRateLimiterSource"
msgid "{0} requests every {1} seconds, queue limit {2}"
msgstr "{0} Anforderungen alle {1} Sekunden, Warteschlangenlimit {2}"

#. public override LocalizedString DisplayName => S["Sliding window"];
#: OrchardCore.RateLimits\Services\SlidingWindowRateLimiterSource.cs:32
msgctxt "OrchardCore.RateLimits.Services.SlidingWindowRateLimiterSource"
msgid "Sliding window"
msgstr "Gleitendes Zeitfenster"

#. public override LocalizedString Description => S["Spreads a request limit
#. across a rolling time period so traffic is smoothed instead of resetting
#. all at once."];
#: OrchardCore.RateLimits\Services\SlidingWindowRateLimiterSource.cs:35
msgctxt "OrchardCore.RateLimits.Services.SlidingWindowRateLimiterSource"
msgid ""
"Spreads a request limit across a rolling time period so traffic is smoothed "
"instead of resetting all at once."
msgstr ""
"Verteilt ein Anforderungslimit über einen gleitenden Zeitraum, sodass der "
"Datenverkehr gleichmäßiger verteilt wird, anstatt den Zähler auf einmal "
"zurückzusetzen."

#. return S["{0} requests every {1} seconds across {2} segments, queue limit
#. {3}", model.PermitLimit, model.WindowSeconds, model.SegmentsPerWindow,
#. model.QueueLimit];
#: OrchardCore.RateLimits\Services\SlidingWindowRateLimiterSource.cs:53
msgctxt "OrchardCore.RateLimits.Services.SlidingWindowRateLimiterSource"
msgid "{0} requests every {1} seconds across {2} segments, queue limit {3}"
msgstr ""
"{0} Anforderungen alle {1} Sekunden über {2} Segmente, Warteschlangenlimit "
"{3}"

#. public override LocalizedString DisplayName => S["Token bucket"];
#: OrchardCore.RateLimits\Services\TokenBucketRateLimiterSource.cs:32
msgctxt "OrchardCore.RateLimits.Services.TokenBucketRateLimiterSource"
msgid "Token bucket"
msgstr "Tokenbucket"

#. public override LocalizedString Description => S["Allows short bursts of
#. traffic while steadily refilling capacity over time."];
#: OrchardCore.RateLimits\Services\TokenBucketRateLimiterSource.cs:35
msgctxt "OrchardCore.RateLimits.Services.TokenBucketRateLimiterSource"
msgid ""
"Allows short bursts of traffic while steadily refilling capacity over time."
msgstr ""
"Ermöglicht kurze Verkehrsspitzen und füllt die Kapazität im Laufe der Zeit "
"kontinuierlich wieder auf."

#. return S["{0} tokens, {1} replenished every {2} seconds, queue limit {3},
#. queue order {4}", model.TokenLimit, model.TokensPerPeriod,
#. model.ReplenishmentPeriodSeconds, model.QueueLimit,
#. model.QueueProcessingOrder];
#: OrchardCore.RateLimits\Services\TokenBucketRateLimiterSource.cs:54
msgctxt "OrchardCore.RateLimits.Services.TokenBucketRateLimiterSource"
msgid ""
"{0} tokens, {1} replenished every {2} seconds, queue limit {3}, queue order "
"{4}"
msgstr ""
"{0} Tokens, {1} werden alle {2} Sekunden aufgefüllt, Warteschlangenlimit "
"{3}, Reihenfolge {4}"

