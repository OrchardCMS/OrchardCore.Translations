#. Format arguments: {0}: field.Key
#: Expressions/ExpressionCompiler.cs
#, csharp-format
msgctxt "OrchardCore.DataSources.Expressions.ExpressionCompiler"
msgid "The field [{0}] does not exist."
msgstr "Das Feld [{0}] ist nicht vorhanden."

#. Format arguments: {0}: field.Key
#: Expressions/ExpressionCompiler.cs
#, csharp-format
msgctxt "OrchardCore.DataSources.Expressions.ExpressionCompiler"
msgid "The field [{0}] is already aggregated and cannot be aggregated again."
msgstr "Das Feld [{0}] ist bereits aggregiert und kann nicht erneut aggregiert werden."

#: Expressions/ExpressionCompiler.cs
msgctxt "OrchardCore.DataSources.Expressions.ExpressionCompiler"
msgid "The formula contains an unsupported element."
msgstr "Die Formel enthält ein nicht unterstütztes Element."

#: Expressions/ExpressionCompiler.cs
msgctxt "OrchardCore.DataSources.Expressions.ExpressionCompiler"
msgid "The formula mixes aggregated values (such as SUM) with row-level fields. Wrap each field in an aggregate function."
msgstr "Die Formel mischt aggregierte Werte (z. B. SUM) mit zeilenbezogenen Feldern. Umschließen Sie jedes Feld mit einer Aggregatfunktion."

#. Format arguments: {0}: function.Name
#: Expressions/ExpressionCompiler.cs
#, csharp-format
msgctxt "OrchardCore.DataSources.Expressions.ExpressionCompiler"
msgid "The function {0} cannot be used inside another aggregate function."
msgstr "Die Funktion {0} kann nicht innerhalb einer anderen Aggregatfunktion verwendet werden."

#. Format arguments: {0}: call.Name
#: Expressions/ExpressionCompiler.cs
#, csharp-format
msgctxt "OrchardCore.DataSources.Expressions.ExpressionCompiler"
msgid "The function {0} does not exist."
msgstr "Die Funktion {0} ist nicht vorhanden."

#. Format arguments: {0}: function.Name; {1}: function.Signature
#: Expressions/ExpressionCompiler.cs
#, csharp-format
msgctxt "OrchardCore.DataSources.Expressions.ExpressionCompiler"
msgid "The function {0} is written {1}."
msgstr "Die Funktion {0} wird als {1} geschrieben."

#. Format arguments: {0}: function.Name; {1}: argument.DataType
#: Expressions/ExpressionCompiler.cs
#, csharp-format
msgctxt "OrchardCore.DataSources.Expressions.ExpressionCompiler"
msgid "The function {0} needs a number, but receives a {1} value."
msgstr "Die Funktion {0} benötigt eine Zahl, erhält aber einen Wert vom Typ {1}."

#. Format arguments: {0}: binary.Operator; {1}: leftType; {2}: rightType
#: Expressions/ExpressionCompiler.cs
#, csharp-format
msgctxt "OrchardCore.DataSources.Expressions.ExpressionCompiler"
msgid "The operator '{0}' cannot combine {1} and {2} values."
msgstr "Der Operator '{0}' kann keine Werte vom Typ {1} und {2} miteinander kombinieren."

#. Format arguments: {0}: unary.Operator
#: Expressions/ExpressionCompiler.cs
#, csharp-format
msgctxt "OrchardCore.DataSources.Expressions.ExpressionCompiler"
msgid "The operator '{0}' needs a number."
msgstr "Der Operator '{0}' benötigt eine Zahl."

#. Format arguments: {0}: start + 1
#: Expressions/ExpressionLexer.cs
#, csharp-format
msgctxt "OrchardCore.DataSources.Expressions.ExpressionLexer"
msgid "The field reference that starts at position {0} has no closing ']'."
msgstr "Dem Feldverweis, der an Position {0} beginnt, fehlt die schließende Klammer „]“."

#. Format arguments: {0}: start + 1
#: Expressions/ExpressionLexer.cs
#, csharp-format
msgctxt "OrchardCore.DataSources.Expressions.ExpressionLexer"
msgid "The text that starts at position {0} has no closing quote."
msgstr "Dem Text, der an Position {0} beginnt, fehlt das schließende Anführungszeichen."

#. Format arguments: {0}: current; {1}: index + 1
#: Expressions/ExpressionLexer.cs
#, csharp-format
msgctxt "OrchardCore.DataSources.Expressions.ExpressionLexer"
msgid "Unexpected character '{0}' at position {1}."
msgstr "Unerwartetes Zeichen „{0}“ an Position {1}."

#. Format arguments: {0}: text; {1}: token.Position + 1; {2}: token.Text
#: Expressions/ExpressionParser.cs
#, csharp-format
msgctxt "OrchardCore.DataSources.Expressions.ExpressionParser"
msgid "Expected '{0}' at position {1} but found '{2}'."
msgstr "An Position {1} wurde „{2}“ gefunden, erwartet wurde jedoch „{0}“."

#. Format arguments: {0}: text
#: Expressions/ExpressionParser.cs
#, csharp-format
msgctxt "OrchardCore.DataSources.Expressions.ExpressionParser"
msgid "Expected '{0}' at the end of the formula."
msgstr "Am Ende der Formel wurde „{0}“ erwartet."

#. Format arguments: {0}: token.Position + 1
#: Expressions/ExpressionParser.cs
#, csharp-format
msgctxt "OrchardCore.DataSources.Expressions.ExpressionParser"
msgid "The field reference at position {0} is empty."
msgstr "Der Feldverweis an Position {0} ist leer."

#: Expressions/ExpressionParser.cs
msgctxt "OrchardCore.DataSources.Expressions.ExpressionParser"
msgid "The formula ends unexpectedly."
msgstr "Die Formel endet unerwartet."

#: Expressions/ExpressionParser.cs
msgctxt "OrchardCore.DataSources.Expressions.ExpressionParser"
msgid "The formula is empty."
msgstr "Die Formel ist leer."

#: Expressions/ExpressionParser.cs
msgctxt "OrchardCore.DataSources.Expressions.ExpressionParser"
msgid "The formula is nested too deeply."
msgstr "Die Formel ist zu tief verschachtelt."

#. Format arguments: {0}: token.Text; {1}: token.Position + 1
#: Expressions/ExpressionParser.cs
#, csharp-format
msgctxt "OrchardCore.DataSources.Expressions.ExpressionParser"
msgid "The number '{0}' at position {1} is too large."
msgstr "Die Zahl „{0}“ an Position {1} ist zu groß."

#. Format arguments: {0}: next.Text, token.Text; {1}: next.Position + 1, token.Position + 1
#: Expressions/ExpressionParser.cs
#, csharp-format
msgctxt "OrchardCore.DataSources.Expressions.ExpressionParser"
msgid "Unexpected '{0}' at position {1}."
msgstr "Unerwartetes „{0}“ an Position {1}."

#. Format arguments: {0}: token.Text; {1}: token.Position + 1
#: Expressions/ExpressionParser.cs
#, csharp-format
msgctxt "OrchardCore.DataSources.Expressions.ExpressionParser"
msgid "Unknown name '{0}' at position {1}. Write fields in square brackets, such as [Name]."
msgstr "Unbekannter Name „{0}“ an Position {1}. Schreiben Sie Felder in eckigen Klammern, z. B. [Name]."

#: Files/CsvDataFileFormat.cs
msgctxt "OrchardCore.DataSources.Files.CsvDataFileFormat"
msgid "CSV (comma separated values)"
msgstr "CSV (durch Kommas getrennte Werte)"

#: Files/ExcelDataFileFormat.cs
msgctxt "OrchardCore.DataSources.Files.ExcelDataFileFormat"
msgid "Excel workbook"
msgstr "Excel-Arbeitsmappe"

#: Files/ExcelDataFileFormat.cs
msgctxt "OrchardCore.DataSources.Files.ExcelDataFileFormat"
msgid "The file is not an Excel workbook."
msgstr "Die Datei ist keine Excel-Arbeitsmappe."

#. Format arguments: {0}: options.SheetName ?? string.Empty
#: Files/ExcelDataFileFormat.cs
#, csharp-format
msgctxt "OrchardCore.DataSources.Files.ExcelDataFileFormat"
msgid "The workbook has no worksheet named '{0}'."
msgstr "Die Arbeitsmappe enthält kein Tabellenblatt mit dem Namen „{0}“."

#. Format arguments: {0}: sheetName; {1}: maxRows
#: Files/ExcelDataFileFormat.cs
#, csharp-format
msgctxt "OrchardCore.DataSources.Files.ExcelDataFileFormat"
msgid "The worksheet '{0}' can hold {1} rows at most. Write the rows to a CSV file, or split them into several worksheets."
msgstr "Das Tabellenblatt „{0}“ kann höchstens {1} Zeilen enthalten. Schreiben Sie die Zeilen in eine CSV-Datei oder teilen Sie sie auf mehrere Tabellenblätter auf."

#: Files/JsonDataFileFormat.cs
msgctxt "OrchardCore.DataSources.Files.JsonDataFileFormat"
msgid "JSON"
msgstr "JSON"

