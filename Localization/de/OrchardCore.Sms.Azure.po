#. await _notifier.WarningAsync(H["You have successfully disabled the default
#. SMS provider. The SMS service is now disable and will remain disabled until
#. you designate a new default provider."]);
#: OrchardCore.Sms.Azure\Drivers\AzureSettingsDisplayDriver.cs:86
msgctxt "OrchardCore.Sms.Azure.Drivers.AzureSettingsDisplayDriver"
msgid ""
"You have successfully disabled the default SMS provider. The SMS service is "
"now disable and will remain disabled until you designate a new default "
"provider."
msgstr ""
"Sie haben den Standard-SMS-Anbieter erfolgreich deaktiviert. Der SMS-Dienst "
"ist jetzt deaktiviert und bleibt deaktiviert, bis Sie einen neuen "
"Standardanbieter festlegen."

