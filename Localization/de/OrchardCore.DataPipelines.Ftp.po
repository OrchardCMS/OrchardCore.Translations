#: Drivers/UploadToFtpStepDisplayDriver.cs
msgctxt "OrchardCore.DataPipelines.Ftp.Drivers.UploadToFtpStepDisplayDriver"
msgid "The port must be between 1 and 65535."
msgstr "Der Port muss zwischen 1 und 65535 liegen."

#: Drivers/UploadToFtpStepDisplayDriver.cs
msgctxt "OrchardCore.DataPipelines.Ftp.Drivers.UploadToFtpStepDisplayDriver"
msgid "The timeout must be at least one second."
msgstr "Das Timeout muss mindestens eine Sekunde betragen."

#. Format arguments: {0}: host; {1}: DataPipelineRemotePaths.Redact(ex.Message, password)
#: Steps/UploadToFtpStep.cs
#, csharp-format
msgctxt "OrchardCore.DataPipelines.Ftp.UploadToFtpStep"
msgid "Could not upload to the FTP server '{0}': {1}"
msgstr "Der Upload auf den FTP-Server '{0}' ist fehlgeschlagen: {1}"

#: Steps/UploadToFtpStep.cs
msgctxt "OrchardCore.DataPipelines.Ftp.UploadToFtpStep"
msgid "Enter the host of the FTP server."
msgstr "Geben Sie den Host des FTP-Servers ein."

#: Steps/UploadToFtpStep.cs
msgctxt "OrchardCore.DataPipelines.Ftp.UploadToFtpStep"
msgid "Enter the user name, such as anonymous for a public server."
msgstr "Geben Sie den Benutzernamen ein, z. B. anonymous für einen öffentlichen Server."

#. Format arguments: {0}: host
#: Steps/UploadToFtpStep.cs
#, csharp-format
msgctxt "OrchardCore.DataPipelines.Ftp.UploadToFtpStep"
msgid "The certificate of the FTP server '{0}' isn't validated."
msgstr "Das Zertifikat des FTP-Servers '{0}' wird nicht überprüft."

#: Steps/UploadToFtpStep.cs
msgctxt "OrchardCore.DataPipelines.Ftp.UploadToFtpStep"
msgid "The connection isn't encrypted: the credentials and the files travel in clear text."
msgstr "Die Verbindung ist nicht verschlüsselt: Die Anmeldedaten und Dateien werden im Klartext übertragen."

#. Format arguments: {0}: host
#: Steps/UploadToFtpStep.cs
#, csharp-format
msgctxt "OrchardCore.DataPipelines.Ftp.UploadToFtpStep"
msgid "The connection to the FTP server '{0}' isn't encrypted: the credentials and the files travel in clear text."
msgstr "Die Verbindung zum FTP-Server '{0}' ist nicht verschlüsselt: Die Anmeldedaten und Dateien werden im Klartext übertragen."

#. Format arguments: {0}: remotePath; {1}: host
#: Steps/UploadToFtpStep.cs
#, csharp-format
msgctxt "OrchardCore.DataPipelines.Ftp.UploadToFtpStep"
msgid "The file '{0}' already exists on the FTP server '{1}', and the step doesn't overwrite files."
msgstr "Die Datei '{0}' ist auf dem FTP-Server '{1}' bereits vorhanden, und der Schritt überschreibt keine Dateien."

#. Format arguments: {0}: settings.Host
#: Steps/UploadToFtpStep.cs
#, csharp-format
msgctxt "OrchardCore.DataPipelines.Ftp.UploadToFtpStep"
msgid "The host '{0}' isn't a valid host name or IP address."
msgstr "Der Host '{0}' ist kein gültiger Hostname und keine gültige IP-Adresse."

#: Steps/UploadToFtpStep.cs
msgctxt "OrchardCore.DataPipelines.Ftp.UploadToFtpStep"
msgid "The password can't be read on this site, such as when its data protection keys changed: enter it again."
msgstr "Das Kennwort kann auf dieser Website nicht gelesen werden, beispielsweise wenn sich die Datenschutzschlüssel geändert haben. Geben Sie es erneut ein."

#: Steps/UploadToFtpStep.cs
msgctxt "OrchardCore.DataPipelines.Ftp.UploadToFtpStep"
msgid "The port must be between 1 and 65535."
msgstr "Der Port muss zwischen 1 und 65535 liegen."

#: Steps/UploadToFtpStep.cs
msgctxt "OrchardCore.DataPipelines.Ftp.UploadToFtpStep"
msgid "The timeout must be at least one second."
msgstr "Das Timeout muss mindestens eine Sekunde betragen."

#: Steps/UploadToFtpStep.cs
msgctxt "OrchardCore.DataPipelines.Ftp.UploadToFtpStep"
msgid "Upload to an FTP server"
msgstr "Auf einen FTP-Server hochladen"

#. Format arguments: {0}: fileName; {1}: DataPipelineRemotePaths.ToDisplayUrl(scheme, host, settings.Port, remotePath)
#: Steps/UploadToFtpStep.cs
#, csharp-format
msgctxt "OrchardCore.DataPipelines.Ftp.UploadToFtpStep"
msgid "Uploaded '{0}' to {1}"
msgstr "'{0}' nach {1} hochgeladen"

#: Steps/UploadToFtpStep.cs
msgctxt "OrchardCore.DataPipelines.Ftp.UploadToFtpStep"
msgid "Uploads files to a folder of an FTP server."
msgstr "Lädt Dateien in einen Ordner auf einem FTP-Server hoch."

#: Views/UploadToFtp.Fields.Design.cshtml
msgctxt "OrchardCore.DataPipelines.Ftp.Views.UploadToFtp.Fields.Design"
msgid "Not encrypted"
msgstr "Nicht verschlüsselt"

#: Views/UploadToFtp.Fields.Edit.cshtml
msgctxt "OrchardCore.DataPipelines.Ftp.Views.UploadToFtp.Fields.Edit"
msgid "Clear it only for a server with a self-signed certificate on a trusted network."
msgstr "Deaktivieren Sie diese Option nur für einen Server mit selbstsigniertem Zertifikat in einem vertrauenswürdigen Netzwerk."

#. Format arguments: {0}: "{PipelineName}"; {1}: "{RunId}"; {2}: "{Date:format}"
#: Views/UploadToFtp.Fields.Edit.cshtml
#, csharp-format
msgctxt "OrchardCore.DataPipelines.Ftp.Views.UploadToFtp.Fields.Edit"
msgid "Created when it doesn't exist. Empty for the folder the user starts in. Placeholders: {0}, {1}, and {2}."
msgstr "Wird erstellt, falls der Ordner noch nicht existiert. Leer lassen, um den Ordner zu verwenden, in dem der Benutzer startet. Platzhalter: {0}, {1} und {2}."

#: Views/UploadToFtp.Fields.Edit.cshtml
msgctxt "OrchardCore.DataPipelines.Ftp.Views.UploadToFtp.Fields.Edit"
msgid "Encryption"
msgstr "Verschlüsselung"

#: Views/UploadToFtp.Fields.Edit.cshtml
msgctxt "OrchardCore.DataPipelines.Ftp.Views.UploadToFtp.Fields.Edit"
msgid "Explicit TLS (FTPES)"
msgstr "Explizites TLS (FTPES)"

#: Views/UploadToFtp.Fields.Edit.cshtml
msgctxt "OrchardCore.DataPipelines.Ftp.Views.UploadToFtp.Fields.Edit"
msgid "Host"
msgstr "Host"

#: Views/UploadToFtp.Fields.Edit.cshtml
msgctxt "OrchardCore.DataPipelines.Ftp.Views.UploadToFtp.Fields.Edit"
msgid "Implicit TLS (FTPS)"
msgstr "Implizites TLS (FTPS)"

#: Views/UploadToFtp.Fields.Edit.cshtml
msgctxt "OrchardCore.DataPipelines.Ftp.Views.UploadToFtp.Fields.Edit"
msgid "Leave empty to keep the current password."
msgstr "Leer lassen, um das aktuelle Kennwort beizubehalten."

#: Views/UploadToFtp.Fields.Edit.cshtml
msgctxt "OrchardCore.DataPipelines.Ftp.Views.UploadToFtp.Fields.Edit"
msgid "None (plain FTP)"
msgstr "Keine (FTP ohne Verschlüsselung)"

#: Views/UploadToFtp.Fields.Edit.cshtml
msgctxt "OrchardCore.DataPipelines.Ftp.Views.UploadToFtp.Fields.Edit"
msgid "Otherwise the step fails when a file with the same name exists."
msgstr "Andernfalls schlägt der Schritt fehl, wenn eine Datei mit demselben Namen vorhanden ist."

#: Views/UploadToFtp.Fields.Edit.cshtml
msgctxt "OrchardCore.DataPipelines.Ftp.Views.UploadToFtp.Fields.Edit"
msgid "Password"
msgstr "Kennwort"

#: Views/UploadToFtp.Fields.Edit.cshtml
msgctxt "OrchardCore.DataPipelines.Ftp.Views.UploadToFtp.Fields.Edit"
msgid "Plain FTP isn't encrypted: the user name, the password and the files travel in clear text."
msgstr "FTP ohne Verschlüsselung ist nicht sicher: Benutzername, Kennwort und Dateien werden im Klartext übertragen."

#: Views/UploadToFtp.Fields.Edit.cshtml
msgctxt "OrchardCore.DataPipelines.Ftp.Views.UploadToFtp.Fields.Edit"
msgid "Port"
msgstr "Port"

#: Views/UploadToFtp.Fields.Edit.cshtml
msgctxt "OrchardCore.DataPipelines.Ftp.Views.UploadToFtp.Fields.Edit"
msgid "Remote folder"
msgstr "Remote-Ordner"

#: Views/UploadToFtp.Fields.Edit.cshtml
msgctxt "OrchardCore.DataPipelines.Ftp.Views.UploadToFtp.Fields.Edit"
msgid "Remove the password"
msgstr "Kennwort entfernen"

#: Views/UploadToFtp.Fields.Edit.cshtml
msgctxt "OrchardCore.DataPipelines.Ftp.Views.UploadToFtp.Fields.Edit"
msgid "Replace existing files"
msgstr "Vorhandene Dateien ersetzen"

#: Views/UploadToFtp.Fields.Edit.cshtml
msgctxt "OrchardCore.DataPipelines.Ftp.Views.UploadToFtp.Fields.Edit"
msgid "Timeout (seconds)"
msgstr "Timeout (Sekunden)"

#: Views/UploadToFtp.Fields.Edit.cshtml
msgctxt "OrchardCore.DataPipelines.Ftp.Views.UploadToFtp.Fields.Edit"
msgid "User name"
msgstr "Benutzername"

#: Views/UploadToFtp.Fields.Edit.cshtml
msgctxt "OrchardCore.DataPipelines.Ftp.Views.UploadToFtp.Fields.Edit"
msgid "Usually 21, or 990 for implicit TLS."
msgstr "Normalerweise 21 oder 990 für implizites TLS."

#: Views/UploadToFtp.Fields.Edit.cshtml
msgctxt "OrchardCore.DataPipelines.Ftp.Views.UploadToFtp.Fields.Edit"
msgid "Validate the certificate of the server"
msgstr "Zertifikat des Servers überprüfen"

