msgstr "Wählen Sie eine Zeitzone aus."

#: Steps/Transforms/ConvertTimeZoneStep.cs
msgctxt "OrchardCore.DataPipelines.Steps.ConvertTimeZoneStep"
msgid "Convert time zone"
msgstr "Zeitzone umrechnen"

#: Steps/Transforms/ConvertTimeZoneStep.cs
msgctxt "OrchardCore.DataPipelines.Steps.ConvertTimeZoneStep"
msgid "Converts dates and times from UTC to a time zone, or from a time zone to UTC."
msgstr "Konvertiert Datums- und Zeitangaben von UTC in eine Zeitzone oder von einer Zeitzone nach UTC."

