#: OrchardCore.Elasticsearch.Core\Handlers\ElasticsearchIndexProfileHandler.cs:48
msgctxt ""
"OrchardCore.Elasticsearch.Core.Handlers.ElasticsearchIndexProfileHandler"
msgid ""
"Invalid index name: it must be lowercase, under 255 bytes, not start with -,"
" _, or +, and must not contain , /, *, ?, \", <, >, |, space, ,, or #, nor "
"be \".\" or \"..\"."
msgstr ""
"Ungültiger Indexname: Er muss kleingeschrieben sein, weniger als 255 Bytes "
"umfassen, darf nicht mit -, _, oder + beginnen und darf , /, *, ?, \", <, >,"
" |, Leerzeichen, ,, oder # nicht enthalten; außerdem darf er weder \".\" "
"noch \"..\" sein."

