msgid "At least one mapping property is required."
msgstr "Mindestens eine Mapping-Eigenschaft ist erforderlich."

#: Handlers/ElasticsearchIndexProfileHandler.cs
msgctxt "OrchardCore.Elasticsearch.Core.Handlers.ElasticsearchIndexProfileHandler"
msgid "Invalid index name: it must be lowercase, under 255 bytes, not start with -, _, or +, and must not contain , /, *, ?, \", <, >, |, space, ,, or #, nor be \".\" or \"..\"."
msgstr "Ungültiger Indexname: Er muss kleingeschrieben sein, weniger als 255 Bytes umfassen, darf nicht mit -, _, oder + beginnen und darf , /, *, ?, \", <, >, |, Leerzeichen, ,, oder # nicht enthalten; außerdem darf er weder \".\" noch \"..\" sein."

#. Format arguments: {0}: nameof(ElasticsearchIndexMap.KeyFieldName)
