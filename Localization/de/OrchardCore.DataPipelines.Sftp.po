#: Drivers/UploadToSftpStepDisplayDriver.cs
msgctxt "OrchardCore.DataPipelines.Sftp.Drivers.UploadToSftpStepDisplayDriver"
msgid ""
"Enter a SHA-256 fingerprint, such as "
"SHA256:ohD8VZEXGWo6Ez8GSEJQ9WpafgLFsOfLOtGGQCQo6Og."
msgstr ""
"Geben Sie einen SHA-256-Fingerabdruck ein, zum Beispiel "
"SHA256:ohD8VZEXGWo6Ez8GSEJQ9WpafgLFsOfLOtGGQCQo6Og."

#: Drivers/UploadToSftpStepDisplayDriver.cs
msgctxt "OrchardCore.DataPipelines.Sftp.Drivers.UploadToSftpStepDisplayDriver"
msgid "The port must be between 1 and 65535."
msgstr "Der Port muss zwischen 1 und 65535 liegen."

#: Drivers/UploadToSftpStepDisplayDriver.cs
msgctxt "OrchardCore.DataPipelines.Sftp.Drivers.UploadToSftpStepDisplayDriver"
msgid "The timeout must be at least one second."
msgstr "Das Timeout muss mindestens eine Sekunde betragen."

#. Format arguments: {0}: host; {1}:
#. DataPipelineRemotePaths.Redact(ex.Message, password, privateKey,
#. passphrase)
#: Steps/UploadToSftpStep.cs
#, csharp-format
msgctxt "OrchardCore.DataPipelines.Sftp.UploadToSftpStep"
msgid "Could not upload to the SFTP server '{0}': {1}"
msgstr "Der Upload auf den SFTP-Server '{0}' ist fehlgeschlagen: {1}"

#: Steps/UploadToSftpStep.cs
msgctxt "OrchardCore.DataPipelines.Sftp.UploadToSftpStep"
msgid "Enter a password or a private key."
msgstr "Geben Sie ein Passwort oder einen privaten Schlüssel ein."

#: Steps/UploadToSftpStep.cs
msgctxt "OrchardCore.DataPipelines.Sftp.UploadToSftpStep"
msgid "Enter the host of the SFTP server."
msgstr "Geben Sie den Host des SFTP-Servers ein."

#: Steps/UploadToSftpStep.cs
msgctxt "OrchardCore.DataPipelines.Sftp.UploadToSftpStep"
msgid "Enter the user name."
msgstr "Geben Sie den Benutzernamen ein."

#. Format arguments: {0}: host; {1}: presented
#: Steps/UploadToSftpStep.cs
#, csharp-format
msgctxt "OrchardCore.DataPipelines.Sftp.UploadToSftpStep"
msgid ""
"The SFTP server '{0}' presented the host key SHA256:{1}, which doesn't match"
" the expected fingerprint. The connection was refused."
msgstr ""
"Der SFTP-Server '{0}' hat den Hostschlüssel SHA256:{1} vorgelegt, der nicht "
"mit dem erwarteten Fingerabdruck übereinstimmt. Die Verbindung wurde "
"abgelehnt."

#: Steps/UploadToSftpStep.cs
msgctxt "OrchardCore.DataPipelines.Sftp.UploadToSftpStep"
msgid ""
"The credentials can't be read on this site, such as when its data protection"
" keys changed: enter them again."
msgstr ""
"Die Anmeldedaten können auf dieser Website nicht gelesen werden, zum "
"Beispiel wenn sich die Datenschlüssel geändert haben: Geben Sie sie erneut "
"ein."

#. Format arguments: {0}: remotePath; {1}: host
#: Steps/UploadToSftpStep.cs
#, csharp-format
msgctxt "OrchardCore.DataPipelines.Sftp.UploadToSftpStep"
msgid ""
"The file '{0}' already exists on the SFTP server '{1}', and the step doesn't"
" overwrite files."
msgstr ""
"Die Datei '{0}' ist auf dem SFTP-Server '{1}' bereits vorhanden und dieser "
"Schritt überschreibt keine Dateien."

#. Format arguments: {0}: settings.Host
#: Steps/UploadToSftpStep.cs
#, csharp-format
msgctxt "OrchardCore.DataPipelines.Sftp.UploadToSftpStep"
msgid "The host '{0}' isn't a valid host name or IP address."
msgstr ""
"Der Host '{0}' ist kein gültiger Hostname und keine gültige IP-Adresse."

#: Steps/UploadToSftpStep.cs
msgctxt "OrchardCore.DataPipelines.Sftp.UploadToSftpStep"
msgid ""
"The host key fingerprint must be a SHA-256 fingerprint, such as "
"SHA256:ohD8VZEXGWo6Ez8GSEJQ9WpafgLFsOfLOtGGQCQo6Og."
msgstr ""
"Der Fingerabdruck des Hostschlüssels muss ein SHA-256-Fingerabdruck sein, "
"zum Beispiel SHA256:ohD8VZEXGWo6Ez8GSEJQ9WpafgLFsOfLOtGGQCQo6Og."

#. Format arguments: {0}: host; {1}: presented
#: Steps/UploadToSftpStep.cs
#, csharp-format
msgctxt "OrchardCore.DataPipelines.Sftp.UploadToSftpStep"
msgid ""
"The host key of the SFTP server '{0}' isn't verified. To verify it, set its "
"fingerprint: SHA256:{1}"
msgstr ""
"Der Hostschlüssel des SFTP-Servers '{0}' wurde nicht verifiziert. Legen Sie "
"zum Verifizieren den Fingerabdruck fest: SHA256:{1}"

#: Steps/UploadToSftpStep.cs
msgctxt "OrchardCore.DataPipelines.Sftp.UploadToSftpStep"
msgid ""
"The host key of the server isn't verified: enter its SHA-256 fingerprint to "
"make sure the files go to the right server."
msgstr ""
"Der Hostschlüssel des Servers wurde nicht verifiziert: Geben Sie seinen "
"SHA-256-Fingerabdruck ein, damit die Dateien auf dem richtigen Server "
"landen."

#: Steps/UploadToSftpStep.cs
msgctxt "OrchardCore.DataPipelines.Sftp.UploadToSftpStep"
msgid "The port must be between 1 and 65535."
msgstr "Der Port muss zwischen 1 und 65535 liegen."

#: Steps/UploadToSftpStep.cs
msgctxt "OrchardCore.DataPipelines.Sftp.UploadToSftpStep"
msgid "The timeout must be at least one second."
msgstr "Das Timeout muss mindestens eine Sekunde betragen."

#: Steps/UploadToSftpStep.cs
msgctxt "OrchardCore.DataPipelines.Sftp.UploadToSftpStep"
msgid "Upload to an SFTP server"
msgstr "Auf einen SFTP-Server hochladen"

#. Format arguments: {0}: fileName; {1}:
#. DataPipelineRemotePaths.ToDisplayUrl("sftp", host, settings.Port,
#. remotePath)
#: Steps/UploadToSftpStep.cs
#, csharp-format
msgctxt "OrchardCore.DataPipelines.Sftp.UploadToSftpStep"
msgid "Uploaded '{0}' to {1}"
msgstr "'{0}' wurde nach {1} hochgeladen"

#: Steps/UploadToSftpStep.cs
msgctxt "OrchardCore.DataPipelines.Sftp.UploadToSftpStep"
msgid "Uploads files to a folder of an SFTP server, over SSH."
msgstr "Lädt Dateien über SSH in einen Ordner auf einem SFTP-Server hoch."

#: Views/UploadToSftp.Fields.Design.cshtml
msgctxt "OrchardCore.DataPipelines.Sftp.Views.UploadToSftp.Fields.Design"
msgid "Host key not verified"
msgstr "Hostschlüssel nicht verifiziert"

#: Views/UploadToSftp.Fields.Edit.cshtml
msgctxt "OrchardCore.DataPipelines.Sftp.Views.UploadToSftp.Fields.Edit"
msgid ""
"Authenticate with a password, a private key, or both when the server asks "
"for both."
msgstr ""
"Authentifizieren Sie sich mit einem Passwort, einem privaten Schlüssel oder "
"mit beidem, wenn der Server beides verlangt."

#. Format arguments: {0}: "{PipelineName}"; {1}: "{RunId}"; {2}:
#. "{Date:format}"
#: Views/UploadToSftp.Fields.Edit.cshtml
#, csharp-format
msgctxt "OrchardCore.DataPipelines.Sftp.Views.UploadToSftp.Fields.Edit"
msgid ""
"Created when it doesn't exist. Empty for the home folder of the user. "
"Placeholders: {0}, {1}, and {2}."
msgstr ""
"Wird erstellt, wenn der Ordner nicht existiert. Leer lassen, um den "
"Stammordner des Benutzers zu verwenden. Platzhalter: {0}, {1} und {2}."

#: Views/UploadToSftp.Fields.Edit.cshtml
msgctxt "OrchardCore.DataPipelines.Sftp.Views.UploadToSftp.Fields.Edit"
msgid "Host"
msgstr "Host"

#: Views/UploadToSftp.Fields.Edit.cshtml
msgctxt "OrchardCore.DataPipelines.Sftp.Views.UploadToSftp.Fields.Edit"
msgid "Host key fingerprint"
msgstr "Fingerabdruck des Hostschlüssels"

#: Views/UploadToSftp.Fields.Edit.cshtml
msgctxt "OrchardCore.DataPipelines.Sftp.Views.UploadToSftp.Fields.Edit"
msgid "Leave empty to keep the current passphrase."
msgstr "Leer lassen, um die aktuelle Passphrase beizubehalten."

#: Views/UploadToSftp.Fields.Edit.cshtml
msgctxt "OrchardCore.DataPipelines.Sftp.Views.UploadToSftp.Fields.Edit"
msgid "Leave empty to keep the current password."
msgstr "Leer lassen, um das aktuelle Passwort beizubehalten."

#: Views/UploadToSftp.Fields.Edit.cshtml
msgctxt "OrchardCore.DataPipelines.Sftp.Views.UploadToSftp.Fields.Edit"
msgid "Leave empty to keep the current private key."
msgstr "Leer lassen, um den aktuellen privaten Schlüssel beizubehalten."

#: Views/UploadToSftp.Fields.Edit.cshtml
msgctxt "OrchardCore.DataPipelines.Sftp.Views.UploadToSftp.Fields.Edit"
msgid "Otherwise the step fails when a file with the same name exists."
msgstr ""
"Andernfalls schlägt der Schritt fehl, wenn eine Datei mit demselben Namen "
"vorhanden ist."

#: Views/UploadToSftp.Fields.Edit.cshtml
msgctxt "OrchardCore.DataPipelines.Sftp.Views.UploadToSftp.Fields.Edit"
msgid "Passphrase"
msgstr "Passphrase"

#: Views/UploadToSftp.Fields.Edit.cshtml
msgctxt "OrchardCore.DataPipelines.Sftp.Views.UploadToSftp.Fields.Edit"
msgid "Password"
msgstr "Passwort"

#: Views/UploadToSftp.Fields.Edit.cshtml
msgctxt "OrchardCore.DataPipelines.Sftp.Views.UploadToSftp.Fields.Edit"
msgid "Port"
msgstr "Port"

#: Views/UploadToSftp.Fields.Edit.cshtml
msgctxt "OrchardCore.DataPipelines.Sftp.Views.UploadToSftp.Fields.Edit"
msgid "Private key"
msgstr "Privater Schlüssel"

#: Views/UploadToSftp.Fields.Edit.cshtml
msgctxt "OrchardCore.DataPipelines.Sftp.Views.UploadToSftp.Fields.Edit"
msgid "Remote folder"
msgstr "Remote-Ordner"

#: Views/UploadToSftp.Fields.Edit.cshtml
msgctxt "OrchardCore.DataPipelines.Sftp.Views.UploadToSftp.Fields.Edit"
msgid "Remove the passphrase"
msgstr "Passphrase entfernen"

#: Views/UploadToSftp.Fields.Edit.cshtml
msgctxt "OrchardCore.DataPipelines.Sftp.Views.UploadToSftp.Fields.Edit"
msgid "Remove the password"
msgstr "Passwort entfernen"

#: Views/UploadToSftp.Fields.Edit.cshtml
msgctxt "OrchardCore.DataPipelines.Sftp.Views.UploadToSftp.Fields.Edit"
msgid "Remove the private key"
msgstr "Privaten Schlüssel entfernen"

#: Views/UploadToSftp.Fields.Edit.cshtml
msgctxt "OrchardCore.DataPipelines.Sftp.Views.UploadToSftp.Fields.Edit"
msgid "Replace existing files"
msgstr "Vorhandene Dateien ersetzen"

#: Views/UploadToSftp.Fields.Edit.cshtml
msgctxt "OrchardCore.DataPipelines.Sftp.Views.UploadToSftp.Fields.Edit"
msgid ""
"The SHA-256 fingerprint of the server's host key, as shown by ssh-keyscan or"
" by the run history. The step refuses to connect to a server with another "
"key. When it is empty, the server isn't verified."
msgstr ""
"Der SHA-256-Fingerabdruck des Hostschlüssels des Servers, wie er von ssh-"
"keyscan oder im Ausführungsverlauf angezeigt wird. Der Schritt stellt keine "
"Verbindung zu einem Server mit einem anderen Schlüssel her. Wenn das Feld "
"leer ist, wird der Server nicht verifiziert."

#: Views/UploadToSftp.Fields.Edit.cshtml
msgctxt "OrchardCore.DataPipelines.Sftp.Views.UploadToSftp.Fields.Edit"
msgid ""
"The content of the key file, in PEM or OpenSSH format, starting with "
"-----BEGIN."
msgstr ""
"Der Inhalt der Schlüsseldatei im PEM- oder OpenSSH-Format, beginnend mit "
"-----BEGIN."

#: Views/UploadToSftp.Fields.Edit.cshtml
msgctxt "OrchardCore.DataPipelines.Sftp.Views.UploadToSftp.Fields.Edit"
msgid "Timeout (seconds)"
msgstr "Timeout (Sekunden)"

#: Views/UploadToSftp.Fields.Edit.cshtml
msgctxt "OrchardCore.DataPipelines.Sftp.Views.UploadToSftp.Fields.Edit"
msgid "User name"
msgstr "Benutzername"

#: Views/UploadToSftp.Fields.Edit.cshtml
msgctxt "OrchardCore.DataPipelines.Sftp.Views.UploadToSftp.Fields.Edit"
msgid "When the private key is encrypted."
msgstr "Wenn der private Schlüssel verschlüsselt ist."
