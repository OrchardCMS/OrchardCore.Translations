#: OrchardCore.AzureAI.Core\Handlers\AzureAISearchIndexProfileHandler.cs:37
msgctxt "OrchardCore.AzureAI.Handlers.AzureAISearchIndexProfileHandler"
msgid ""
"Invalid index name. Must start with a letter and be 1–128 characters long. "
"Only letters, numbers, and underscores are allowed. Names cannot begin with "
"'azureSearch'."
msgstr ""
"Ungültiger Indexname. Er muss mit einem Buchstaben beginnen und 1–128 "
"Zeichen lang sein. Zulässig sind nur Buchstaben, Zahlen und Unterstriche. "
"Namen dürfen nicht mit 'azureSearch' beginnen."

#. context.Result.Fail(new ValidationResult(S["At least one mapping field is
#. required."]));
#: OrchardCore.AzureAI.Core\Handlers\AzureAISearchIndexProfileHandler.cs:44
msgctxt "OrchardCore.AzureAI.Handlers.AzureAISearchIndexProfileHandler"
msgid "At least one mapping field is required."
msgstr "Mindestens ein Zuordnungsfeld ist erforderlich."

