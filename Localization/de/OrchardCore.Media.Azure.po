#. await _notifier.WarningAsync(H["This site's Azure Storage account has
#. Hierarchical Namespace (ADLS Gen2) enabled. The current Media Library has
#. not been fully verified against Gen2 storage yet; some behavior may be
#. affected. Full support is coming with the next Media Library update — until
#. then, prefer a Gen1 (flat-namespace) storage account for this site."]);
#: OrchardCore.Media.Azure\Filters\MediaGalleryCapabilitiesFilter.cs:39
msgctxt "OrchardCore.Media.Azure.Filters.MediaGalleryCapabilitiesFilter"
msgid ""
"This site's Azure Storage account has Hierarchical Namespace (ADLS Gen2) "
"enabled. The current Media Library has not been fully verified against Gen2 "
"storage yet; some behavior may be affected. Full support is coming with the "
"next Media Library update — until then, prefer a Gen1 (flat-namespace) "
"storage account for this site."
msgstr ""
"Für das Azure Storage-Konto dieser Website ist Hierarchical Namespace (ADLS "
"Gen2) aktiviert. Die aktuelle Medienbibliothek wurde noch nicht vollständig "
"mit Gen2-Speicher verifiziert; daher kann es zu Beeinträchtigungen kommen. "
"Die vollständige Unterstützung folgt mit dem nächsten Update der "
"Medienbibliothek. Verwenden Sie bis dahin für diese Website vorzugsweise ein"
" Gen1-Speicherkonto (mit flachem Namespace)."

