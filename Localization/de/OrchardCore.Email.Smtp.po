msgstr "Mit dem Server über eine sichere SSL/TSL-Verbindung verbinden"

#: Views/SmtpSettings.Edit.cshtml
msgctxt "OrchardCore.Email.Smtp.Views.SmtpSettings.Edit"
msgid "Connect to server using insecure connection and upgrade to secure using SSL/TLS"
msgstr "Mit dem Server über eine ungesicherte Verbindung verbinden und diese mit SSL/TLS auf eine sichere Verbindung hochstufen"

