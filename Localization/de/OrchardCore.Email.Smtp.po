msgstr "Proxy-Hostname"

#: Views/SmtpSettings.Edit.cshtml
msgctxt "OrchardCore.Email.Smtp.Views.SmtpSettings.Edit"
msgid "Proxy port number"
msgstr "Proxy-Portnummer"

#: Views/SmtpSettings.Edit.cshtml
msgctxt "OrchardCore.Email.Smtp.Views.SmtpSettings.Edit"
msgid "Require credentials"
msgstr "Anmeldedaten erforderlich"

#: Views/SmtpSettings.Edit.cshtml
msgctxt "OrchardCore.Email.Smtp.Views.SmtpSettings.Edit"
msgid "SSL/TLS"
msgstr "SSL/TLS"

#: Views/SmtpSettings.Edit.cshtml
msgctxt "OrchardCore.Email.Smtp.Views.SmtpSettings.Edit"
msgid "STARTTLS"
msgstr "STARTTLS"

#: Views/SmtpSettings.Edit.cshtml
msgctxt "OrchardCore.Email.Smtp.Views.SmtpSettings.Edit"
msgid "Sender email address"
msgstr "E-Mail-Adresse des Absenders"

#: Views/SmtpSettings.Edit.cshtml
msgctxt "OrchardCore.Email.Smtp.Views.SmtpSettings.Edit"
msgid "Specified pickup directory"
msgstr "Angegebenes Abholverzeichnis"

#: Views/SmtpSettings.Edit.cshtml
msgctxt "OrchardCore.Email.Smtp.Views.SmtpSettings.Edit"
msgid "Specified pickup directory delivery options"
msgstr "Optionen für die Übermittlung über das angegebene Abholverzeichnis"

#: Views/SmtpSettings.Edit.cshtml
msgctxt "OrchardCore.Email.Smtp.Views.SmtpSettings.Edit"
msgid "The SMTP server domain, e.g. <i>smtp.mailprovider.com</i>."
msgstr "Die Domäne des SMTP-Servers, z. B. <i>smtp.mailprovider.com</i>."

#: Views/SmtpSettings.Edit.cshtml
msgctxt "OrchardCore.Email.Smtp.Views.SmtpSettings.Edit"
msgid "The SMTP server port, usually 25."
msgstr "Der Port des SMTP-Servers, normalerweise 25."

#: Views/SmtpSettings.Edit.cshtml
msgctxt "OrchardCore.Email.Smtp.Views.SmtpSettings.Edit"
msgid "The default email address to use as a sender, unless the email sender is set."
msgstr "Die standardmäßig als Absender verwendete E-Mail-Adresse, sofern kein E-Mail-Absender festgelegt ist."

#: Views/SmtpSettings.Edit.cshtml
msgctxt "OrchardCore.Email.Smtp.Views.SmtpSettings.Edit"
msgid "The delivery method used when sending email. Use Network in production. The other options can be useful when developing and testing."
msgstr "Die beim Senden von E-Mails verwendete Übermittlungsmethode. Verwenden Sie in Produktionsumgebungen „Netzwerk“. Die anderen Optionen können bei Entwicklung und Tests nützlich sein."

#: Views/SmtpSettings.Edit.cshtml
msgctxt "OrchardCore.Email.Smtp.Views.SmtpSettings.Edit"
msgid "The encryption method used when connecting to mail server."
msgstr "Die beim Verbinden mit dem Mailserver verwendete Verschlüsselungsmethode."

#: Views/SmtpSettings.Edit.cshtml
msgctxt "OrchardCore.Email.Smtp.Views.SmtpSettings.Edit"
msgid "The password for authentication."
msgstr "Das Kennwort für die Authentifizierung."

#: Views/SmtpSettings.Edit.cshtml
msgctxt "OrchardCore.Email.Smtp.Views.SmtpSettings.Edit"
msgid "The proxy port is optional."
msgstr "Der Proxy-Port ist optional."

#: Views/SmtpSettings.Edit.cshtml
msgctxt "OrchardCore.Email.Smtp.Views.SmtpSettings.Edit"
msgid "The proxy server is optional."
msgstr "Der Proxyserver ist optional."

#: Views/SmtpSettings.Edit.cshtml
msgctxt "OrchardCore.Email.Smtp.Views.SmtpSettings.Edit"
msgid "The username for authentication."
msgstr "Der Benutzername für die Authentifizierung."

#: Views/SmtpSettings.Edit.cshtml
msgctxt "OrchardCore.Email.Smtp.Views.SmtpSettings.Edit"
msgid "Use <code>/</code> for the tenant's default pickup folder or a subfolder such as <code>/Outbound</code>. The configured base path defaults to <code>{{ AppData }}\\Sites\\{{ ShellSettings.Name }}\\Emails</code>, is expanded from configuration only, and mail stays sandboxed under that folder."
msgstr "Verwenden Sie <code>/</code> für den standardmäßigen Abholordner des Mandanten oder einen Unterordner wie <code>/Outbound</code>. Der konfigurierte Basispfad ist standardmäßig <code>{{ AppData }}\\Sites\\{{ ShellSettings.Name }}\\Emails</code>, wird ausschließlich aus der Konfiguration erweitert, und E-Mails bleiben auf diesen Ordner beschränkt."

#: Views/SmtpSettings.Edit.cshtml
msgctxt "OrchardCore.Email.Smtp.Views.SmtpSettings.Edit"
msgid "Use Windows authentication"
msgstr "Windows-Authentifizierung verwenden"

#: Views/SmtpSettings.Edit.cshtml
msgctxt "OrchardCore.Email.Smtp.Views.SmtpSettings.Edit"
msgid "User name"
msgstr "Benutzername"

#: Views/SmtpSettings.Edit.cshtml
msgctxt "OrchardCore.Email.Smtp.Views.SmtpSettings.Edit"
msgid "When this option is selected, the application pool or host-process identity is used to authenticate with the mail server."
msgstr "Wenn diese Option ausgewählt ist, wird die Identität des Anwendungspools oder Hostprozesses zur Authentifizierung beim Mailserver verwendet."

