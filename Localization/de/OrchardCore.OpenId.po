msgctxt "OrchardCore.OpenId.Services.OpenIdServerService"
msgid "The certificate is not valid for current date."
msgstr "Das Zertifikat ist für das aktuelle Datum nicht gültig."

#: Services/OpenIdServerService.cs
msgctxt "OrchardCore.OpenId.Services.OpenIdServerService"
msgid "The client credentials flow cannot be enabled when the token endpoint is disabled."
msgstr "Der Client-credential flow kann nicht aktiviert werden, wenn der Token-Endpunkt deaktiviert ist."

#: Services/OpenIdServerService.cs
msgctxt "OrchardCore.OpenId.Services.OpenIdServerService"
msgid "The hybrid flow cannot be enabled when the authorization and token endpoints are disabled."
msgstr "Der Hybrid Flow kann nicht aktiviert werden, wenn die Autorisierungs- und Token-Endpunkte deaktiviert sind."

#: Services/OpenIdServerService.cs
msgctxt "OrchardCore.OpenId.Services.OpenIdServerService"
msgid "The implicit flow cannot be enabled when the authorization endpoint is disabled."
msgstr "Der implicit flow kann nicht aktiviert werden, wenn der Autorisierungs-Endpunkt deaktiviert ist."

#: Services/OpenIdServerService.cs
msgctxt "OrchardCore.OpenId.Services.OpenIdServerService"
msgid "The password flow cannot be enabled when the token endpoint is disabled."
msgstr "Der Passwortfllow kann nicht aktiviert werden, wenn der Token-Endpunkt deaktiviert ist."

#: Services/OpenIdServerService.cs
msgctxt "OrchardCore.OpenId.Services.OpenIdServerService"
msgid "The pushed authorization endpoint can only be enabled when the authorization endpoint is enabled."
msgstr "Der Endpunkt für Push-Autorisierungen kann nur aktiviert werden, wenn der Autorisierungsendpunkt aktiviert ist."

#: Services/OpenIdServerService.cs
msgctxt "OrchardCore.OpenId.Services.OpenIdServerService"
msgid "The pushed authorization endpoint must be enabled when enforcing pushed authorization requests."
msgstr "Wenn Push-Autorisierungsanfragen erzwungen werden, muss der Endpunkt für Push-Autorisierungen aktiviert sein."

#: Services/OpenIdServerService.cs
msgctxt "OrchardCore.OpenId.Services.OpenIdServerService"
msgid "The refresh token flow can only be enabled if the password, authorization code or hybrid flows are enabled."
msgstr "Der Refreshtoken Flow kann nur aktiviert werden, wenn Passwort, Autorisierungscode oder Hybrid Flow aktiviert sind."

#: Services/OpenIdServerService.cs
msgctxt "OrchardCore.OpenId.Services.OpenIdServerService"
msgid "The refresh token flow cannot be enabled when the token endpoint is disabled."
msgstr "Der Refreshtoken Flow kann nicht aktiviert werden, wenn der Token-Endpunkt deaktiviert ist."

