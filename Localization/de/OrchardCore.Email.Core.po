#: EmailPermissions.cs
msgctxt "OrchardCore.Email.EmailPermissions"
msgid "Manage Email Settings"
msgstr "E-Mail-Einstellungen verwalten"

#: Services/DefaultEmailService.cs
msgctxt "OrchardCore.Email.Services.DefaultEmailService"
msgid "Email settings must be configured before an Email message can be sent."
msgstr "Bevor eine E-Mail-Nachricht gesendet werden kann, müssen die E-Mail-Einstellungen konfiguriert sein."

#. Format arguments: {0}: address
#: Services/EmailMessageValidator.cs
#, csharp-format
msgctxt "OrchardCore.Email.Services.EmailMessageValidator"
msgid "Invalid email address for the recipient: '{0}'."
msgstr "Ungültige E-Mail-Adresse des Empfängers: '{0}'."

#. Format arguments: {0}: address
#: Services/EmailMessageValidator.cs
#, csharp-format
msgctxt "OrchardCore.Email.Services.EmailMessageValidator"
msgid "Invalid email address for the sender: '{0}'."
msgstr "Ungültige E-Mail-Adresse des Absenders: '{0}'."

#: Services/EmailMessageValidator.cs
msgctxt "OrchardCore.Email.Services.EmailMessageValidator"
msgid "The mail message should have at least one of these headers: To, Cc or Bcc."
msgstr "Die E-Mail-Nachricht muss mindestens einen dieser Header enthalten: To, Cc oder Bcc."

