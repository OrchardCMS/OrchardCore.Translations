#. context.Errors.Add(string.Empty, S["DatabaseProvider setting is
#. required."]);
#: OrchardCore.Setup.Core\Services\SetupService.cs:187
msgctxt "OrchardCore.Setup.Services.SetupService"
msgid "DatabaseProvider setting is required."
msgstr "Die Einstellung DatabaseProvider ist erforderlich."

#. context.Errors.Add(string.Empty, S["The provided database provider is not
#. supported."]);
#: OrchardCore.Setup.Core\Services\SetupService.cs:190
msgctxt "OrchardCore.Setup.Services.SetupService"
msgid "The provided database provider is not supported."
msgstr "Der angegebene Datenbankanbieter wird nicht unterstützt."

#. context.Errors.Add(string.Empty, S["The provided connection string is
#. invalid or server is unreachable."]);
#: OrchardCore.Setup.Core\Services\SetupService.cs:193
msgctxt "OrchardCore.Setup.Services.SetupService"
msgid "The provided connection string is invalid or server is unreachable."
msgstr ""
"Die angegebene Verbindungszeichenfolge ist ungültig oder der Server ist "
"nicht erreichbar."

#. context.Errors.Add(string.Empty, S["The security certificate on the server
#. is from a non-trusted source (the certificate issuing authority isn't
#. listed as a trusted authority in Trusted Root Certification Authorities on
#. the client machine). In a development environment, you have the option to
#. use the '{0}' parameter in your connection string to bypass the validation
#. performed by the certificate authority.", "TrustServerCertificate=True"]);
#: OrchardCore.Setup.Core\Services\SetupService.cs:196
msgctxt "OrchardCore.Setup.Services.SetupService"
msgid ""
"The security certificate on the server is from a non-trusted source (the "
"certificate issuing authority isn't listed as a trusted authority in Trusted"
" Root Certification Authorities on the client machine). In a development "
"environment, you have the option to use the '{0}' parameter in your "
"connection string to bypass the validation performed by the certificate "
"authority."
msgstr ""
"Das Sicherheitszertifikat auf dem Server stammt aus einer nicht "
"vertrauenswürdigen Quelle (die Zertifizierungsstelle, die das Zertifikat "
"ausgestellt hat, ist auf dem Clientcomputer nicht unter Trusted Root "
"Certification Authorities als vertrauenswürdige Zertifizierungsstelle "
"aufgeführt). In einer Entwicklungsumgebung können Sie den Parameter '{0}' in"
" Ihrer Verbindungszeichenfolge verwenden, um die von der "
"Zertifizierungsstelle durchgeführte Überprüfung zu umgehen."

#. context.Errors.Add(string.Empty, S["The provided database, table prefix and
#. schema are already in use."]);
#: OrchardCore.Setup.Core\Services\SetupService.cs:199
msgctxt "OrchardCore.Setup.Services.SetupService"
msgid "The provided database, table prefix and schema are already in use."
msgstr ""
"Die angegebene Datenbank, das Tabellenpräfix und das Schema werden bereits "
"verwendet."

#. context.Errors.Add(string.Empty, S["An error occurred while initializing
#. the datastore."]);
#. context.Errors.Add(string.Empty, S["An error occurred while initializing
#. the datastore."]);
#: OrchardCore.Setup.Core\Services\SetupService.cs:234
#: OrchardCore.Setup.Core\Services\SetupService.cs:266
msgctxt "OrchardCore.Setup.Services.SetupService"
msgid "An error occurred while initializing the datastore."
msgstr "Beim Initialisieren des Datenspeichers ist ein Fehler aufgetreten."

#. context.Errors.Add(string.Empty, S["Unexpected error occurred while
#. importing the recipe."]);
#: OrchardCore.Setup.Core\Services\SetupService.cs:260
msgctxt "OrchardCore.Setup.Services.SetupService"
msgid "Unexpected error occurred while importing the recipe."
msgstr "Beim Importieren des Rezepts ist ein unerwarteter Fehler aufgetreten."
