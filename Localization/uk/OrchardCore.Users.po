msgctxt "OrchardCore.Users.Views.ExternalRegistrationSettings.Edit"
msgid "Reset Script"
msgstr "Скинути скрипт"

#: Views/ExternalRegistrationSettings.Edit.cshtml
msgctxt "OrchardCore.Users.Views.ExternalRegistrationSettings.Edit"
msgid "Use a script to generate userName based on external provider claims"
msgstr "Використовувати скрипт для генерації імені користувача на основі претензій зовнішнього постачальника"

