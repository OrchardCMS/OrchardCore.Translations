#: Controllers/SetupController.cs
msgctxt "OrchardCore.Setup.Controllers.SetupController"
msgid "An error occurred while running the setup. Try again in a few minutes, and if the issue persists, consult the app's operator."
msgstr ""

#: Controllers/SetupController.cs
msgctxt "OrchardCore.Setup.Controllers.SetupController"
msgid "Invalid recipe."
msgstr "Некоректний рецепт."

#: Controllers/SetupController.cs
msgctxt "OrchardCore.Setup.Controllers.SetupController"
msgid "The email is invalid."
msgstr "Електронна адреса некоректна."

#: Controllers/SetupController.cs
msgctxt "OrchardCore.Setup.Controllers.SetupController"
msgid "The password confirmation doesn't match the password."
msgstr "Підтвердження пароля не збігається з паролем."

#: Controllers/SetupController.cs
msgctxt "OrchardCore.Setup.Controllers.SetupController"
msgid "The password is required."
msgstr "Пароль обов'язковий."

#. Format arguments: {0}: model.UserName
#: Controllers/SetupController.cs
#, csharp-format
msgctxt "OrchardCore.Setup.Controllers.SetupController"
msgid "User name '{0}' is invalid, can only contain letters or digits."
msgstr "Ім’я користувача '{0}' є некоректним, може містити тільки букви або цифри."

#: Views/Setup/Index.cshtml
msgctxt "OrchardCore.Setup.Views.Setup.Index"
msgid " and "
msgstr " та "

#: Views/Setup/Index.cshtml
msgctxt "OrchardCore.Setup.Views.Setup.Index"
msgid ", "
msgstr ", "

