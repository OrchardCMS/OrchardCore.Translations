#: Services/ThemeService.cs
#, csharp-format
msgctxt "OrchardCore.Themes.Services.ThemeService"
msgid "The feature {1} was disabled."
msgid_plural "The following features were disabled: {1}."
msgstr[0] "La fonctionnalité {1} a été désactivée."
msgstr[1] "Les fonctionnalités suivantes ont été désactivées : {1}."

#. Format arguments: {0}: count; {1}: string.Join(", ", enabledFeatures.Select(f => f.Name ?? f.Id))
#: Services/ThemeService.cs
#, csharp-format
msgctxt "OrchardCore.Themes.Services.ThemeService"
msgid "The feature {1} was enabled."
msgid_plural "The following features were enabled: {1}."
msgstr[0] "La fonctionnalité {1} a été activée."
msgstr[1] "Les fonctionnalités suivantes ont été activées : {1}."

#. Format arguments: {0}: themeName
#: Services/ThemeService.cs
#, csharp-format
msgctxt "OrchardCore.Themes.Services.ThemeService"
msgid "The theme \"{0}\" is already in the stack of themes that need features disabled."
msgstr "Le thème \"{0}\" est déjà dans la pile des thèmes qui ont besoin de fonctionnalités désactivées."

#. Format arguments: {0}: themeName
#: Services/ThemeService.cs
#, csharp-format
msgctxt "OrchardCore.Themes.Services.ThemeService"
msgid "The theme \"{0}\" is already in the stack of themes that need features enabled."
msgstr "Le thème \"{0}\" est déjà dans la pile des thèmes qui ont besoin de fonctionnalités activées."

