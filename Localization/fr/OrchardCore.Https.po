#. <label class="form-check-label" asp-for="RequireHttps">@T["Require HTTPS"]</label>
#: OrchardCore.Https\Views\HttpsSettings.Edit.cshtml:7
msgctxt "OrchardCore.Https.Views.HttpsSettings.Edit"
msgid "Require HTTPS"
msgstr "Exiger HTTPS"

#. <span class="hint dashed">@T["Require HTTPS for all requests"]</span>
#: OrchardCore.Https\Views\HttpsSettings.Edit.cshtml:8
msgctxt "OrchardCore.Https.Views.HttpsSettings.Edit"
msgid "Require HTTPS for all requests"
msgstr "Exiger HTTPS pour toutes les demandes"

#. <label asp-for="StrictTransportSecurityMode" class="ocat-label">@T["HSTS mode"]</label>
#: OrchardCore.Https\Views\HttpsSettings.Edit.cshtml:14
msgctxt "OrchardCore.Https.Views.HttpsSettings.Edit"
msgid "HSTS mode"
msgstr "Mode HSTS"

#. <option value="@nameof(OrchardCore.Https.Settings.HttpStrictTransportSecurityMode.Disabled)">@T["Disabled"]</option>
#: OrchardCore.Https\Views\HttpsSettings.Edit.cshtml:17
msgctxt "OrchardCore.Https.Views.HttpsSettings.Edit"
msgid "Disabled"
msgstr "Désactivé"

#. <option value="@nameof(OrchardCore.Https.Settings.HttpStrictTransportSecurityMode.Enabled)">@T["Enabled"]</option>
#: OrchardCore.Https\Views\HttpsSettings.Edit.cshtml:18
msgctxt "OrchardCore.Https.Views.HttpsSettings.Edit"
msgid "Enabled"
msgstr "Activé"

#. <option value="@nameof(OrchardCore.Https.Settings.HttpStrictTransportSecurityMode.FromConfiguration)">@T["From environment — enabled in Production, disabled otherwise"]</option>
#: OrchardCore.Https\Views\HttpsSettings.Edit.cshtml:19
msgctxt "OrchardCore.Https.Views.HttpsSettings.Edit"
msgid "From environment — enabled in Production, disabled otherwise"
msgstr "Depuis l'environnement — activé en Production, désactivé sinon"

#. <span class="hint">@T["Determines whether HTTP Strict Transport Security (HSTS) headers are disabled by default, enabled explicitly, or follow the current environment."]</span>
#: OrchardCore.Https\Views\HttpsSettings.Edit.cshtml:21
msgctxt "OrchardCore.Https.Views.HttpsSettings.Edit"
msgid "Determines whether HTTP Strict Transport Security (HSTS) headers are disabled by default, enabled explicitly, or follow the current environment."
msgstr "Détermine si les en-têtes HTTP Strict Transport Security (HSTS) sont désactivés par défaut, activés explicitement ou suivent l'environnement actuel."

#. <div class="alert alert-danger mt-3">@T["Use HSTS with caution, as browsers may stop connecting over HTTP after receiving the header if HTTPS later becomes unavailable."]</div>
#: OrchardCore.Https\Views\HttpsSettings.Edit.cshtml:22
msgctxt "OrchardCore.Https.Views.HttpsSettings.Edit"
msgid "Use HSTS with caution, as browsers may stop connecting over HTTP after receiving the header if HTTPS later becomes unavailable."
msgstr "Utilisez HSTS avec prudence, car les navigateurs peuvent cesser de se connecter via HTTP après avoir reçu l'en-tête si HTTPS devient indisponible plus tard."

#. <label class="form-check-label" asp-for="RequireHttpsPermanent">@T["Require HTTPS Permanent"]</label>
#: OrchardCore.Https\Views\HttpsSettings.Edit.cshtml:31
msgctxt "OrchardCore.Https.Views.HttpsSettings.Edit"
msgid "Require HTTPS Permanent"
msgstr "Exiger HTTPS Permanent"

#. <span class="hint dashed">@T["Specifies whether a permanent redirect, 308 Moved Permanently, should be used instead of a temporary redirect, 307 Found, when redirecting to HTTPS"]</span>
#: OrchardCore.Https\Views\HttpsSettings.Edit.cshtml:32
msgctxt "OrchardCore.Https.Views.HttpsSettings.Edit"
msgid "Specifies whether a permanent redirect, 308 Moved Permanently, should be used instead of a temporary redirect, 307 Found, when redirecting to HTTPS"
msgstr "Spécifie si une redirection permanente, 308 Moved Permanently, doit être utilisée au lieu d'une redirection temporaire, 307 Found, lors de la redirection vers HTTPS"

#. <label asp-for="SslPort" class="ocat-label">@T["SSL Port"]</label>
#: OrchardCore.Https\Views\HttpsSettings.Edit.cshtml:38
msgctxt "OrchardCore.Https.Views.HttpsSettings.Edit"
msgid "SSL Port"
msgstr "Port SSL"

#. <span class="hint">@T["The SSL Port Number, leave empty to let the middleware try to determinate it."]</span>
#: OrchardCore.Https\Views\HttpsSettings.Edit.cshtml:42
msgctxt "OrchardCore.Https.Views.HttpsSettings.Edit"
msgid "The SSL Port Number, leave empty to let the middleware try to determinate it."
msgstr "Le numéro de port SSL, laisser vide pour laisser le middleware essayer de le déterminer."

