#: Drivers/UploadToSftpStepDisplayDriver.cs
msgctxt "OrchardCore.DataPipelines.Sftp.Drivers.UploadToSftpStepDisplayDriver"
msgid "Enter a SHA-256 fingerprint, such as SHA256:ohD8VZEXGWo6Ez8GSEJQ9WpafgLFsOfLOtGGQCQo6Og."
msgstr "Saisissez une empreinte SHA-256, par exemple SHA256:ohD8VZEXGWo6Ez8GSEJQ9WpafgLFsOfLOtGGQCQo6Og."

#: Drivers/UploadToSftpStepDisplayDriver.cs
msgctxt "OrchardCore.DataPipelines.Sftp.Drivers.UploadToSftpStepDisplayDriver"
msgid "The port must be between 1 and 65535."
msgstr "Le port doit être compris entre 1 et 65535."

#: Drivers/UploadToSftpStepDisplayDriver.cs
msgctxt "OrchardCore.DataPipelines.Sftp.Drivers.UploadToSftpStepDisplayDriver"
msgid "The timeout must be at least one second."
msgstr "Le délai d’expiration doit être d’au moins une seconde."

#. Format arguments: {0}: host; {1}: DataPipelineRemotePaths.Redact(ex.Message, password, privateKey, passphrase)
#: Steps/UploadToSftpStep.cs
#, csharp-format
msgctxt "OrchardCore.DataPipelines.Sftp.UploadToSftpStep"
msgid "Could not upload to the SFTP server '{0}': {1}"
msgstr "Impossible de téléverser vers le serveur SFTP '{0}' : {1}"

#: Steps/UploadToSftpStep.cs
msgctxt "OrchardCore.DataPipelines.Sftp.UploadToSftpStep"
msgid "Enter a password or a private key."
msgstr "Saisissez un mot de passe ou une clé privée."

#: Steps/UploadToSftpStep.cs
msgctxt "OrchardCore.DataPipelines.Sftp.UploadToSftpStep"
msgid "Enter the host of the SFTP server."
msgstr "Saisissez l’hôte du serveur SFTP."

#: Steps/UploadToSftpStep.cs
msgctxt "OrchardCore.DataPipelines.Sftp.UploadToSftpStep"
msgid "Enter the user name."
msgstr "Saisissez le nom d’utilisateur."

#. Format arguments: {0}: host; {1}: presented
#: Steps/UploadToSftpStep.cs
#, csharp-format
msgctxt "OrchardCore.DataPipelines.Sftp.UploadToSftpStep"
msgid "The SFTP server '{0}' presented the host key SHA256:{1}, which doesn't match the expected fingerprint. The connection was refused."
msgstr "Le serveur SFTP '{0}' a présenté la clé d’hôte SHA256:{1}, qui ne correspond pas à l’empreinte attendue. La connexion a été refusée."

#: Steps/UploadToSftpStep.cs
msgctxt "OrchardCore.DataPipelines.Sftp.UploadToSftpStep"
msgid "The credentials can't be read on this site, such as when its data protection keys changed: enter them again."
msgstr "Les informations d’identification ne peuvent pas être lues sur ce site, par exemple si ses clés de protection des données ont changé : saisissez-les à nouveau."

#. Format arguments: {0}: remotePath; {1}: host
#: Steps/UploadToSftpStep.cs
#, csharp-format
msgctxt "OrchardCore.DataPipelines.Sftp.UploadToSftpStep"
msgid "The file '{0}' already exists on the SFTP server '{1}', and the step doesn't overwrite files."
msgstr "Le fichier '{0}' existe déjà sur le serveur SFTP '{1}', et cette étape ne remplace pas les fichiers."

#. Format arguments: {0}: settings.Host
#: Steps/UploadToSftpStep.cs
#, csharp-format
msgctxt "OrchardCore.DataPipelines.Sftp.UploadToSftpStep"
msgid "The host '{0}' isn't a valid host name or IP address."
msgstr "L’hôte '{0}' n’est pas un nom d’hôte ou une adresse IP valide."

#: Steps/UploadToSftpStep.cs
msgctxt "OrchardCore.DataPipelines.Sftp.UploadToSftpStep"
msgid "The host key fingerprint must be a SHA-256 fingerprint, such as SHA256:ohD8VZEXGWo6Ez8GSEJQ9WpafgLFsOfLOtGGQCQo6Og."
msgstr "L’empreinte de la clé d’hôte doit être une empreinte SHA-256, par exemple SHA256:ohD8VZEXGWo6Ez8GSEJQ9WpafgLFsOfLOtGGQCQo6Og."

#. Format arguments: {0}: host; {1}: presented
#: Steps/UploadToSftpStep.cs
#, csharp-format
msgctxt "OrchardCore.DataPipelines.Sftp.UploadToSftpStep"
msgid "The host key of the SFTP server '{0}' isn't verified. To verify it, set its fingerprint: SHA256:{1}"
msgstr "La clé d’hôte du serveur SFTP '{0}' n’est pas vérifiée. Pour la vérifier, définissez son empreinte : SHA256:{1}"

#: Steps/UploadToSftpStep.cs
msgctxt "OrchardCore.DataPipelines.Sftp.UploadToSftpStep"
msgid "The host key of the server isn't verified: enter its SHA-256 fingerprint to make sure the files go to the right server."
msgstr "La clé d’hôte du serveur n’est pas vérifiée : saisissez son empreinte SHA-256 pour vous assurer que les fichiers sont envoyés au bon serveur."

#: Steps/UploadToSftpStep.cs
msgctxt "OrchardCore.DataPipelines.Sftp.UploadToSftpStep"
msgid "The port must be between 1 and 65535."
msgstr "Le port doit être compris entre 1 et 65535."

#: Steps/UploadToSftpStep.cs
msgctxt "OrchardCore.DataPipelines.Sftp.UploadToSftpStep"
msgid "The timeout must be at least one second."
msgstr "Le délai d’expiration doit être d’au moins une seconde."

#: Steps/UploadToSftpStep.cs
msgctxt "OrchardCore.DataPipelines.Sftp.UploadToSftpStep"
msgid "Upload to an SFTP server"
msgstr "Téléverser vers un serveur SFTP"

#. Format arguments: {0}: fileName; {1}: DataPipelineRemotePaths.ToDisplayUrl("sftp", host, settings.Port, remotePath)
#: Steps/UploadToSftpStep.cs
#, csharp-format
msgctxt "OrchardCore.DataPipelines.Sftp.UploadToSftpStep"
msgid "Uploaded '{0}' to {1}"
msgstr "'{0}' téléversé vers {1}"

#: Steps/UploadToSftpStep.cs
msgctxt "OrchardCore.DataPipelines.Sftp.UploadToSftpStep"
msgid "Uploads files to a folder of an SFTP server, over SSH."
msgstr "Téléverse les fichiers dans un dossier d’un serveur SFTP via SSH."

#: Views/UploadToSftp.Fields.Design.cshtml
msgctxt "OrchardCore.DataPipelines.Sftp.Views.UploadToSftp.Fields.Design"
msgid "Host key not verified"
msgstr "Clé d’hôte non vérifiée"

#: Views/UploadToSftp.Fields.Edit.cshtml
msgctxt "OrchardCore.DataPipelines.Sftp.Views.UploadToSftp.Fields.Edit"
msgid "Authenticate with a password, a private key, or both when the server asks for both."
msgstr "Authentifiez-vous avec un mot de passe, une clé privée ou les deux si le serveur demande les deux."

#. Format arguments: {0}: "{PipelineName}"; {1}: "{RunId}"; {2}: "{Date:format}"
#: Views/UploadToSftp.Fields.Edit.cshtml
#, csharp-format
msgctxt "OrchardCore.DataPipelines.Sftp.Views.UploadToSftp.Fields.Edit"
msgid "Created when it doesn't exist. Empty for the home folder of the user. Placeholders: {0}, {1}, and {2}."
msgstr "Créé s’il n’existe pas. Laissez vide pour utiliser le dossier personnel de l’utilisateur. Espaces réservés : {0}, {1} et {2}."

#: Views/UploadToSftp.Fields.Edit.cshtml
msgctxt "OrchardCore.DataPipelines.Sftp.Views.UploadToSftp.Fields.Edit"
msgid "Host"
msgstr "Hôte"

#: Views/UploadToSftp.Fields.Edit.cshtml
msgctxt "OrchardCore.DataPipelines.Sftp.Views.UploadToSftp.Fields.Edit"
msgid "Host key fingerprint"
msgstr "Empreinte de la clé d’hôte"

#: Views/UploadToSftp.Fields.Edit.cshtml
msgctxt "OrchardCore.DataPipelines.Sftp.Views.UploadToSftp.Fields.Edit"
msgid "Leave empty to keep the current passphrase."
msgstr "Laissez vide pour conserver la phrase secrète actuelle."

#: Views/UploadToSftp.Fields.Edit.cshtml
msgctxt "OrchardCore.DataPipelines.Sftp.Views.UploadToSftp.Fields.Edit"
msgid "Leave empty to keep the current password."
msgstr "Laissez vide pour conserver le mot de passe actuel."

#: Views/UploadToSftp.Fields.Edit.cshtml
msgctxt "OrchardCore.DataPipelines.Sftp.Views.UploadToSftp.Fields.Edit"
msgid "Leave empty to keep the current private key."
msgstr "Laissez vide pour conserver la clé privée actuelle."

#: Views/UploadToSftp.Fields.Edit.cshtml
msgctxt "OrchardCore.DataPipelines.Sftp.Views.UploadToSftp.Fields.Edit"
msgid "Otherwise the step fails when a file with the same name exists."
msgstr "Sinon, l’étape échoue si un fichier portant le même nom existe."

#: Views/UploadToSftp.Fields.Edit.cshtml
msgctxt "OrchardCore.DataPipelines.Sftp.Views.UploadToSftp.Fields.Edit"
msgid "Passphrase"
msgstr "Phrase secrète"

#: Views/UploadToSftp.Fields.Edit.cshtml
msgctxt "OrchardCore.DataPipelines.Sftp.Views.UploadToSftp.Fields.Edit"
msgid "Password"
msgstr "Mot de passe"

#: Views/UploadToSftp.Fields.Edit.cshtml
msgctxt "OrchardCore.DataPipelines.Sftp.Views.UploadToSftp.Fields.Edit"
msgid "Port"
msgstr "Port"

#: Views/UploadToSftp.Fields.Edit.cshtml
msgctxt "OrchardCore.DataPipelines.Sftp.Views.UploadToSftp.Fields.Edit"
msgid "Private key"
msgstr "Clé privée"

#: Views/UploadToSftp.Fields.Edit.cshtml
msgctxt "OrchardCore.DataPipelines.Sftp.Views.UploadToSftp.Fields.Edit"
msgid "Remote folder"
msgstr "Dossier distant"

#: Views/UploadToSftp.Fields.Edit.cshtml
msgctxt "OrchardCore.DataPipelines.Sftp.Views.UploadToSftp.Fields.Edit"
msgid "Remove the passphrase"
msgstr "Supprimer la phrase secrète"

#: Views/UploadToSftp.Fields.Edit.cshtml
msgctxt "OrchardCore.DataPipelines.Sftp.Views.UploadToSftp.Fields.Edit"
msgid "Remove the password"
msgstr "Supprimer le mot de passe"

#: Views/UploadToSftp.Fields.Edit.cshtml
msgctxt "OrchardCore.DataPipelines.Sftp.Views.UploadToSftp.Fields.Edit"
msgid "Remove the private key"
msgstr "Supprimer la clé privée"

#: Views/UploadToSftp.Fields.Edit.cshtml
msgctxt "OrchardCore.DataPipelines.Sftp.Views.UploadToSftp.Fields.Edit"
msgid "Replace existing files"
msgstr "Remplacer les fichiers existants"

#: Views/UploadToSftp.Fields.Edit.cshtml
msgctxt "OrchardCore.DataPipelines.Sftp.Views.UploadToSftp.Fields.Edit"
msgid "The SHA-256 fingerprint of the server's host key, as shown by ssh-keyscan or by the run history. The step refuses to connect to a server with another key. When it is empty, the server isn't verified."
msgstr "L’empreinte SHA-256 de la clé d’hôte du serveur, telle qu’affichée par ssh-keyscan ou dans l’historique d’exécution. L’étape refuse de se connecter à un serveur présentant une autre clé. Si ce champ est vide, le serveur n’est pas vérifié."

#: Views/UploadToSftp.Fields.Edit.cshtml
msgctxt "OrchardCore.DataPipelines.Sftp.Views.UploadToSftp.Fields.Edit"
msgid "The content of the key file, in PEM or OpenSSH format, starting with -----BEGIN."
msgstr "Contenu du fichier de clé au format PEM ou OpenSSH, commençant par -----BEGIN."

#: Views/UploadToSftp.Fields.Edit.cshtml
msgctxt "OrchardCore.DataPipelines.Sftp.Views.UploadToSftp.Fields.Edit"
msgid "Timeout (seconds)"
msgstr "Délai d’expiration (secondes)"

#: Views/UploadToSftp.Fields.Edit.cshtml
msgctxt "OrchardCore.DataPipelines.Sftp.Views.UploadToSftp.Fields.Edit"
msgid "User name"
msgstr "Nom d’utilisateur"

#: Views/UploadToSftp.Fields.Edit.cshtml
msgctxt "OrchardCore.DataPipelines.Sftp.Views.UploadToSftp.Fields.Edit"
msgid "When the private key is encrypted."
msgstr "Lorsque la clé privée est chiffrée."

