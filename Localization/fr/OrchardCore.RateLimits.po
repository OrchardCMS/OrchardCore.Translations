msgctxt "OrchardCore.RateLimits.Views.Admin.RateLimitPolicy.Fields"
msgid "Policy name"
msgstr "Nom de la policy"

#. <span class="hint">@T["Use a unique name to identify this tenant policy."]</span>
#: OrchardCore.RateLimits\Views\Admin\RateLimitPolicy.Fields.cshtml:15
msgctxt "OrchardCore.RateLimits.Views.Admin.RateLimitPolicy.Fields"
msgid "Use a unique name to identify this tenant policy."
msgstr "Utilisez un nom unique pour identifier cette politique de locataire."

#. <label asp-for="Description" class="ocat-label">@T["Description"]</label>
#: OrchardCore.RateLimits\Views\Admin\RateLimitPolicy.Fields.cshtml:20
msgctxt "OrchardCore.RateLimits.Views.Admin.RateLimitPolicy.Fields"
msgid "Description"
msgstr "Description"

#. <span class="hint">@T["Optionally describe what this policy is intended to protect."]</span>
#: OrchardCore.RateLimits\Views\Admin\RateLimitPolicy.Fields.cshtml:24
msgctxt "OrchardCore.RateLimits.Views.Admin.RateLimitPolicy.Fields"
msgid "Optionally describe what this policy is intended to protect."
msgstr "Optionnellement décrire ce que cette politique est destinée à protéger."

#. <label asp-for="Scope" class="ocat-label">@T["Policy type"]</label>
#: OrchardCore.RateLimits\Views\Admin\RateLimitPolicy.Fields.cshtml:31
msgctxt "OrchardCore.RateLimits.Views.Admin.RateLimitPolicy.Fields"
msgid "Policy type"
msgstr "Type de police"

#: OrchardCore.RateLimits\Views\Admin\RateLimitPolicy.Fields.cshtml:0
msgctxt "OrchardCore.RateLimits.Views.Admin.RateLimitPolicy.Fields"
msgid "The policy type is read-only while this policy is enabled. Disable it first to retarget the policy."
msgstr "Le type de policy est en lecture seule lorsque cette policy est activée. Désactivez-la d'abord pour redimensionner la policy."

#: OrchardCore.RateLimits\Views\Admin\RateLimitPolicy.Fields.cshtml:0
msgctxt "OrchardCore.RateLimits.Views.Admin.RateLimitPolicy.Fields"
msgid "Global applies everywhere, Endpoint matches a request path prefix, and Group matches endpoints assigned to a named rate-limit group."
msgstr "Global s'applique partout, le point d'extrémité correspond à un préfixe de chemin de requête, et le groupe recherche les points de terminaison assignés à un groupe de limite de vitesse nommée."

#. <label asp-for="Path" class="ocat-label">@T["Request path"]</label>
#: OrchardCore.RateLimits\Views\Admin\RateLimitPolicy.Fields.cshtml:53
msgctxt "OrchardCore.RateLimits.Views.Admin.RateLimitPolicy.Fields"
msgid "Request path"
msgstr "Chemin de requête"

#: OrchardCore.RateLimits\Views\Admin\RateLimitPolicy.Fields.cshtml:0
msgctxt "OrchardCore.RateLimits.Views.Admin.RateLimitPolicy.Fields"
msgid "The request path is read-only while this policy is enabled. Disable it first to change endpoint targeting."
msgstr "Le chemin de requête est en lecture seule lorsque cette policy est activée. Désactivez-le d'abord pour changer le ciblage de endpoint."

#: OrchardCore.RateLimits\Views\Admin\RateLimitPolicy.Fields.cshtml:0
msgctxt "OrchardCore.RateLimits.Views.Admin.RateLimitPolicy.Fields"
msgid "Matches requests that start with this path, for example '/api/' or '/users/login'."
msgstr "Correspond aux requêtes qui commencent par ce chemin, par exemple '/api/' ou '/users/login'."

#. <label asp-for="GroupName" class="ocat-label">@T["Rate-limit group"]</label>
#: OrchardCore.RateLimits\Views\Admin\RateLimitPolicy.Fields.cshtml:75
msgctxt "OrchardCore.RateLimits.Views.Admin.RateLimitPolicy.Fields"
msgid "Rate-limit group"
msgstr "Groupe de limite de débit"

#: OrchardCore.RateLimits\Views\Admin\RateLimitPolicy.Fields.cshtml:0
msgctxt "OrchardCore.RateLimits.Views.Admin.RateLimitPolicy.Fields"
msgid "The group target is read-only while this policy is enabled. Disable it first to choose a different group."
msgstr "La cible du groupe est en lecture seule lorsque cette policy est activée. Désactivez-la d'abord pour choisir un autre groupe."

#: OrchardCore.RateLimits\Views\Admin\RateLimitPolicy.Fields.cshtml:0
msgctxt "OrchardCore.RateLimits.Views.Admin.RateLimitPolicy.Fields"
msgid "Choose a group declared on one or more endpoints with the RateLimitGroup attribute or WithRateLimitGroups()."
msgstr "Choisissez un groupe déclaré sur un ou plusieurs points de terminaison avec l'attribut RateLimitGroup ou WithRateLimitGroups()."

#. <label asp-for="PermitLimit" class="ocat-label">@T["Permit limit"]</label>
#: OrchardCore.RateLimits\Views\SlidingWindowRateLimiter.Edit.cshtml:4
msgctxt "OrchardCore.RateLimits.Views.SlidingWindowRateLimiter.Edit"
msgid "Permit limit"
msgstr "Limite de permis"

#. <span class="hint">@T["How many requests are allowed across the full rolling window before extra requests are delayed or rejected."]</span>
#: OrchardCore.RateLimits\Views\SlidingWindowRateLimiter.Edit.cshtml:8
msgctxt "OrchardCore.RateLimits.Views.SlidingWindowRateLimiter.Edit"
msgid "How many requests are allowed across the full rolling window before extra requests are delayed or rejected."
msgstr "Combien de requêtes sont autorisées dans la fenêtre déroulante complète avant que les requêtes supplémentaires ne soient retardées ou rejetées."

#. <label asp-for="WindowSeconds" class="ocat-label">@T["Window seconds"]</label>
#: OrchardCore.RateLimits\Views\SlidingWindowRateLimiter.Edit.cshtml:13
msgctxt "OrchardCore.RateLimits.Views.SlidingWindowRateLimiter.Edit"
msgid "Window seconds"
msgstr "Secondes de fenêtre"

#. <span class="hint">@T["How far back Orchard looks when counting requests. For example, 60 means the last minute of traffic is considered."]</span>
#: OrchardCore.RateLimits\Views\SlidingWindowRateLimiter.Edit.cshtml:17
msgctxt "OrchardCore.RateLimits.Views.SlidingWindowRateLimiter.Edit"
msgid "How far back Orchard looks when counting requests. For example, 60 means the last minute of traffic is considered."
msgstr "À quel point Orchard est loin quand il compte les requêtes. Par exemple, 60 signifie que la dernière minute du trafic est considérée."

#. <label asp-for="SegmentsPerWindow" class="ocat-label">@T["Segments per window"]</label>
#: OrchardCore.RateLimits\Views\SlidingWindowRateLimiter.Edit.cshtml:22
msgctxt "OrchardCore.RateLimits.Views.SlidingWindowRateLimiter.Edit"
msgid "Segments per window"
msgstr "Segments par fenêtre"

#. <span class="hint">@T["How many smaller slices Orchard tracks inside the window. More slices make the limit recover more gradually instead of all at once."]</span>
#: OrchardCore.RateLimits\Views\SlidingWindowRateLimiter.Edit.cshtml:26
msgctxt "OrchardCore.RateLimits.Views.SlidingWindowRateLimiter.Edit"
msgid "How many smaller slices Orchard tracks inside the window. More slices make the limit recover more gradually instead of all at once."
msgstr "Combien de petites tranches de traces Orchard dans la fenêtre. Plus de tranches font que la limite se récupère progressivement au lieu de tout à la fois."

#. <label asp-for="QueueLimit" class="ocat-label">@T["Queue limit"]</label>
#: OrchardCore.RateLimits\Views\SlidingWindowRateLimiter.Edit.cshtml:31
msgctxt "OrchardCore.RateLimits.Views.SlidingWindowRateLimiter.Edit"
msgid "Queue limit"
msgstr "Limite de file d'attente"

#. <span class="hint">@T["How many extra requests can wait after the limit is reached. Use 0 to reject extras immediately instead of making them wait."]</span>
#: OrchardCore.RateLimits\Views\SlidingWindowRateLimiter.Edit.cshtml:35
msgctxt "OrchardCore.RateLimits.Views.SlidingWindowRateLimiter.Edit"
msgid "How many extra requests can wait after the limit is reached. Use 0 to reject extras immediately instead of making them wait."
msgstr "Combien de requêtes supplémentaires peuvent attendre une fois la limite atteinte. Utilisez 0 pour rejeter les extras immédiatement au lieu de les faire attendre."

#. <label asp-for="TokenLimit" class="ocat-label">@T["Token limit"]</label>
#: OrchardCore.RateLimits\Views\TokenBucketRateLimiter.Edit.cshtml:4
msgctxt "OrchardCore.RateLimits.Views.TokenBucketRateLimiter.Edit"
msgid "Token limit"
msgstr "Limite de token"

#. <span class="hint">@T["The bucket size. This is the largest burst of requests a client can use at once before it must wait for tokens to refill."]</span>
#: OrchardCore.RateLimits\Views\TokenBucketRateLimiter.Edit.cshtml:8
msgctxt "OrchardCore.RateLimits.Views.TokenBucketRateLimiter.Edit"
msgid "The bucket size. This is the largest burst of requests a client can use at once before it must wait for tokens to refill."
msgstr "La taille du segment. Il s'agit de la plus grande rafale de requêtes qu'un client peut utiliser en même temps avant qu'il ne doive attendre que les tokens soient rechargés."

#. <label asp-for="TokensPerPeriod" class="ocat-label">@T["Tokens per period"]</label>
#: OrchardCore.RateLimits\Views\TokenBucketRateLimiter.Edit.cshtml:13
msgctxt "OrchardCore.RateLimits.Views.TokenBucketRateLimiter.Edit"
msgid "Tokens per period"
msgstr "Tokens par période"

#. <span class="hint">@T["How many requests' worth of capacity are added back each refill period."]</span>
#: OrchardCore.RateLimits\Views\TokenBucketRateLimiter.Edit.cshtml:17
msgctxt "OrchardCore.RateLimits.Views.TokenBucketRateLimiter.Edit"
msgid "How many requests' worth of capacity are added back each refill period."
msgstr "Combien de demandes de capacité sont rajoutées à chaque période de recharge."

#. <label asp-for="ReplenishmentPeriodSeconds" class="ocat-label">@T["Replenishment seconds"]</label>
#: OrchardCore.RateLimits\Views\TokenBucketRateLimiter.Edit.cshtml:22
msgctxt "OrchardCore.RateLimits.Views.TokenBucketRateLimiter.Edit"
msgid "Replenishment seconds"
msgstr "Secondes de réapprovisionnement"

#. <span class="hint">@T["How often Orchard adds tokens back. For example, 10 with 5 tokens per period adds 5 more tokens every 10 seconds."]</span>
#: OrchardCore.RateLimits\Views\TokenBucketRateLimiter.Edit.cshtml:26
msgctxt "OrchardCore.RateLimits.Views.TokenBucketRateLimiter.Edit"
msgid "How often Orchard adds tokens back. For example, 10 with 5 tokens per period adds 5 more tokens every 10 seconds."
msgstr "La fréquence à laquelle Orchard ajoute des tokens en retour. Par exemple, 10 avec 5 tokens par période ajoute 5 jetons supplémentaires toutes les 10 secondes."

#. <label asp-for="QueueLimit" class="ocat-label">@T["Queue limit"]</label>
#: OrchardCore.RateLimits\Views\TokenBucketRateLimiter.Edit.cshtml:31
msgctxt "OrchardCore.RateLimits.Views.TokenBucketRateLimiter.Edit"
msgid "Queue limit"
msgstr "Limite de file d'attente"

#. <span class="hint">@T["How many extra requests can wait when the bucket is empty. Use 0 to reject extras immediately instead of making them wait."]</span>
#: OrchardCore.RateLimits\Views\TokenBucketRateLimiter.Edit.cshtml:35
msgctxt "OrchardCore.RateLimits.Views.TokenBucketRateLimiter.Edit"
msgid "How many extra requests can wait when the bucket is empty. Use 0 to reject extras immediately instead of making them wait."
msgstr "Combien de requêtes supplémentaires peuvent attendre quand le compartiment est vide. Utilisez 0 pour rejeter les extras immédiatement au lieu de les faire attendre."

#. <label asp-for="QueueProcessingOrder" class="ocat-label">@T["Queue processing order"]</label>
#: OrchardCore.RateLimits\Views\TokenBucketRateLimiter.Edit.cshtml:40
msgctxt "OrchardCore.RateLimits.Views.TokenBucketRateLimiter.Edit"
msgid "Queue processing order"
msgstr "Prescription de traitement de la file d'attente"

#. <span class="hint">@T["Choose whether waiting requests are handled in arrival order or whether the newest waiting request gets the next token first."]</span>
#: OrchardCore.RateLimits\Views\TokenBucketRateLimiter.Edit.cshtml:44
msgctxt "OrchardCore.RateLimits.Views.TokenBucketRateLimiter.Edit"
msgid "Choose whether waiting requests are handled in arrival order or whether the newest waiting request gets the next token first."
msgstr "Choisissez si les demandes en attente sont traitées dans la commande d'arrivée ou si la dernière requête en attente reçoit le token suivant en premier."

