#: Services/ConcurrencyRateLimiterSource.cs
msgctxt "OrchardCore.RateLimits.Services.ConcurrencyRateLimiterSource"
msgid "Concurrency"
msgstr "Concurrence"

#: Services/ConcurrencyRateLimiterSource.cs
msgctxt "OrchardCore.RateLimits.Services.ConcurrencyRateLimiterSource"
msgid "Limits how many matching requests can run at the same time, which is useful for expensive operations."
msgstr "Limite le nombre de requêtes correspondantes pouvant être exécutées en même temps, ce qui est utile pour les opérations coûteuses."

#. Format arguments: {0}: model.PermitLimit; {1}: model.QueueLimit; {2}: model.QueueProcessingOrder
#: Services/ConcurrencyRateLimiterSource.cs
#, csharp-format
msgctxt "OrchardCore.RateLimits.Services.ConcurrencyRateLimiterSource"
msgid "{0} concurrent requests, queue limit {1}, queue order {2}"
msgstr "{0} demandes simultanées, limite de {1}en file d'attente, {2} en file d'attente."

#: Services/FixedWindowRateLimiterSource.cs
msgctxt "OrchardCore.RateLimits.Services.FixedWindowRateLimiterSource"
msgid "Allows a set number of requests during each time period, then resets the count all at once."
msgstr "Permet de définir un nombre de requêtes pendant chaque période puis de réinitialiser le nombre de requêtes à la fois."

#: Services/FixedWindowRateLimiterSource.cs
msgctxt "OrchardCore.RateLimits.Services.FixedWindowRateLimiterSource"
msgid "Fixed window"
msgstr "Fenêtre fixe"

#. Format arguments: {0}: model.PermitLimit; {1}: model.WindowSeconds; {2}: model.QueueLimit
#: Services/FixedWindowRateLimiterSource.cs
#, csharp-format
msgctxt "OrchardCore.RateLimits.Services.FixedWindowRateLimiterSource"
msgid "{0} requests every {1} seconds, queue limit {2}"
msgstr "{0} demande toutes les {1} secondes, limite {2} de file d'attente"

#: Services/SlidingWindowRateLimiterSource.cs
msgctxt "OrchardCore.RateLimits.Services.SlidingWindowRateLimiterSource"
msgid "Sliding window"
msgstr "Fenêtre glissante"

#: Services/SlidingWindowRateLimiterSource.cs
msgctxt "OrchardCore.RateLimits.Services.SlidingWindowRateLimiterSource"
msgid "Spreads a request limit across a rolling time period so traffic is smoothed instead of resetting all at once."
msgstr "Diffuse une limite de demande sur une période de temps de roulement de sorte que le trafic est lissé au lieu de le réinitialiser à la fois."

#. Format arguments: {0}: model.PermitLimit; {1}: model.WindowSeconds; {2}: model.SegmentsPerWindow; {3}: model.QueueLimit
#: Services/SlidingWindowRateLimiterSource.cs
#, csharp-format
msgctxt "OrchardCore.RateLimits.Services.SlidingWindowRateLimiterSource"
msgid "{0} requests every {1} seconds across {2} segments, queue limit {3}"
msgstr "{0} demande toutes les {1} secondes sur les segments {2} , limite {3} de file d'attente"

#: Services/TokenBucketRateLimiterSource.cs
msgctxt "OrchardCore.RateLimits.Services.TokenBucketRateLimiterSource"
msgid "Allows short bursts of traffic while steadily refilling capacity over time."
msgstr "Permet de courtes explosions de trafic tout en remplissant régulièrement la capacité au fil du temps."

#: Services/TokenBucketRateLimiterSource.cs
msgctxt "OrchardCore.RateLimits.Services.TokenBucketRateLimiterSource"
msgid "Token bucket"
msgstr "Token bucket"

#. Format arguments: {0}: model.TokenLimit; {1}: model.TokensPerPeriod; {2}: model.ReplenishmentPeriodSeconds; {3}: model.QueueLimit; {4}: model.QueueProcessingOrder
#: Services/TokenBucketRateLimiterSource.cs
#, csharp-format
msgctxt "OrchardCore.RateLimits.Services.TokenBucketRateLimiterSource"
msgid "{0} tokens, {1} replenished every {2} seconds, queue limit {3}, queue order {4}"
msgstr "Jetons {0} , {1} a été réapprovisionné toutes les {2} secondes, limite de file d'attente {3}, ordre de file {4}"

