#. Format arguments: {0}: contentItemType.Name
#: GraphQL/UserType.cs
#, csharp-format
msgctxt "OrchardCore.Users.GraphQL.UserType"
msgid "Custom user settings of {0}."
msgstr "Paramètres utilisateur personnalisés de {0}."

#: GraphQL/UserType.cs
msgctxt "OrchardCore.Users.GraphQL.UserType"
msgid "Represents a user."
msgstr "Représente un utilisateur."

#: GraphQL/UserType.cs
msgctxt "OrchardCore.Users.GraphQL.UserType"
msgid "The email of the user."
msgstr "L'email de l'utilisateur."

#: GraphQL/UserType.cs
msgctxt "OrchardCore.Users.GraphQL.UserType"
msgid "The id of the user."
msgstr "L'identifiant de l'utilisateur."

#: GraphQL/UserType.cs
msgctxt "OrchardCore.Users.GraphQL.UserType"
msgid "The name of the user."
msgstr "Le nom de l'utilisateur."

#: GraphQL/UserType.cs
msgctxt "OrchardCore.Users.GraphQL.UserType"
msgid "The phone number of the user."
msgstr "Le numéro de téléphone de l'utilisateur."

#: Services/UserService.cs
msgctxt "OrchardCore.Users.Services.UserService"
msgid "A password is required."
msgstr "Un mot de passe est requis."

#: Services/UserService.cs
msgctxt "OrchardCore.Users.Services.UserService"
msgid "A token is required."
msgstr "Un jeton est requis."

#: Services/UserService.cs
msgctxt "OrchardCore.Users.Services.UserService"
msgid "A user name is required."
msgstr "Un nom d'utilisateur est requis."

#: Services/UserService.cs
msgctxt "OrchardCore.Users.Services.UserService"
msgid "A username or email address is required."
msgstr "Un nom d'utilisateur ou une adresse email est requis."

#. Format arguments: {0}: user.Email
#: Services/UserService.cs
#, csharp-format
msgctxt "OrchardCore.Users.Services.UserService"
msgid "Email '{0}' is already used."
msgstr "L'email '{0}' est déjà utilisé."

#. Format arguments: {0}: user.Email
#: Services/UserService.cs
#, csharp-format
msgctxt "OrchardCore.Users.Services.UserService"
msgid "Email '{0}' is invalid."
msgstr "L'e-mail '{0}' est invalide."

#: Services/UserService.cs
msgctxt "OrchardCore.Users.Services.UserService"
msgid "Incorrect password."
msgstr "Mot de passe incorrect."

#: Services/UserService.cs
msgctxt "OrchardCore.Users.Services.UserService"
msgid "Local login is disabled."
msgstr "Le login local est désactivé."

#. Format arguments: {0}: _identityOptions.Password.RequiredLength
#: Services/UserService.cs
#, csharp-format
msgctxt "OrchardCore.Users.Services.UserService"
msgid "Passwords must be at least {0} characters."
msgstr "Les mots de passe doivent comporter au moins {0} caractères."

#. Format arguments: {0}: _identityOptions.Password.RequiredUniqueChars
#: Services/UserService.cs
#, csharp-format
msgctxt "OrchardCore.Users.Services.UserService"
msgid "Passwords must contain at least {0} unique characters."
msgstr "Les mots de passe doivent comporter au moins {0} caractères."

#: Services/UserService.cs
msgctxt "OrchardCore.Users.Services.UserService"
msgid "Passwords must have at least one digit character ('0'-'9')."
msgstr "Les mots de passe doivent avoir au moins un chiffre ('0'-'9')."

#: Services/UserService.cs
msgctxt "OrchardCore.Users.Services.UserService"
msgid "Passwords must have at least one lowercase character ('a'-'z')."
msgstr "Les mots de passe doivent avoir au moins un caractère en minuscule ('a'-'z')."

#: Services/UserService.cs
msgctxt "OrchardCore.Users.Services.UserService"
msgid "Passwords must have at least one non letter or digit character."
msgstr "Les mots de passe doivent avoir au moins un caractère non lettre ou chiffres."

#: Services/UserService.cs
msgctxt "OrchardCore.Users.Services.UserService"
msgid "Passwords must have at least one uppercase character ('A'-'Z')."
msgstr "Les mots de passe doivent avoir au moins un caractère en majuscule ('A'-'Z')."

#: Services/UserService.cs
msgctxt "OrchardCore.Users.Services.UserService"
msgid "The reset token is invalid. Please request a new token."
msgstr "Le jeton de réinitialisation n'est pas valide. Veuillez demander un nouveau jeton."

#: Services/UserService.cs
msgctxt "OrchardCore.Users.Services.UserService"
msgid "The specified user is not allowed to sign in using password authentication."
msgstr "L'utilisateur spécifié n'est pas autorisé à se connecter en utilisant l'authentification par mot de passe."

#: Services/UserService.cs
msgctxt "OrchardCore.Users.Services.UserService"
msgid "The specified user is not allowed to sign in."
msgstr "L'utilisateur spécifié n'est pas autorisé à se connecter."

#: Services/UserService.cs
msgctxt "OrchardCore.Users.Services.UserService"
msgid "The specified username/password couple is invalid."
msgstr "Le couple nom d'utilisateur/mot de passe spécifié est invalide."

#: Services/UserService.cs
msgctxt "OrchardCore.Users.Services.UserService"
msgid "The user is locked out."
msgstr "L'utilisateur est verrouillé."

#. Format arguments: {0}: error.Code
#: Services/UserService.cs
#, csharp-format
msgctxt "OrchardCore.Users.Services.UserService"
msgid "Unexpected error: '{0}'."
msgstr "Erreur inattendue : '{0}'."

#. Format arguments: {0}: user.UserName
#: Services/UserService.cs
#, csharp-format
msgctxt "OrchardCore.Users.Services.UserService"
msgid "User name '{0}' is already used."
msgstr "Le nom d'utilisateur '{0}' est déjà utilisé."

#. Format arguments: {0}: user.UserName
#: Services/UserService.cs
#, csharp-format
msgctxt "OrchardCore.Users.Services.UserService"
msgid "User name '{0}' is invalid, can only contain letters or digits."
msgstr "Le nom d'utilisateur '{0}' est invalide, ne peut contenir que des lettres ou des chiffres."

