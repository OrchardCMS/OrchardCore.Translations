#. Format arguments: {0}: field.Key
#: Expressions/ExpressionCompiler.cs
#, csharp-format
msgctxt "OrchardCore.DataSources.Expressions.ExpressionCompiler"
msgid "The field [{0}] does not exist."
msgstr "Le champ [{0}] n’existe pas."

#. Format arguments: {0}: field.Key
#: Expressions/ExpressionCompiler.cs
#, csharp-format
msgctxt "OrchardCore.DataSources.Expressions.ExpressionCompiler"
msgid "The field [{0}] is already aggregated and cannot be aggregated again."
msgstr "Le champ [{0}] est déjà agrégé et ne peut pas être agrégé à nouveau."

#: Expressions/ExpressionCompiler.cs
msgctxt "OrchardCore.DataSources.Expressions.ExpressionCompiler"
msgid "The formula contains an unsupported element."
msgstr "La formule contient un élément non pris en charge."

#: Expressions/ExpressionCompiler.cs
msgctxt "OrchardCore.DataSources.Expressions.ExpressionCompiler"
msgid ""
"The formula mixes aggregated values (such as SUM) with row-level fields. "
"Wrap each field in an aggregate function."
msgstr ""
"La formule mélange des valeurs agrégées (telles que SUM) et des champs au "
"niveau des lignes. Placez chaque champ dans une fonction d’agrégation."

#. Format arguments: {0}: function.Name
#: Expressions/ExpressionCompiler.cs
#, csharp-format
msgctxt "OrchardCore.DataSources.Expressions.ExpressionCompiler"
msgid "The function {0} cannot be used inside another aggregate function."
msgstr ""
"La fonction {0} ne peut pas être utilisée à l’intérieur d’une autre fonction"
" d’agrégation."

#. Format arguments: {0}: call.Name
#: Expressions/ExpressionCompiler.cs
#, csharp-format
msgctxt "OrchardCore.DataSources.Expressions.ExpressionCompiler"
msgid "The function {0} does not exist."
msgstr "La fonction {0} n’existe pas."

#. Format arguments: {0}: function.Name; {1}: function.Signature
#: Expressions/ExpressionCompiler.cs
#, csharp-format
msgctxt "OrchardCore.DataSources.Expressions.ExpressionCompiler"
msgid "The function {0} is written {1}."
msgstr "La fonction {0} s’écrit {1}."

#. Format arguments: {0}: function.Name; {1}: argument.DataType
#: Expressions/ExpressionCompiler.cs
#, csharp-format
msgctxt "OrchardCore.DataSources.Expressions.ExpressionCompiler"
msgid "The function {0} needs a number, but receives a {1} value."
msgstr "La fonction {0} attend un nombre, mais reçoit une valeur de type {1}."

#. Format arguments: {0}: binary.Operator; {1}: leftType; {2}: rightType
#: Expressions/ExpressionCompiler.cs
#, csharp-format
msgctxt "OrchardCore.DataSources.Expressions.ExpressionCompiler"
msgid "The operator '{0}' cannot combine {1} and {2} values."
msgstr ""
"L’opérateur '{0}' ne peut pas combiner des valeurs de type {1} et {2}."

#. Format arguments: {0}: unary.Operator
#: Expressions/ExpressionCompiler.cs
#, csharp-format
msgctxt "OrchardCore.DataSources.Expressions.ExpressionCompiler"
msgid "The operator '{0}' needs a number."
msgstr "L’opérateur '{0}' nécessite un nombre."

#. Format arguments: {0}: start + 1
#: Expressions/ExpressionLexer.cs
#, csharp-format
msgctxt "OrchardCore.DataSources.Expressions.ExpressionLexer"
msgid "The field reference that starts at position {0} has no closing ']'."
msgstr ""
"La référence de champ qui commence à la position {0} ne comporte pas de "
"crochet fermant ']'."

#. Format arguments: {0}: start + 1
#: Expressions/ExpressionLexer.cs
#, csharp-format
msgctxt "OrchardCore.DataSources.Expressions.ExpressionLexer"
msgid "The text that starts at position {0} has no closing quote."
msgstr ""
"Le texte qui commence à la position {0} ne comporte pas de guillemet "
"fermant."

#. Format arguments: {0}: current; {1}: index + 1
#: Expressions/ExpressionLexer.cs
#, csharp-format
msgctxt "OrchardCore.DataSources.Expressions.ExpressionLexer"
msgid "Unexpected character '{0}' at position {1}."
msgstr "Caractère inattendu '{0}' à la position {1}."

#. Format arguments: {0}: text; {1}: token.Position + 1; {2}: token.Text
#: Expressions/ExpressionParser.cs
#, csharp-format
msgctxt "OrchardCore.DataSources.Expressions.ExpressionParser"
msgid "Expected '{0}' at position {1} but found '{2}'."
msgstr "'{0}' attendu à la position {1}, mais '{2}' a été trouvé."

#. Format arguments: {0}: text
#: Expressions/ExpressionParser.cs
#, csharp-format
msgctxt "OrchardCore.DataSources.Expressions.ExpressionParser"
msgid "Expected '{0}' at the end of the formula."
msgstr "'{0}' attendu à la fin de la formule."

#. Format arguments: {0}: token.Position + 1
#: Expressions/ExpressionParser.cs
#, csharp-format
msgctxt "OrchardCore.DataSources.Expressions.ExpressionParser"
msgid "The field reference at position {0} is empty."
msgstr "La référence de champ à la position {0} est vide."

#: Expressions/ExpressionParser.cs
msgctxt "OrchardCore.DataSources.Expressions.ExpressionParser"
msgid "The formula ends unexpectedly."
msgstr "La formule se termine de manière inattendue."

#: Expressions/ExpressionParser.cs
msgctxt "OrchardCore.DataSources.Expressions.ExpressionParser"
msgid "The formula is empty."
msgstr "La formule est vide."

#: Expressions/ExpressionParser.cs
msgctxt "OrchardCore.DataSources.Expressions.ExpressionParser"
msgid "The formula is nested too deeply."
msgstr "La formule comporte trop de niveaux d’imbrication."

#. Format arguments: {0}: token.Text; {1}: token.Position + 1
#: Expressions/ExpressionParser.cs
#, csharp-format
msgctxt "OrchardCore.DataSources.Expressions.ExpressionParser"
msgid "The number '{0}' at position {1} is too large."
msgstr "Le nombre '{0}' à la position {1} est trop grand."

#. Format arguments: {0}: next.Text, token.Text; {1}: next.Position + 1,
#. token.Position + 1
#: Expressions/ExpressionParser.cs
#, csharp-format
msgctxt "OrchardCore.DataSources.Expressions.ExpressionParser"
msgid "Unexpected '{0}' at position {1}."
msgstr "'{0}' inattendu à la position {1}."

#. Format arguments: {0}: token.Text; {1}: token.Position + 1
#: Expressions/ExpressionParser.cs
#, csharp-format
msgctxt "OrchardCore.DataSources.Expressions.ExpressionParser"
msgid ""
"Unknown name '{0}' at position {1}. Write fields in square brackets, such as"
" [Name]."
msgstr ""
"Nom '{0}' inconnu à la position {1}. Écrivez les champs entre crochets, par "
"exemple [Name]."

#: Files/CsvDataFileFormat.cs
msgctxt "OrchardCore.DataSources.Files.CsvDataFileFormat"
msgid "CSV (comma separated values)"
msgstr "CSV (valeurs séparées par des virgules)"

#: Files/ExcelDataFileFormat.cs
msgctxt "OrchardCore.DataSources.Files.ExcelDataFileFormat"
msgid "Excel workbook"
msgstr "Classeur Excel"

#: Files/ExcelDataFileFormat.cs
msgctxt "OrchardCore.DataSources.Files.ExcelDataFileFormat"
msgid "The file is not an Excel workbook."
msgstr "Le fichier n’est pas un classeur Excel."

#. Format arguments: {0}: options.SheetName ?? string.Empty
#: Files/ExcelDataFileFormat.cs
#, csharp-format
msgctxt "OrchardCore.DataSources.Files.ExcelDataFileFormat"
msgid "The workbook has no worksheet named '{0}'."
msgstr "Le classeur ne contient aucune feuille de calcul nommée '{0}'."

#. Format arguments: {0}: sheetName; {1}: maxRows
#: Files/ExcelDataFileFormat.cs
#, csharp-format
msgctxt "OrchardCore.DataSources.Files.ExcelDataFileFormat"
msgid ""
"The worksheet '{0}' can hold {1} rows at most. Write the rows to a CSV file,"
" or split them into several worksheets."
msgstr ""
"La feuille de calcul '{0}' peut contenir au maximum {1} lignes. Écrivez les "
"lignes dans un fichier CSV ou répartissez-les sur plusieurs feuilles de "
"calcul."

#: Files/JsonDataFileFormat.cs
msgctxt "OrchardCore.DataSources.Files.JsonDataFileFormat"
msgid "JSON"
msgstr "JSON"

#: Files/JsonLinesDataFileFormat.cs
msgctxt "OrchardCore.DataSources.Files.JsonLinesDataFileFormat"
msgid "JSON Lines"
msgstr "JSON Lines"
