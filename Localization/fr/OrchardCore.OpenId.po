#: Services/OpenIdServerService.cs
msgctxt "OrchardCore.OpenId.Services.OpenIdServerService"
msgid "Access token encryption can only be disabled when using JWT tokens."
msgstr "Le chiffrement des jetons d'accès ne peut être désactivé que lorsque vous utilisez des jetons JWT."

#: Services/OpenIdServerService.cs
msgctxt "OrchardCore.OpenId.Services.OpenIdServerService"
msgid "At least one OpenID Connect flow must be enabled."
msgstr "Au moins un flux OpenID Connect doit être activé."

#: Services/OpenIdServerService.cs
msgctxt "OrchardCore.OpenId.Services.OpenIdServerService"
msgid "The authority cannot contain a query string or a fragment."
msgstr "L'autorité ne peut pas contenir une chaîne de requête ou un fragment."

#: Services/OpenIdServerService.cs
msgctxt "OrchardCore.OpenId.Services.OpenIdServerService"
msgid "The authority must be a valid absolute URL."
msgstr "L'autorité doit être une URL absolue valide."

#: Services/OpenIdServerService.cs
msgctxt "OrchardCore.OpenId.Services.OpenIdServerService"
msgid "The authorization code flow cannot be enabled when the authorization and token endpoints are disabled."
msgstr "Le flux de code d'autorisation ne peut pas être activé lorsque les points de terminaison d'autorisation et de jetons sont désactivés."

#: Services/OpenIdServerService.cs
msgctxt "OrchardCore.OpenId.Services.OpenIdServerService"
msgid "The certificate cannot be found."
msgstr "Le certificat ne peut pas être trouvé."

#: Services/OpenIdServerService.cs
msgctxt "OrchardCore.OpenId.Services.OpenIdServerService"
msgid "The certificate doesn't contain the required private key."
msgstr "Le certificat ne contient pas la clé privée requise."

#: Services/OpenIdServerService.cs
msgctxt "OrchardCore.OpenId.Services.OpenIdServerService"
msgid "The certificate is not valid because it is marked as archived."
msgstr "Le certificat n'est pas valide car il est marqué comme archivé."

#: Services/OpenIdServerService.cs
msgctxt "OrchardCore.OpenId.Services.OpenIdServerService"
msgid "The certificate is not valid for current date."
msgstr "Le certificat n'est pas valide pour la date actuelle."

#: Services/OpenIdServerService.cs
msgctxt "OrchardCore.OpenId.Services.OpenIdServerService"
msgid "The client credentials flow cannot be enabled when the token endpoint is disabled."
msgstr "Le flux d'identifiants client ne peut pas être activé lorsque le point de terminaison du jeton est désactivé."

#: Services/OpenIdServerService.cs
msgctxt "OrchardCore.OpenId.Services.OpenIdServerService"
msgid "The hybrid flow cannot be enabled when the authorization and token endpoints are disabled."
msgstr "Le flux hybride ne peut pas être activé lorsque les points de terminaison d'autorisation et de jeton sont désactivés."

#: Services/OpenIdServerService.cs
msgctxt "OrchardCore.OpenId.Services.OpenIdServerService"
msgid "The implicit flow cannot be enabled when the authorization endpoint is disabled."
msgstr "Le flux implicite ne peut pas être activé lorsque le point de terminaison d'autorisation est désactivé."

#: Services/OpenIdServerService.cs
msgctxt "OrchardCore.OpenId.Services.OpenIdServerService"
msgid "The password flow cannot be enabled when the token endpoint is disabled."
msgstr "Le flux de mot de passe ne peut pas être activé lorsque le point de terminaison du jeton est désactivé."

#: Services/OpenIdServerService.cs
msgctxt "OrchardCore.OpenId.Services.OpenIdServerService"
msgid "The pushed authorization endpoint can only be enabled when the authorization endpoint is enabled."
msgstr "Le point de terminaison d'autorisation Pushed ne peut être activé que lorsque le point de terminaison d'autorisation est activé."

#: Services/OpenIdServerService.cs
msgctxt "OrchardCore.OpenId.Services.OpenIdServerService"
msgid "The pushed authorization endpoint must be enabled when enforcing pushed authorization requests."
msgstr "Le point de terminaison d'autorisation Pushed doit être activé lors de l'application des demandes d'autorisation Pushed."

#: Services/OpenIdServerService.cs
msgctxt "OrchardCore.OpenId.Services.OpenIdServerService"
msgid "The refresh token flow can only be enabled if the password, authorization code or hybrid flows are enabled."
msgstr "Le flux de jeton de rafraîchissement ne peut être activé que si le mot de passe, le code d'autorisation ou les flux hybrides sont activés."

#: Services/OpenIdServerService.cs
msgctxt "OrchardCore.OpenId.Services.OpenIdServerService"
msgid "The refresh token flow cannot be enabled when the token endpoint is disabled."
msgstr "Le flux de jeton de rafraîchissement ne peut pas être activé lorsque le point de terminaison du jeton est désactivé."

