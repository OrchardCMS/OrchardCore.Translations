msgctxt "OrchardCore.Elasticsearch.Core.Handlers.ElasticsearchIndexProfileHandler"
msgid "Invalid index name: it must be lowercase, under 255 bytes, not start with -, _, or +, and must not contain , /, *, ?, \", <, >, |, space, ,, or #, nor be \".\" or \"..\"."
msgstr "Nom d'index invalide : il doit être en minuscule, sous 255 octets, pas commencer par -, _, ou +, et ne doit pas contenir , /, *, ? \", <, >, |, espace, ou #, ni être \". ou \"..\"."

