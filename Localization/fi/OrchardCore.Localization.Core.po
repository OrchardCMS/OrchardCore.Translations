#: DataAnnotations/DataAnnotationsDefaultErrorMessages.cs
#, csharp-format
msgctxt "OrchardCore.Localization.DataAnnotations.DataAnnotationsDefaultErrorMessages"
msgid "'{0}' and '{1}' do not match."
msgstr "\"{0}\" ja \"{1}\" eivät täsmää."

#: DataAnnotations/DataAnnotationsDefaultErrorMessages.cs
msgctxt "OrchardCore.Localization.DataAnnotations.DataAnnotationsDefaultErrorMessages"
msgid "Both ErrorMessageResourceType and ErrorMessageResourceName need to be set on this attribute."
msgstr "Sekä ErrorMessageResourceType että ErrorMessageResourceName on asetettava tälle attribuutille."

#. Format arguments: {0}; {1}; {2}
#: DataAnnotations/DataAnnotationsDefaultErrorMessages.cs
#, csharp-format
msgctxt "OrchardCore.Localization.DataAnnotations.DataAnnotationsDefaultErrorMessages"
msgid "Cannot retrieve property '{0}' because localization failed.  Type '{1}' is not public or does not contain a public static string property with the name '{2}'."
msgstr "Ominaisuutta {0} ei voi noutaa, koska lokalisointi epäonnistui. Tyyppi \"{1}\" ei ole julkinen tai se ei sisällä julkista staattista merkkijono-oiminaisuutta, jonka nimi on '{2}'."

#. Format arguments: {0}; {1}; {2}; {3}
#: DataAnnotations/DataAnnotationsDefaultErrorMessages.cs
#, csharp-format
msgctxt "OrchardCore.Localization.DataAnnotations.DataAnnotationsDefaultErrorMessages"
msgid "Could not convert the value of type '{0}' to '{1}' as expected by method {2}.{3}."
msgstr "Tyypin \"{0}\" arvoa ei voitu muuttaa muotoon \"{1}\" kuten odotettua metodilla {2}.{3}."

#. Format arguments: {0}
#: DataAnnotations/DataAnnotationsDefaultErrorMessages.cs
#, csharp-format
msgctxt "OrchardCore.Localization.DataAnnotations.DataAnnotationsDefaultErrorMessages"
msgid "Could not find a property named {0}."
msgstr "Ominaisuutta nimeltä {0} ei löydy."

#: DataAnnotations/DataAnnotationsDefaultErrorMessages.cs
msgctxt "OrchardCore.Localization.DataAnnotations.DataAnnotationsDefaultErrorMessages"
msgid "Either ErrorMessageString or ErrorMessageResourceName must be set, but not both."
msgstr "Joko ErrorMessageString tai ErrorMessageResourceName on asetettava, mutta ei molempia."

#: DataAnnotations/DataAnnotationsDefaultErrorMessages.cs
msgctxt "OrchardCore.Localization.DataAnnotations.DataAnnotationsDefaultErrorMessages"
msgid "IsValid(object value) has not been implemented by this class. The preferred entry point is GetValidationResult() and classes should override IsValid(object value, ValidationContext context)."
msgstr "IsValid(object value) ei ole käyttöönotettu tässä luokassa. Ensisijainen lähtöpiste on GetValidationResult() ja luokkien pitäisi ylikirjoittaa IsValid(object valua, ValidationContext context)."

#: DataAnnotations/DataAnnotationsDefaultErrorMessages.cs
msgctxt "OrchardCore.Localization.DataAnnotations.DataAnnotationsDefaultErrorMessages"
msgid "MaxLengthAttribute must have a Length value that is greater than zero. Use MaxLength() without parameters to indicate that the string or array can have the maximum allowable length."
msgstr "MaxLengthAttribuute:n pituusarvon on oltava suurempi kuin nolla. Käytä MaxLength() ilman parametreja osoittamaan, että merkkijonolla tai taulukkolla voi olla suurin sallittu pituus."

#: DataAnnotations/DataAnnotationsDefaultErrorMessages.cs
msgctxt "OrchardCore.Localization.DataAnnotations.DataAnnotationsDefaultErrorMessages"
msgid "MetadataClassType cannot be null."
msgstr "MetadataClassType ei voi olla null."

#: DataAnnotations/DataAnnotationsDefaultErrorMessages.cs
msgctxt "OrchardCore.Localization.DataAnnotations.DataAnnotationsDefaultErrorMessages"
msgid "MinLengthAttribute must have a Length value that is zero or greater."
msgstr "MinLengthAttribuute:n pituusarvon on oltava nolla tai suurempi."

#. Format arguments: {0}; {1}
#: DataAnnotations/DataAnnotationsDefaultErrorMessages.cs
#, csharp-format
msgctxt "OrchardCore.Localization.DataAnnotations.DataAnnotationsDefaultErrorMessages"
msgid "The CustomValidationAttribute method '{0}' does not exist in type '{1}' or is not public and static."
msgstr "CustomValidationAttribute metodi \"{0}\" ei löydy tyypistä \"{1}\" tai se ei ole julkinen ja staattinen (static)."

#. Format arguments: {0}; {1}
#: DataAnnotations/DataAnnotationsDefaultErrorMessages.cs
#, csharp-format
msgctxt "OrchardCore.Localization.DataAnnotations.DataAnnotationsDefaultErrorMessages"
msgid "The CustomValidationAttribute method '{0}' in type '{1}' must match the expected signature: public static ValidationResult {0}(object value, ValidationContext context). The value can be strongly typed. The ValidationContext parameter is optional."
msgstr "CustomValidationAttribute metodi \"{0}\" tyypissä \"{1}\" tulisi vastata odotettua allekirjoitusta: public static ValidationResult {0}(object value, ValidationContext context). Arvo voidaan kirjoittaa vahvana. ValidationContext-parametri on valinnainen."

#. Format arguments: {0}; {1}
#: DataAnnotations/DataAnnotationsDefaultErrorMessages.cs
#, csharp-format
msgctxt "OrchardCore.Localization.DataAnnotations.DataAnnotationsDefaultErrorMessages"
msgid "The CustomValidationAttribute method '{0}' in type '{1}' must return System.ComponentModel.DataAnnotations.ValidationResult.  Use System.ComponentModel.DataAnnotations.ValidationResult.Success to represent success."
msgstr "Metodin CustomValidationAttribute \"{0}\" tyypissä \"{1}\" tulisi palauttaa System.ComponentModel.DataAnnotations.ValidationResult. Käytä System.ComponentModel.DataAnnotations.ValidationResult.Success edustamaan onnistumissa."

#: DataAnnotations/DataAnnotationsDefaultErrorMessages.cs
msgctxt "OrchardCore.Localization.DataAnnotations.DataAnnotationsDefaultErrorMessages"
msgid "The CustomValidationAttribute.Method was not specified."
msgstr "CustomValidationAttribute.Method ei ole määritelty."

#: DataAnnotations/DataAnnotationsDefaultErrorMessages.cs
msgctxt "OrchardCore.Localization.DataAnnotations.DataAnnotationsDefaultErrorMessages"
msgid "The CustomValidationAttribute.ValidatorType was not specified."
msgstr "CustomValidationAttribute.ValidatorType ei ole määritelty."

#: DataAnnotations/DataAnnotationsDefaultErrorMessages.cs
msgctxt "OrchardCore.Localization.DataAnnotations.DataAnnotationsDefaultErrorMessages"
msgid "The OperandType must be set when strings are used for minimum and maximum values."
msgstr "OperandType on määritettävä, kun merkkijonoja käytetään minimi- ja maksimiarvoihin arvoihin."

#. Format arguments: {0}; {1}
#: DataAnnotations/DataAnnotationsDefaultErrorMessages.cs
#, csharp-format
msgctxt "OrchardCore.Localization.DataAnnotations.DataAnnotationsDefaultErrorMessages"
msgid "The associated metadata type for type '{0}' contains the following unknown properties or fields: {1}. Please make sure that the names of these members match the names of the properties on the main type."
msgstr "Tyypin \"{0}\" liittyvä metatietotyyppi sisältää seuraavat tuntemattomat ominaisuudet tai kentät: {1}. Ole hyvä ja varmista, että näiden jäsenten nimet vastaavat päätyypin ominaisuuksien nimiä."

#: DataAnnotations/DataAnnotationsDefaultErrorMessages.cs
msgctxt "OrchardCore.Localization.DataAnnotations.DataAnnotationsDefaultErrorMessages"
msgid "The custom DataType string cannot be null or empty."
msgstr "Mukautettu DataType-merkkijono ei voi olla tyhjä tai null."

#. Format arguments: {0}
#: DataAnnotations/DataAnnotationsDefaultErrorMessages.cs
#, csharp-format
msgctxt "OrchardCore.Localization.DataAnnotations.DataAnnotationsDefaultErrorMessages"
msgid "The custom validation type '{0}' must be public."
msgstr "Mukautettu validointityypin \"{0}\" täytyy olla julkinen."

#. Format arguments: {0}
#: DataAnnotations/DataAnnotationsDefaultErrorMessages.cs
#, csharp-format
msgctxt "OrchardCore.Localization.DataAnnotations.DataAnnotationsDefaultErrorMessages"
msgid "The field of type {0} must be a string, array or ICollection type."
msgstr "Tyypin {0} kentän on oltava merkkijono, taulukko tai ICollection-tyyppi."

#. Format arguments: {0}
#: DataAnnotations/DataAnnotationsDefaultErrorMessages.cs
#, csharp-format
msgctxt "OrchardCore.Localization.DataAnnotations.DataAnnotationsDefaultErrorMessages"
