msgid "Configuring External Authentication for User Login with Third-Party Providers"
msgstr "Ulkoisen tunnistautumisen määrittäminen kirjautumiseen kolmansien osapuolten palveluntarjoajien avulla"

#: Views/ExternalLoginSettings.Edit.cshtml
msgctxt "OrchardCore.Users.Views.ExternalLoginSettings.Edit"
msgid "If only one external provider is defined, auto challenge the provider to login. You should also configure registration options"
msgstr "Jos vain yksi ulkoinen tarjoaja on määritelty, haasta tarjoaja automaattisesti kirjautumiseen. Sinun tulisi myös määrittää rekisteröintiasetukset"

