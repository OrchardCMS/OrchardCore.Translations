#: GraphQL/UserType.cs
#, csharp-format
msgctxt "OrchardCore.Users.GraphQL.UserType"
msgid "Custom user settings of {0}."
msgstr "Impostazioni utente personalizzate di {0}."

#: GraphQL/UserType.cs
msgctxt "OrchardCore.Users.GraphQL.UserType"
msgid "Represents a user."
msgstr "Rappresenta un utente."

#: GraphQL/UserType.cs
msgctxt "OrchardCore.Users.GraphQL.UserType"
msgid "The email of the user."
msgstr "L'email dell'utente."

#: GraphQL/UserType.cs
msgctxt "OrchardCore.Users.GraphQL.UserType"
msgid "The id of the user."
msgstr "L'id dell'utente."

#: GraphQL/UserType.cs
msgctxt "OrchardCore.Users.GraphQL.UserType"
msgid "The name of the user."
msgstr "Il nome dell'utente."

#: GraphQL/UserType.cs
msgctxt "OrchardCore.Users.GraphQL.UserType"
msgid "The phone number of the user."
msgstr "Il numero di telefono dell'utente."

#: Services/UserService.cs
msgctxt "OrchardCore.Users.Services.UserService"
msgid "A password is required."
msgstr "La password è obbligatoria."

#: Services/UserService.cs
msgctxt "OrchardCore.Users.Services.UserService"
msgid "A token is required."
msgstr "Il token è obbligatorio."

#: Services/UserService.cs
msgctxt "OrchardCore.Users.Services.UserService"
msgid "A user name is required."
msgstr "Il nome utente è obbligatorio."

#: Services/UserService.cs
msgctxt "OrchardCore.Users.Services.UserService"
msgid "A username or email address is required."
msgstr "È richiesto un nome utente o un indirizzo email."

#. Format arguments: {0}: user.Email
#: Services/UserService.cs
#, csharp-format
msgctxt "OrchardCore.Users.Services.UserService"
msgid "Email '{0}' is already used."
msgstr "L'indirizzo E-mail '{0}' è già in uso."

#. Format arguments: {0}: user.Email
#: Services/UserService.cs
#, csharp-format
msgctxt "OrchardCore.Users.Services.UserService"
msgid "Email '{0}' is invalid."
msgstr "Email '{0}' non valida."

#: Services/UserService.cs
msgctxt "OrchardCore.Users.Services.UserService"
msgid "Incorrect password."
msgstr "Password errata."

#: Services/UserService.cs
msgctxt "OrchardCore.Users.Services.UserService"
msgid "Local login is disabled."
msgstr "L'autenticazione tramite sistema integrato è disabilitata."

#. Format arguments: {0}: _identityOptions.Password.RequiredLength
#: Services/UserService.cs
#, csharp-format
msgctxt "OrchardCore.Users.Services.UserService"
msgid "Passwords must be at least {0} characters."
msgstr "Le password devono essere come minimo di {0} caratteri."

#. Format arguments: {0}: _identityOptions.Password.RequiredUniqueChars
#: Services/UserService.cs
#, csharp-format
msgctxt "OrchardCore.Users.Services.UserService"
msgid "Passwords must contain at least {0} unique characters."
msgstr "Le password devono contenere almeno {0} caratteri unici."

#: Services/UserService.cs
msgctxt "OrchardCore.Users.Services.UserService"
msgid "Passwords must have at least one digit character ('0'-'9')."
msgstr "Le password devono avere almeno un carattere numerico ('0'-'9')."

#: Services/UserService.cs
msgctxt "OrchardCore.Users.Services.UserService"
msgid "Passwords must have at least one lowercase character ('a'-'z')."
msgstr "Le password devono avere almeno un carattere minuscolo ('a'-'z')."

#: Services/UserService.cs
msgctxt "OrchardCore.Users.Services.UserService"
msgid "Passwords must have at least one non letter or digit character."
msgstr "Le password devono avere almeno un carattere non alfanumerico."

#: Services/UserService.cs
msgctxt "OrchardCore.Users.Services.UserService"
msgid "Passwords must have at least one uppercase character ('A'-'Z')."
msgstr "Le password devono avere almeno un carattere maiuscolo ('A'-'Z')."

#: Services/UserService.cs
msgctxt "OrchardCore.Users.Services.UserService"
msgid "The reset token is invalid. Please request a new token."
msgstr "Il reset token non è valido. Richiedi un nuovo token."

#: Services/UserService.cs
msgctxt "OrchardCore.Users.Services.UserService"
msgid "The specified user is not allowed to sign in using password authentication."
msgstr "L'utente specificato non è autorizzato ad accedere utilizzando l'autenticazione tramite password."

#: Services/UserService.cs
msgctxt "OrchardCore.Users.Services.UserService"
msgid "The specified user is not allowed to sign in."
msgstr "L'utente specificato non è autorizzato ad accedere."

#: Services/UserService.cs
msgctxt "OrchardCore.Users.Services.UserService"
msgid "The specified username/password couple is invalid."
msgstr "La coppia nome utente/password specificata non è valida."

#: Services/UserService.cs
msgctxt "OrchardCore.Users.Services.UserService"
msgid "The user is locked out."
msgstr "L'utente è bloccato."

#. Format arguments: {0}: error.Code
#: Services/UserService.cs
#, csharp-format
msgctxt "OrchardCore.Users.Services.UserService"
msgid "Unexpected error: '{0}'."
msgstr "Errore imprevisto: '{0}'."

#. Format arguments: {0}: user.UserName
#: Services/UserService.cs
#, csharp-format
msgctxt "OrchardCore.Users.Services.UserService"
msgid "User name '{0}' is already used."
msgstr "Il nome utente '{0}' è già utilizzato."

#. Format arguments: {0}: user.UserName
#: Services/UserService.cs
#, csharp-format
msgctxt "OrchardCore.Users.Services.UserService"
msgid "User name '{0}' is invalid, can only contain letters or digits."
msgstr "Il nome utente '{0}' non è valido, può contenere solo lettere o cifre."

