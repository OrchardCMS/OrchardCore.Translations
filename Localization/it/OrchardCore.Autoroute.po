#: Drivers/AutoroutePartDisplayDriver.cs
msgctxt "OrchardCore.Autoroute.Drivers.AutoroutePartDisplayDriver"
msgid "Your permalink is already in use."
msgstr "Permalink già in uso."

#: GraphQL/AutorouteInputObjectType.cs
msgctxt "OrchardCore.Autoroute.GraphQL.AutorouteInputObjectType"
msgid "the custom URL part of the content item"
msgstr "indirizzo personalizzato dell'elemento di contenuto"

#: GraphQL/AutorouteInputObjectType.cs
msgctxt "OrchardCore.Autoroute.GraphQL.AutorouteInputObjectType"
msgid "the path of the content item to filter"
msgstr "il percorso dell'elemento di contenuto da filtrare"

#: GraphQL/AutorouteQueryObjectType.cs
msgctxt "OrchardCore.Autoroute.GraphQL.AutorouteQueryObjectType"
msgid "Custom URLs (permalinks) for your content item."
msgstr "Indirizzi personalizzati (permalinks) per il tuo elemento di contenuto."

#: GraphQL/AutorouteQueryObjectType.cs
msgctxt "OrchardCore.Autoroute.GraphQL.AutorouteQueryObjectType"
msgid "The permalinks for your content item."
msgstr "I permalink per il tuo elemento di contenuto."

#: Handlers/AutoroutePartHandler.cs
msgctxt "OrchardCore.Autoroute.Handlers.AutoroutePartHandler"
msgid "Your permalink is already in use."
msgstr "Permalink già in uso."

#. Format arguments: {0}: invalidCharactersForMessage
#: Models/AutoroutePartExtensions.cs
#, csharp-format
msgctxt "OrchardCore.Autoroute.Models.AutoroutePartExtensions"
msgid "Please do not use any of the following characters in your permalink: {0}. No spaces, or consecutive slashes, are allowed (please use dashes or underscores instead)."
msgstr "Non utilizzare nessuno dei seguenti caratteri nel permalink: {0}. Non sono ammessi spazi o slash consecutivi (si prega di usare trattini o trattini bassi)."

#: Models/AutoroutePartExtensions.cs
msgctxt "OrchardCore.Autoroute.Models.AutoroutePartExtensions"
msgid "Your permalink can't be set to the homepage, please use the homepage option instead."
msgstr "Il permalink non può essere impostato sulla homepage. Usa l'opzione homepage, invece."

#. Format arguments: {0}: AutoroutePart.MaxPathLength
#: Models/AutoroutePartExtensions.cs
#, csharp-format
msgctxt "OrchardCore.Autoroute.Models.AutoroutePartExtensions"
msgid "Your permalink is too long. The permalink can only be up to {0} characters."
msgstr "Il permalink è troppo lungo. Il permalink può essere lungo al massimo {0} caratteri."

#. Format arguments: {0}: string.Join(" ", errors)
#: Settings/AutoroutePartSettingsDisplayDriver.cs
#, csharp-format
msgctxt "OrchardCore.Autoroute.Settings.AutoroutePartSettingsDisplayDriver"
msgid "Pattern doesn't contain a valid Liquid expression. Details: {0}"
msgstr "Il modello non contiene un'espressione Liquid valida. Dettagli: {0}"

#: Views/AutoroutePart.Edit.cshtml
msgctxt "OrchardCore.Autoroute.Views.AutoroutePart.Edit"
msgid "Absolute"
msgstr "Assoluto"

#: Views/AutoroutePart.Edit.cshtml
msgctxt "OrchardCore.Autoroute.Views.AutoroutePart.Edit"
msgid "Check to disable autoroute for this content item."
msgstr "Spunta la casella per disabilitare l'autoroute per questo elemento di contenuto."

#: Views/AutoroutePart.Edit.cshtml
msgctxt "OrchardCore.Autoroute.Views.AutoroutePart.Edit"
msgid "Check to enabling the routing of child content items."
msgstr "Spunta la casella per abilitare l'instradamento degli elementi di contenuto figlio."

#: Views/AutoroutePart.Edit.cshtml
msgctxt "OrchardCore.Autoroute.Views.AutoroutePart.Edit"
msgid "Check to refresh the path. Warning: the previous URL won't be accessible anymore."
msgstr "Seleziona per rigenerare l’indirizzo. Attenzione: l'indirizzo precedente verrà sostituito e non sarà più accessibile."

#: Views/AutoroutePart.Edit.cshtml
msgctxt "OrchardCore.Autoroute.Views.AutoroutePart.Edit"
msgid "Check to set this content item as the homepage once published."
msgstr "Seleziona per impostare questo elemento di contenuto come homepage una volta pubblicato."

#: Views/AutoroutePart.Edit.cshtml
msgctxt "OrchardCore.Autoroute.Views.AutoroutePart.Edit"
msgid "Check to specify that a child content item will be routed to an absolute path."
msgstr "Seleziona per specificare che un elemento di contenuto figlio sarà instradato a un percorso assoluto."

#: Views/AutoroutePart.Edit.cshtml
msgctxt "OrchardCore.Autoroute.Views.AutoroutePart.Edit"
msgid "Disabled"
msgstr "Disabilitato"

#: Views/AutoroutePart.Edit.cshtml
msgctxt "OrchardCore.Autoroute.Views.AutoroutePart.Edit"
msgid "Permalink"
msgstr "Permalink"

#: Views/AutoroutePart.Edit.cshtml
msgctxt "OrchardCore.Autoroute.Views.AutoroutePart.Edit"
msgid "Refresh the path"
msgstr "Aggiorna il permalink"

#: Views/AutoroutePart.Edit.cshtml
msgctxt "OrchardCore.Autoroute.Views.AutoroutePart.Edit"
msgid "Route contained items"
msgstr "Instradamento degli elementi contenuti"

#: Views/AutoroutePart.Edit.cshtml
msgctxt "OrchardCore.Autoroute.Views.AutoroutePart.Edit"
msgid "Set as homepage"
msgstr "Impostalo come homepage"

#: Views/AutoroutePart.Edit.cshtml
msgctxt "OrchardCore.Autoroute.Views.AutoroutePart.Edit"
msgid "The url of the content item. It will be automatically generated."
msgstr "L'indirizzo URL del contenuto. Viene generato automaticamente."

#: Views/AutoroutePart.Edit.cshtml
msgctxt "OrchardCore.Autoroute.Views.AutoroutePart.Edit"
msgid "The url of the content item. Leave empty to auto-generate it."
msgstr "L'indirizzo URL del contenuto. Lascialo vuoto per generalo automaticamente."

#: Views/AutoroutePart.Edit.cshtml
msgctxt "OrchardCore.Autoroute.Views.AutoroutePart.Edit"
msgid "This content item is the current homepage"
msgstr "Questo elemento di contenuto è l'attuale homepage"

#: Views/AutoroutePartSettings.Edit.cshtml
msgctxt "OrchardCore.Autoroute.Views.AutoroutePartSettings.Edit"
msgid "Allow absolute path"
msgstr "Consenti un percorso assoluto"

#: Views/AutoroutePartSettings.Edit.cshtml
msgctxt "OrchardCore.Autoroute.Views.AutoroutePartSettings.Edit"
msgid "Allow contained item routing"
msgstr "Permetti l'instradamento degli oggetti contenuti"

#: Views/AutoroutePartSettings.Edit.cshtml
msgctxt "OrchardCore.Autoroute.Views.AutoroutePartSettings.Edit"
msgid "Allow custom path"
msgstr "Consenti un percorso personalizzato"

#: Views/AutoroutePartSettings.Edit.cshtml
msgctxt "OrchardCore.Autoroute.Views.AutoroutePartSettings.Edit"
msgid "Allow disabled"
msgstr "Permetti di disabilitarlo"

#: Views/AutoroutePartSettings.Edit.cshtml
msgctxt "OrchardCore.Autoroute.Views.AutoroutePartSettings.Edit"
msgid "Allow path updates"
msgstr "Consenti aggiornamenti percorso"

#: Views/AutoroutePartSettings.Edit.cshtml
msgctxt "OrchardCore.Autoroute.Views.AutoroutePartSettings.Edit"
msgid "Check to allow the content items of this content type to be set as the homepage. It will only be visible to users with the appropriate permission."
msgstr "Seleziona per consentire di impostare come homepage gli elementi di contenuto, di questo tipo di contenuto. L'opzione sarà visibile solo agli utenti con l'autorizzazione appropriata."

#: Views/AutoroutePartSettings.Edit.cshtml
msgctxt "OrchardCore.Autoroute.Views.AutoroutePartSettings.Edit"
msgid "Check to allow the content items of this content type to disable autoroute."
msgstr "Spunta la casella per consentire agli elementi di contenuto di questo tipo di contenuto di disabilitare l'autoroute."

#: Views/AutoroutePartSettings.Edit.cshtml
msgctxt "OrchardCore.Autoroute.Views.AutoroutePartSettings.Edit"
msgid "Check to allow this part to apply routes to child content items. This setting must be applied to the child content item."
msgstr "Spunta la casella per consentire a questa parte di applicare l'instradamento agli elementi di contenuto figlio. Questa impostazione deve essere applicata all'elemento di contenuto figlio."

#: Views/AutoroutePartSettings.Edit.cshtml
msgctxt "OrchardCore.Autoroute.Views.AutoroutePartSettings.Edit"
msgid "Check to allow users to enable absolute paths for child content items. When disabled the path is relative to the parents path."
msgstr "Spunta la casella per consentire agli utenti di abilitare percorsi assoluti per gli elementi contenuti figli. Quando disabilitato il percorso è relativo al percorso dei genitori."

#: Views/AutoroutePartSettings.Edit.cshtml
msgctxt "OrchardCore.Autoroute.Views.AutoroutePartSettings.Edit"
msgid "Check to allow users to enable routing of child content items. This setting must be applied to the parent content item."
msgstr "Spunta la casella per consentire agli utenti di abilitare l'instradamento degli elementi di contenuto figlio. Questa impostazione deve essere applicata all'elemento di contenuto genitore."

#: Views/AutoroutePartSettings.Edit.cshtml
msgctxt "OrchardCore.Autoroute.Views.AutoroutePartSettings.Edit"
msgid "Check to allow users to refresh the path once a content item is already published."
msgstr "Seleziona per consentire agli utenti di aggiornare il percorso una volta che un elemento di contenuto è già stato pubblicato."

#: Views/AutoroutePartSettings.Edit.cshtml
msgctxt "OrchardCore.Autoroute.Views.AutoroutePartSettings.Edit"
msgid "Check to allow users to set a custom path, otherwise it will be automatically generated."
msgstr "Seleziona per consentire agli utenti di impostare un percorso personalizzato, altrimenti verrà generato automaticamente."

#: Views/AutoroutePartSettings.Edit.cshtml
msgctxt "OrchardCore.Autoroute.Views.AutoroutePartSettings.Edit"
msgid "Container Settings"
msgstr "Impostazioni del contentenitore"

#: Views/AutoroutePartSettings.Edit.cshtml
msgctxt "OrchardCore.Autoroute.Views.AutoroutePartSettings.Edit"
msgid "Manage contained item routes"
msgstr "Gestisci i percorsi degli oggetti contenuti"

#: Views/AutoroutePartSettings.Edit.cshtml
msgctxt "OrchardCore.Autoroute.Views.AutoroutePartSettings.Edit"
msgid "Pattern"
msgstr "Modello"

#: Views/AutoroutePartSettings.Edit.cshtml
msgctxt "OrchardCore.Autoroute.Views.AutoroutePartSettings.Edit"
msgid "Settings for parent or child content items."
msgstr "Impostazioni per elementi di contenuto genitore o figlio."

#: Views/AutoroutePartSettings.Edit.cshtml
msgctxt "OrchardCore.Autoroute.Views.AutoroutePartSettings.Edit"
msgid "Show homepage options"
msgstr "Mostra opzioni homepage"

#: Views/AutoroutePartSettings.Edit.cshtml
msgctxt "OrchardCore.Autoroute.Views.AutoroutePartSettings.Edit"
msgid "The pattern used to render the custom url of this content type. With Liquid support."
msgstr "Il modello utilizzato per generare l'indirizzo personalizzato di questo tipo di contenuto. Supporta sintassi Liquid."

#: Views/AutoroutePartSettings.Edit.cshtml
msgctxt "OrchardCore.Autoroute.Views.AutoroutePartSettings.Edit"
msgid "When absolute : https://mysite.com/my-child-item."
msgstr "Dove per assoluto si intende: https://mysite.com/my-child-item."

#: Views/AutoroutePartSettings.Edit.cshtml
msgctxt "OrchardCore.Autoroute.Views.AutoroutePartSettings.Edit"
msgid "When relative : https://mysite.com/my-parent/my-child-item."
msgstr "Dove per relativo si intende: https://mysite.com/my-parent/my-child-item."

