#: Shell/Removing/ShellRemovalManager.cs
msgctxt "OrchardCore.Environment.Shell.Removing.ShellRemovalManager"
msgid "Failed to acquire a lock before executing the host handlers."
msgstr "Impossibile acquisire un blocco prima di eseguire tutti gli handler dell'host."

#: Shell/Removing/ShellRemovalManager.cs
msgctxt "OrchardCore.Environment.Shell.Removing.ShellRemovalManager"
msgid "Failed to acquire a lock before executing the tenant handlers."
msgstr "Impossibile acquisire un blocco prima di eseguire tutti gli handler del tenant."

#: Shell/Removing/ShellRemovalManager.cs
msgctxt "OrchardCore.Environment.Shell.Removing.ShellRemovalManager"
msgid "Failed to create a 'ShellContext' before removing the tenant."
msgstr "Impossibile creare un 'ShellContext' prima di rimuovere il tenant."

#. Format arguments: {0}: type
#: Shell/Removing/ShellRemovalManager.cs
#, csharp-format
msgctxt "OrchardCore.Environment.Shell.Removing.ShellRemovalManager"
msgid "Failed to execute the host handler '{0}'."
msgstr "Esecuzione dell'handler dell'host '{0} non riuscita."

#. Format arguments: {0}: type
#: Shell/Removing/ShellRemovalManager.cs
#, csharp-format
msgctxt "OrchardCore.Environment.Shell.Removing.ShellRemovalManager"
msgid "Failed to execute the tenant handler '{0}'."
msgstr "Esecuzione dell'handler del tenant '{0} non riuscita."

#. Format arguments: {0}: shellSettings.Name
#: Shell/Removing/ShellRemovalManager.cs
#, csharp-format
msgctxt "OrchardCore.Environment.Shell.Removing.ShellRemovalManager"
msgid "The tenant '{0}' should be 'Disabled' or 'Uninitialized'."
msgstr "Il tenant '{0}' dovrebbe essere 'Disabilitato' o 'Uninitialized'."

#. Format arguments: {0}: ShellSettings.DefaultShellName
#: Shell/Removing/ShellRemovalManager.cs
#, csharp-format
msgctxt "OrchardCore.Environment.Shell.Removing.ShellRemovalManager"
msgid "The tenant should not be the '{0}' tenant."
msgstr "Il tenant non dovrebbe essere il tenant '{0}'."

#: Shell/Removing/ShellSettingsRemovingHandler.cs
msgctxt "OrchardCore.Environment.Shell.Removing.ShellSettingsRemovingHandler"
msgid "Failed to remove the shell settings."
msgstr "Impossibile rimuovere le impostazioni della shell."

#. Format arguments: {0}: shellAppDataFolder
#: Shell/Removing/ShellSiteFolderRemovingHandler.cs
#, csharp-format
msgctxt "OrchardCore.Environment.Shell.Removing.ShellSiteFolderRemovingHandler"
msgid "Failed to remove the site folder '{0}'."
msgstr "Impossibile rimuovere la cartella del sito '{0}'."

#. Format arguments: {0}: shellWebRootFolder
#: Shell/Removing/ShellWebRootRemovingHandler.cs
#, csharp-format
msgctxt "OrchardCore.Environment.Shell.Removing.ShellWebRootRemovingHandler"
