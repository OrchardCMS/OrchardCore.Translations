#: Services/SetupService.cs
msgctxt "OrchardCore.Setup.Services.SetupService"
msgid "An error occurred while initializing the datastore."
msgstr ""

#: Services/SetupService.cs
msgctxt "OrchardCore.Setup.Services.SetupService"
msgid "DatabaseProvider setting is required."
msgstr "L'impostazione del DatabaseProvider è obbligatoria."

#: Services/SetupService.cs
msgctxt "OrchardCore.Setup.Services.SetupService"
msgid "The provided connection string is invalid or server is unreachable."
msgstr "La stringa di connessione fornita non è valida o il server non è raggiungibile."

#: Services/SetupService.cs
msgctxt "OrchardCore.Setup.Services.SetupService"
msgid "The provided database provider is not supported."
msgstr "Il provider di database fornito non è supportato."

#: Services/SetupService.cs
msgctxt "OrchardCore.Setup.Services.SetupService"
msgid "The provided database, table prefix and schema are already in use."
msgstr "Il database, il prefisso della tabella e lo schema sono già in uso."

#. Format arguments: {0}: "TrustServerCertificate=True"
#: Services/SetupService.cs
#, csharp-format
msgctxt "OrchardCore.Setup.Services.SetupService"
msgid "The security certificate on the server is from a non-trusted source (the certificate issuing authority isn't listed as a trusted authority in Trusted Root Certification Authorities on the client machine). In a development environment, you have the option to use the '{0}' parameter in your connection string to bypass the validation performed by the certificate authority."
msgstr "Il certificato di sicurezza sul server proviene da una sorgente non verificata (l'autorità che emana il certificato non è elencata come autorità affidabile in Trusted Root Certification Authorities sulla macchina client). In un ambiente di sviluppo, si ha l'opzione di usare il parametro '{0}' nella connection string per bypassare la validazione effettuata dalla certificate authority."

#: Services/SetupService.cs
msgctxt "OrchardCore.Setup.Services.SetupService"
msgid "Unexpected error occurred while importing the recipe."
msgstr "Si è verificato un errore imprevisto durante l'importazione della ricetta."

