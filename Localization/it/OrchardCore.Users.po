msgid "Use a script to set user roles, user claims and user properties based on external provider claims"
msgstr "Usa uno script per impostare ruoli utente, claims utente e proprietà utente basati sui claims di un provider esterno"

#: Views/ExternalLoginSettings.Edit.cshtml
msgctxt "OrchardCore.Users.Views.ExternalLoginSettings.Edit"
msgid "Use external provider for login."
msgstr "Usa provider esterno per l'accesso."

#: Views/ExternalRegistrationSettings.Edit.cshtml
msgctxt "OrchardCore.Users.Views.ExternalRegistrationSettings.Edit"
msgid "Configuring External Authentication for User Registration with Third-Party Providers"
msgstr "Configurazione autenticazione esterna per registrazione utente con provider di terze parti"

#: Views/ExternalRegistrationSettings.Edit.cshtml
msgctxt "OrchardCore.Users.Views.ExternalRegistrationSettings.Edit"
msgid "Disable new external registration"
msgstr "Disabilita nuova registrazione esterna"

#: Views/ExternalRegistrationSettings.Edit.cshtml
msgctxt "OrchardCore.Users.Views.ExternalRegistrationSettings.Edit"
msgid "Do not ask email address"
msgstr "Non chiedere indirizzo email"

#: Views/ExternalRegistrationSettings.Edit.cshtml
msgctxt "OrchardCore.Users.Views.ExternalRegistrationSettings.Edit"
msgid "Do not ask username"
msgstr "Non chiedere nome utente"

#: Views/ExternalRegistrationSettings.Edit.cshtml
msgctxt "OrchardCore.Users.Views.ExternalRegistrationSettings.Edit"
msgid "Do not create local password"
msgstr "Non creare una password locale"

#: Views/ExternalRegistrationSettings.Edit.cshtml
msgctxt "OrchardCore.Users.Views.ExternalRegistrationSettings.Edit"
msgid "If selected, any IExternalLoginEventHandlers defined in modules are not triggered"
msgstr "Se selezionato, qualsiasi IExternalLoginEventHandlers definito nei moduli non verranno attivati"

#: Views/ExternalRegistrationSettings.Edit.cshtml
msgctxt "OrchardCore.Users.Views.ExternalRegistrationSettings.Edit"
msgid "If selected, only users with existing local accounts will be able to authenticate, and new users will not be able to register using external authentication. Users without a local account will not be able to authenticate."
msgstr "Se selezionato, solo utenti con account locali esistenti saranno in grado di autenticarsi, e nuovi utenti non saranno in grado di registrarsi usando autenticazione esterna. Gli utenti senza un account locale non saranno in grado di autenticarsi."

#: Views/ExternalRegistrationSettings.Edit.cshtml
msgctxt "OrchardCore.Users.Views.ExternalRegistrationSettings.Edit"
msgid "Reset Script"
msgstr "Reimposta script"

#: Views/ExternalRegistrationSettings.Edit.cshtml
msgctxt "OrchardCore.Users.Views.ExternalRegistrationSettings.Edit"
msgid "Use a script to generate userName based on external provider claims"
msgstr "Usa uno script per generare un nome utente in base ai claims del provider esterno"

#: Views/ExternalRegistrationSettings.Edit.cshtml
msgctxt "OrchardCore.Users.Views.ExternalRegistrationSettings.Edit"
msgid "When a new user logs in with an external provider and the email claim is defined, they are not required to provide a local email address."
msgstr "Quando un nuovo utente accede con un provider esterno e la claim email è definita, non viene richiesto di fornire un indirizzo email."

#: Views/ExternalRegistrationSettings.Edit.cshtml
msgctxt "OrchardCore.Users.Views.ExternalRegistrationSettings.Edit"
msgid "When a new user logs in with an external provider, they are not required to provide a local password."
msgstr "Quando un nuovo utente accede con un provider esterno, non è richiesto di fornire una password locale."

#: Views/ExternalRegistrationSettings.Edit.cshtml
msgctxt "OrchardCore.Users.Views.ExternalRegistrationSettings.Edit"
msgid "When a new user logs in with an external provider, they are not required to provide a local username. You can customize how it works by providing an IExternalLoginEventHandler or writing a script."
msgstr "Quando un nuovo utente effettua l'accesso con un provider esterno, non gli verrà richiesto di fornire un nome utente locale. Puoi personalizzare il modo in cui funziona fornendo un IExternalLoginEventHandler o scrivendo uno script."

