msgstr "令牌上限必须大于零。"

#: Drivers/TokenBucketRateLimiterDisplayDriver.cs
msgctxt "OrchardCore.RateLimits.Drivers.TokenBucketRateLimiterDisplayDriver"
msgid "Tokens per period must be greater than zero."
msgstr "每周期令牌数必须大于零。"

#: Services/ConcurrencyRateLimiterSource.cs
msgctxt "OrchardCore.RateLimits.Services.ConcurrencyRateLimiterSource"
msgid "Concurrency"
msgstr "并发限制"

#: Services/ConcurrencyRateLimiterSource.cs
msgctxt "OrchardCore.RateLimits.Services.ConcurrencyRateLimiterSource"
msgid ""
"Limits how many matching requests can run at the same time, which is useful "
"for expensive operations."
msgstr "限制可同时运行的匹配请求数量，适用于高开销操作。"

#. Format arguments: {0}: model.PermitLimit; {1}: model.QueueLimit; {2}:
#. model.QueueProcessingOrder
#: Services/ConcurrencyRateLimiterSource.cs
#, csharp-format
msgctxt "OrchardCore.RateLimits.Services.ConcurrencyRateLimiterSource"
msgid "{0} concurrent requests, queue limit {1}, queue order {2}"
msgstr "同时处理 {0} 个请求，队列上限 {1}，队列处理顺序 {2}"

#: Services/FixedWindowRateLimiterSource.cs
msgctxt "OrchardCore.RateLimits.Services.FixedWindowRateLimiterSource"
msgid ""
"Allows a set number of requests during each time period, then resets the "
"count all at once."
msgstr "允许在每个时间段内处理固定数量的请求，然后一次性重置计数。"

#: Services/FixedWindowRateLimiterSource.cs
msgctxt "OrchardCore.RateLimits.Services.FixedWindowRateLimiterSource"
msgid "Fixed window"
msgstr "固定窗口"

#. Format arguments: {0}: model.PermitLimit; {1}: model.WindowSeconds; {2}:
#. model.QueueLimit
#: Services/FixedWindowRateLimiterSource.cs
#, csharp-format
msgctxt "OrchardCore.RateLimits.Services.FixedWindowRateLimiterSource"
msgid "{0} requests every {1} seconds, queue limit {2}"
msgstr "每 {1} 秒处理 {0} 个请求，队列上限 {2}"

#: Services/SlidingWindowRateLimiterSource.cs
msgctxt "OrchardCore.RateLimits.Services.SlidingWindowRateLimiterSource"
msgid "Sliding window"
msgstr "滑动窗口"

#: Services/SlidingWindowRateLimiterSource.cs
msgctxt "OrchardCore.RateLimits.Services.SlidingWindowRateLimiterSource"
msgid ""
"Spreads a request limit across a rolling time period so traffic is smoothed "
"instead of resetting all at once."
msgstr "将请求限制分布在滚动时间段内，使流量更加平滑，而不是一次性重置。"

#. Format arguments: {0}: model.PermitLimit; {1}: model.WindowSeconds; {2}:
#. model.SegmentsPerWindow; {3}: model.QueueLimit
#: Services/SlidingWindowRateLimiterSource.cs
#, csharp-format
msgctxt "OrchardCore.RateLimits.Services.SlidingWindowRateLimiterSource"
msgid "{0} requests every {1} seconds across {2} segments, queue limit {3}"
msgstr "每 {1} 秒处理 {0} 个请求，共分为 {2} 个分段，队列上限 {3}"

#: Services/TokenBucketRateLimiterSource.cs
msgctxt "OrchardCore.RateLimits.Services.TokenBucketRateLimiterSource"
msgid ""
"Allows short bursts of traffic while steadily refilling capacity over time."
msgstr "允许短时流量突发，同时随着时间推移持续补充容量。"

#: Services/TokenBucketRateLimiterSource.cs
msgctxt "OrchardCore.RateLimits.Services.TokenBucketRateLimiterSource"
msgid "Token bucket"
msgstr "令牌桶"

#. Format arguments: {0}: model.TokenLimit; {1}: model.TokensPerPeriod; {2}:
#. model.ReplenishmentPeriodSeconds; {3}: model.QueueLimit; {4}:
#. model.QueueProcessingOrder
#: Services/TokenBucketRateLimiterSource.cs
#, csharp-format
msgctxt "OrchardCore.RateLimits.Services.TokenBucketRateLimiterSource"
msgid ""
"{0} tokens, {1} replenished every {2} seconds, queue limit {3}, queue order "
"{4}"
msgstr "{0} 个令牌，每 {2} 秒补充 {1} 个令牌，队列上限 {3}，队列处理顺序 {4}"

