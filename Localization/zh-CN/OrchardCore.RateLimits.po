msgid "Oldest first (first come, first served)"
msgstr "最早请求优先（先到先得）"

#: Drivers/ConcurrencyRateLimiterDisplayDriver.cs
msgctxt "OrchardCore.RateLimits.Drivers.ConcurrencyRateLimiterDisplayDriver"
msgid "Permit limit must be greater than zero."
msgstr "许可上限必须大于零。"

#: Drivers/FixedWindowRateLimiterDisplayDriver.cs
msgctxt "OrchardCore.RateLimits.Drivers.FixedWindowRateLimiterDisplayDriver"
msgid "Permit limit must be greater than zero."
msgstr "许可上限必须大于零。"

#: Drivers/FixedWindowRateLimiterDisplayDriver.cs
msgctxt "OrchardCore.RateLimits.Drivers.FixedWindowRateLimiterDisplayDriver"
msgid "Window must be greater than zero."
msgstr "窗口时长必须大于零。"

#: Drivers/SlidingWindowRateLimiterDisplayDriver.cs
msgctxt "OrchardCore.RateLimits.Drivers.SlidingWindowRateLimiterDisplayDriver"
msgid "Permit limit must be greater than zero."
msgstr "许可上限必须大于零。"

#: Drivers/SlidingWindowRateLimiterDisplayDriver.cs
msgctxt "OrchardCore.RateLimits.Drivers.SlidingWindowRateLimiterDisplayDriver"
msgid "Segments per window must be greater than zero."
msgstr "每个窗口的分段数必须大于零。"

#: Drivers/SlidingWindowRateLimiterDisplayDriver.cs
msgctxt "OrchardCore.RateLimits.Drivers.SlidingWindowRateLimiterDisplayDriver"
msgid "Window must be greater than zero."
msgstr "窗口时长必须大于零。"

#: Drivers/TokenBucketRateLimiterDisplayDriver.cs
msgctxt "OrchardCore.RateLimits.Drivers.TokenBucketRateLimiterDisplayDriver"
msgid "Newest first (latest request first)"
msgstr "最新请求优先"

#: Drivers/TokenBucketRateLimiterDisplayDriver.cs
msgctxt "OrchardCore.RateLimits.Drivers.TokenBucketRateLimiterDisplayDriver"
msgid "Oldest first (first come, first served)"
msgstr "最早请求优先（先到先得）"

#: Drivers/TokenBucketRateLimiterDisplayDriver.cs
msgctxt "OrchardCore.RateLimits.Drivers.TokenBucketRateLimiterDisplayDriver"
