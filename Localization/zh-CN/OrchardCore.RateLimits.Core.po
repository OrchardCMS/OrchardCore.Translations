#: RateLimitsPermissions.cs
msgctxt "OrchardCore.RateLimits.Core.RateLimitsPermissions"
msgid "Manage Rate Limits"
msgstr "管理速率限制"

#: Recipes/CreateOrUpdateRateLimitPoliciesStep.cs
msgctxt "OrchardCore.RateLimits.Recipes.CreateOrUpdateRateLimitPoliciesStep"
msgid "The 'policies' array is required."
msgstr "必须提供 'policies' 数组。"

#. Format arguments: {0}: policy.Name ?? policy.PolicyId ?? string.Empty
#: Recipes/CreateOrUpdateRateLimitPoliciesStep.cs
#, csharp-format
msgctxt "OrchardCore.RateLimits.Recipes.CreateOrUpdateRateLimitPoliciesStep"
msgid "The endpoint policy '{0}' must define a request path."
msgstr "端点策略 '{0}' 必须定义请求路径。"

#. Format arguments: {0}: policy.Name ?? policy.PolicyId ?? string.Empty
#: Recipes/CreateOrUpdateRateLimitPoliciesStep.cs
#, csharp-format
msgctxt "OrchardCore.RateLimits.Recipes.CreateOrUpdateRateLimitPoliciesStep"
msgid ""
"The endpoint policy '{0}' must use a request path that starts with '/'."
msgstr "端点策略 '{0}' 使用的请求路径必须以 '/' 开头。"

#. Format arguments: {0}: policy.Name ?? policy.PolicyId ?? string.Empty
#: Recipes/CreateOrUpdateRateLimitPoliciesStep.cs
#, csharp-format
msgctxt "OrchardCore.RateLimits.Recipes.CreateOrUpdateRateLimitPoliciesStep"
msgid "The group policy '{0}' must define a rate-limit group."
msgstr "分组策略 '{0}' 必须定义速率限制分组。"

#. Format arguments: {0}: policy.Name ?? policy.PolicyId ?? string.Empty
#: Recipes/CreateOrUpdateRateLimitPoliciesStep.cs
#, csharp-format
msgctxt "OrchardCore.RateLimits.Recipes.CreateOrUpdateRateLimitPoliciesStep"
msgid "The policy '{0}' has an unsupported scope."
msgstr "策略 '{0}' 的作用域不受支持。"
