#. <label class="form-check-label" asp-for="RequireHttps">@T["Require
#. HTTPS"]</label>
#: OrchardCore.Https\Views\HttpsSettings.Edit.cshtml:8
msgctxt "OrchardCore.Https.Views.HttpsSettings.Edit"
msgid "Require HTTPS"
msgstr "需要 HTTPS"

#. <span class="hint dashed">@T["Require HTTPS for all requests"]</span>
#: OrchardCore.Https\Views\HttpsSettings.Edit.cshtml:9
msgctxt "OrchardCore.Https.Views.HttpsSettings.Edit"
msgid "Require HTTPS for all requests"
msgstr "要求所有请求使用 HTTPS"

#. <label class="form-check-label" asp-for="RequireHttpsPermanent">@T["Require
#. HTTPS Permanent"]</label>
#: OrchardCore.Https\Views\HttpsSettings.Edit.cshtml:26
msgctxt "OrchardCore.Https.Views.HttpsSettings.Edit"
msgid "Require HTTPS Permanent"
msgstr "需要 HTTPS 永久"

#. <span class="hint dashed">@T["Specifies whether a permanent redirect, 308
#. Moved Permanently, should be used instead of a temporary redirect, 307
#. Found, when redirecting to HTTPS"]</span>
#: OrchardCore.Https\Views\HttpsSettings.Edit.cshtml:27
msgctxt "OrchardCore.Https.Views.HttpsSettings.Edit"
msgid ""
"Specifies whether a permanent redirect, 308 Moved Permanently, should be "
"used instead of a temporary redirect, 307 Found, when redirecting to HTTPS"
msgstr "指定当重定向到 HTTPS 时, 是否应使用永久重定向, 而不是临时重新定向、307 Found。"

#. <label asp-for="SslPort">@T["SSL Port"]</label>
#: OrchardCore.Https\Views\HttpsSettings.Edit.cshtml:32
msgctxt "OrchardCore.Https.Views.HttpsSettings.Edit"
msgid "SSL Port"
msgstr "SSL 端口"

#. <span class="hint">@T["The SSL Port Number, leave empty to let the
#. middleware try to determinate it."]</span>
#: OrchardCore.Https\Views\HttpsSettings.Edit.cshtml:35
msgctxt "OrchardCore.Https.Views.HttpsSettings.Edit"
msgid ""
"The SSL Port Number, leave empty to let the middleware try to determinate "
"it."
msgstr "SSL 端口号, 留空让中间件尝试确定它。"

#: Drivers/HttpsSettingsDisplayDriver.cs
msgctxt "OrchardCore.Https.Drivers.HttpsSettingsDisplayDriver"
msgid "For safety, changing HTTPS-only settings over HTTP has been prevented."
msgstr "为了安全起见，已阻止通过 HTTP 更改仅限 HTTPS 的设置。"

#: Permissions.cs
msgctxt "OrchardCore.Https.Permissions"
msgid "Manage HTTPS"
msgstr "管理 HTTPS"

#: Views/HttpsSettings.Edit.cshtml
msgctxt "OrchardCore.Https.Views.HttpsSettings.Edit"
msgid ""
"Determines whether HTTP Strict Transport Security (HSTS) headers are "
"disabled by default, enabled explicitly, or follow the current environment."
msgstr "确定 HTTP 严格传输安全 (HSTS) 标头是默认禁用、明确启用，还是遵循当前环境。"

#: Views/HttpsSettings.Edit.cshtml
msgctxt "OrchardCore.Https.Views.HttpsSettings.Edit"
msgid "Disabled"
msgstr "禁用"

#: Views/HttpsSettings.Edit.cshtml
msgctxt "OrchardCore.Https.Views.HttpsSettings.Edit"
msgid "Enabled"
msgstr "启用"

#: Views/HttpsSettings.Edit.cshtml
msgctxt "OrchardCore.Https.Views.HttpsSettings.Edit"
msgid "From environment — enabled in Production, disabled otherwise"
msgstr "遵循环境 — 在 Production 中启用，否则禁用"

#: Views/HttpsSettings.Edit.cshtml
msgctxt "OrchardCore.Https.Views.HttpsSettings.Edit"
msgid "HSTS mode"
msgstr "HSTS 模式"

#: Views/HttpsSettings.Edit.cshtml
msgctxt "OrchardCore.Https.Views.HttpsSettings.Edit"
msgid ""
"Use HSTS with caution, as browsers may stop connecting over HTTP after "
"receiving the header if HTTPS later becomes unavailable."
msgstr "请谨慎使用 HSTS；如果收到该标头后 HTTPS 之后不可用，浏览器可能会停止通过 HTTP 进行连接。"
