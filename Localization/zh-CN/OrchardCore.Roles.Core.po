#: DefaultSystemRoleProvider.cs
msgctxt "OrchardCore.Roles.DefaultSystemRoleProvider"
msgid "A system role representing all authenticated users."
msgstr "表示所有已通过身份验证的用户的系统角色。"

#: DefaultSystemRoleProvider.cs
msgctxt "OrchardCore.Roles.DefaultSystemRoleProvider"
msgid "A system role representing all non-authenticated users."
msgstr "表示所有未通过身份验证的用户的系统角色。"

#: DefaultSystemRoleProvider.cs
msgctxt "OrchardCore.Roles.DefaultSystemRoleProvider"
msgid "A system role that grants all permissions to the assigned users."
msgstr "授予分配给其的用户所有权限的系统角色。"

#: RolesPermissions.cs
msgctxt "OrchardCore.Roles.RolesPermissions"
msgid "Manage Roles"
msgstr "管理角色"

#: RolesPermissions.cs
msgctxt "OrchardCore.Roles.RolesPermissions"
msgid "View Roles"
msgstr "查看角色"
