#. context.Errors.Add(String.Empty, S["DatabaseProvider setting is
#. required."]);
#: OrchardCore.Setup.Core\SetupService.cs:177
msgctxt "OrchardCore.Setup.Services.SetupService"
msgid "DatabaseProvider setting is required."
msgstr "需要 DatabaseProvider 设置。"

#. context.Errors.Add(String.Empty, S["The provided database provider is not
#. supported."]);
#: OrchardCore.Setup.Core\SetupService.cs:180
msgctxt "OrchardCore.Setup.Services.SetupService"
msgid "The provided database provider is not supported."
msgstr "提供的数据库提供程序不受支持。"

#. context.Errors.Add(String.Empty, S["The provided connection string is
#. invalid or server is unreachable."]);
#: OrchardCore.Setup.Core\SetupService.cs:183
msgctxt "OrchardCore.Setup.Services.SetupService"
msgid "The provided connection string is invalid or server is unreachable."
msgstr "提供的连接字符串无效或服务器无法访问。"

#: Services/SetupService.cs
msgctxt "OrchardCore.Setup.Services.SetupService"
msgid "An error occurred while initializing the datastore."
msgstr "初始化数据存储时发生错误。"

#: Services/SetupService.cs
msgctxt "OrchardCore.Setup.Services.SetupService"
msgid "The provided database, table prefix and schema are already in use."
msgstr "提供的数据库、表前缀和架构已被使用。"

#. Format arguments: {0}: "TrustServerCertificate=True"
#: Services/SetupService.cs
#, csharp-format
msgctxt "OrchardCore.Setup.Services.SetupService"
msgid ""
"The security certificate on the server is from a non-trusted source (the "
"certificate issuing authority isn't listed as a trusted authority in Trusted"
" Root Certification Authorities on the client machine). In a development "
"environment, you have the option to use the '{0}' parameter in your "
"connection string to bypass the validation performed by the certificate "
"authority."
msgstr ""
"服务器上的安全证书来自不受信任的来源（证书颁发机构未被列为客户端计算机“受信任的根证书颁发机构”中的受信任颁发机构）。在开发环境中，您可以在连接字符串中使用“{0}”参数绕过证书颁发机构执行的验证。"

#: Services/SetupService.cs
msgctxt "OrchardCore.Setup.Services.SetupService"
msgid "Unexpected error occurred while importing the recipe."
msgstr "导入配方时发生意外错误。"
