msgctxt "OrchardCore.Secrets.Controllers.MigrationController"
msgid ""
"Some credentials could not be moved. Their settings were left unchanged."
msgstr "部分凭据无法迁移，其设置保持不变。"

#: Controllers/StoreController.cs
msgctxt "OrchardCore.Secrets.Controllers.StoreController"
msgid "Confirm the operation before continuing."
msgstr "继续操作前请确认。"

