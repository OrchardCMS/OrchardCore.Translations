msgid_plural "{0} credentials were moved to secrets."
msgstr[0] "已将 {0} 个凭据迁移为机密。"

#: Controllers/MigrationController.cs
msgctxt "OrchardCore.Secrets.Controllers.MigrationController"
msgid "Select a writable secret store."
msgstr "请选择可写的机密存储。"

