#: Drivers/UploadToFtpStepDisplayDriver.cs
msgctxt "OrchardCore.DataPipelines.Ftp.Drivers.UploadToFtpStepDisplayDriver"
msgid "The port must be between 1 and 65535."
msgstr "端口必须介于 1 和 65535 之间。"

#: Drivers/UploadToFtpStepDisplayDriver.cs
msgctxt "OrchardCore.DataPipelines.Ftp.Drivers.UploadToFtpStepDisplayDriver"
msgid "The timeout must be at least one second."
msgstr "超时时间必须至少为 1 秒。"

#. Format arguments: {0}: host; {1}:
#. DataPipelineRemotePaths.Redact(ex.Message, password)
#: Steps/UploadToFtpStep.cs
#, csharp-format
msgctxt "OrchardCore.DataPipelines.Ftp.UploadToFtpStep"
msgid "Could not upload to the FTP server '{0}': {1}"
msgstr "无法上传到 FTP 服务器“{0}”：{1}"

#: Steps/UploadToFtpStep.cs
msgctxt "OrchardCore.DataPipelines.Ftp.UploadToFtpStep"
msgid "Enter the host of the FTP server."
msgstr "请输入 FTP 服务器的主机。"

#: Steps/UploadToFtpStep.cs
msgctxt "OrchardCore.DataPipelines.Ftp.UploadToFtpStep"
msgid "Enter the user name, such as anonymous for a public server."
msgstr "请输入用户名，例如公共服务器使用 anonymous。"

#. Format arguments: {0}: host
#: Steps/UploadToFtpStep.cs
#, csharp-format
msgctxt "OrchardCore.DataPipelines.Ftp.UploadToFtpStep"
msgid "The certificate of the FTP server '{0}' isn't validated."
msgstr "未验证 FTP 服务器“{0}”的证书。"

#: Steps/UploadToFtpStep.cs
msgctxt "OrchardCore.DataPipelines.Ftp.UploadToFtpStep"
msgid ""
"The connection isn't encrypted: the credentials and the files travel in "
"clear text."
msgstr "连接未加密：凭据和文件以明文传输。"

#. Format arguments: {0}: host
#: Steps/UploadToFtpStep.cs
#, csharp-format
msgctxt "OrchardCore.DataPipelines.Ftp.UploadToFtpStep"
msgid ""
"The connection to the FTP server '{0}' isn't encrypted: the credentials and "
"the files travel in clear text."
msgstr "与 FTP 服务器“{0}”的连接未加密：凭据和文件以明文传输。"

#. Format arguments: {0}: remotePath; {1}: host
#: Steps/UploadToFtpStep.cs
#, csharp-format
msgctxt "OrchardCore.DataPipelines.Ftp.UploadToFtpStep"
msgid ""
"The file '{0}' already exists on the FTP server '{1}', and the step doesn't "
"overwrite files."
msgstr "FTP 服务器“{1}”上已存在文件“{0}”，且此步骤不会覆盖文件。"

#. Format arguments: {0}: settings.Host
#: Steps/UploadToFtpStep.cs
#, csharp-format
msgctxt "OrchardCore.DataPipelines.Ftp.UploadToFtpStep"
msgid "The host '{0}' isn't a valid host name or IP address."
msgstr "主机“{0}”不是有效的主机名或 IP 地址。"

#: Steps/UploadToFtpStep.cs
msgctxt "OrchardCore.DataPipelines.Ftp.UploadToFtpStep"
msgid ""
"The password can't be read on this site, such as when its data protection "
"keys changed: enter it again."
msgstr "无法读取此站点上的密码，例如数据保护密钥已更改：请重新输入。"

#: Steps/UploadToFtpStep.cs
msgctxt "OrchardCore.DataPipelines.Ftp.UploadToFtpStep"
msgid "The port must be between 1 and 65535."
msgstr "端口必须介于 1 和 65535 之间。"

#: Steps/UploadToFtpStep.cs
msgctxt "OrchardCore.DataPipelines.Ftp.UploadToFtpStep"
msgid "The timeout must be at least one second."
msgstr "超时时间必须至少为 1 秒。"

#: Steps/UploadToFtpStep.cs
msgctxt "OrchardCore.DataPipelines.Ftp.UploadToFtpStep"
msgid "Upload to an FTP server"
msgstr "上传到 FTP 服务器"

#. Format arguments: {0}: fileName; {1}:
#. DataPipelineRemotePaths.ToDisplayUrl(scheme, host, settings.Port,
#. remotePath)
#: Steps/UploadToFtpStep.cs
#, csharp-format
msgctxt "OrchardCore.DataPipelines.Ftp.UploadToFtpStep"
msgid "Uploaded '{0}' to {1}"
msgstr "已将“{0}”上传到 {1}"

#: Steps/UploadToFtpStep.cs
msgctxt "OrchardCore.DataPipelines.Ftp.UploadToFtpStep"
msgid "Uploads files to a folder of an FTP server."
msgstr "将文件上传到 FTP 服务器上的某个文件夹。"

#: Views/UploadToFtp.Fields.Design.cshtml
msgctxt "OrchardCore.DataPipelines.Ftp.Views.UploadToFtp.Fields.Design"
msgid "Not encrypted"
msgstr "未加密"

#: Views/UploadToFtp.Fields.Edit.cshtml
msgctxt "OrchardCore.DataPipelines.Ftp.Views.UploadToFtp.Fields.Edit"
msgid ""
"Clear it only for a server with a self-signed certificate on a trusted "
"network."
msgstr "仅当服务器使用自签名证书且位于受信任网络中时，才清除该选项。"

#. Format arguments: {0}: "{PipelineName}"; {1}: "{RunId}"; {2}:
#. "{Date:format}"
#: Views/UploadToFtp.Fields.Edit.cshtml
#, csharp-format
msgctxt "OrchardCore.DataPipelines.Ftp.Views.UploadToFtp.Fields.Edit"
msgid ""
"Created when it doesn't exist. Empty for the folder the user starts in. "
"Placeholders: {0}, {1}, and {2}."
msgstr "不存在时自动创建；为空时使用用户的起始文件夹。占位符：{0}、{1} 和 {2}。"

#: Views/UploadToFtp.Fields.Edit.cshtml
msgctxt "OrchardCore.DataPipelines.Ftp.Views.UploadToFtp.Fields.Edit"
msgid "Encryption"
msgstr "加密"

#: Views/UploadToFtp.Fields.Edit.cshtml
msgctxt "OrchardCore.DataPipelines.Ftp.Views.UploadToFtp.Fields.Edit"
msgid "Explicit TLS (FTPES)"
msgstr "显式 TLS (FTPES)"

#: Views/UploadToFtp.Fields.Edit.cshtml
msgctxt "OrchardCore.DataPipelines.Ftp.Views.UploadToFtp.Fields.Edit"
msgid "Host"
msgstr "主机"

#: Views/UploadToFtp.Fields.Edit.cshtml
msgctxt "OrchardCore.DataPipelines.Ftp.Views.UploadToFtp.Fields.Edit"
msgid "Implicit TLS (FTPS)"
msgstr "隐式 TLS (FTPS)"

#: Views/UploadToFtp.Fields.Edit.cshtml
msgctxt "OrchardCore.DataPipelines.Ftp.Views.UploadToFtp.Fields.Edit"
msgid "Leave empty to keep the current password."
msgstr "留空以保留当前密码。"

#: Views/UploadToFtp.Fields.Edit.cshtml
msgctxt "OrchardCore.DataPipelines.Ftp.Views.UploadToFtp.Fields.Edit"
msgid "None (plain FTP)"
msgstr "无（普通 FTP）"

#: Views/UploadToFtp.Fields.Edit.cshtml
msgctxt "OrchardCore.DataPipelines.Ftp.Views.UploadToFtp.Fields.Edit"
msgid "Otherwise the step fails when a file with the same name exists."
msgstr "否则，当存在同名文件时，此步骤将失败。"

#: Views/UploadToFtp.Fields.Edit.cshtml
msgctxt "OrchardCore.DataPipelines.Ftp.Views.UploadToFtp.Fields.Edit"
msgid "Password"
msgstr "密码"

#: Views/UploadToFtp.Fields.Edit.cshtml
msgctxt "OrchardCore.DataPipelines.Ftp.Views.UploadToFtp.Fields.Edit"
msgid ""
"Plain FTP isn't encrypted: the user name, the password and the files travel "
"in clear text."
msgstr "普通 FTP 未加密：用户名、密码和文件以明文传输。"

#: Views/UploadToFtp.Fields.Edit.cshtml
msgctxt "OrchardCore.DataPipelines.Ftp.Views.UploadToFtp.Fields.Edit"
msgid "Port"
msgstr "端口"

#: Views/UploadToFtp.Fields.Edit.cshtml
msgctxt "OrchardCore.DataPipelines.Ftp.Views.UploadToFtp.Fields.Edit"
msgid "Remote folder"
msgstr "远程文件夹"

#: Views/UploadToFtp.Fields.Edit.cshtml
msgctxt "OrchardCore.DataPipelines.Ftp.Views.UploadToFtp.Fields.Edit"
msgid "Remove the password"
msgstr "移除密码"

#: Views/UploadToFtp.Fields.Edit.cshtml
msgctxt "OrchardCore.DataPipelines.Ftp.Views.UploadToFtp.Fields.Edit"
msgid "Replace existing files"
msgstr "替换现有文件"

#: Views/UploadToFtp.Fields.Edit.cshtml
msgctxt "OrchardCore.DataPipelines.Ftp.Views.UploadToFtp.Fields.Edit"
msgid "Timeout (seconds)"
msgstr "超时（秒）"

#: Views/UploadToFtp.Fields.Edit.cshtml
msgctxt "OrchardCore.DataPipelines.Ftp.Views.UploadToFtp.Fields.Edit"
msgid "User name"
msgstr "用户名"

#: Views/UploadToFtp.Fields.Edit.cshtml
msgctxt "OrchardCore.DataPipelines.Ftp.Views.UploadToFtp.Fields.Edit"
msgid "Usually 21, or 990 for implicit TLS."
msgstr "通常为 21；隐式 TLS 通常使用 990。"

#: Views/UploadToFtp.Fields.Edit.cshtml
msgctxt "OrchardCore.DataPipelines.Ftp.Views.UploadToFtp.Fields.Edit"
msgid "Validate the certificate of the server"
msgstr "验证服务器证书"
