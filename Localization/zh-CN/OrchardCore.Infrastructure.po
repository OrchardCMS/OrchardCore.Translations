#. throw new Exception(S["Multiple commands found matching arguments \"{0}\".
#. Commands available: {1}.",
#: OrchardCore.Infrastructure\Commands\DefaultCommandManager.cs:38
msgctxt "OrchardCore.Environment.Commands.DefaultCommandManager"
msgid ""
"Multiple commands found matching arguments \"{0}\". Commands available: {1}."
msgstr "多个命令找到匹配参数“{0}”。可用的命令: {1}。"

#. throw new Exception(S["No command found matching arguments \"{0}\".
#. Commands available: {1}.",
#: OrchardCore.Infrastructure\Commands\DefaultCommandManager.cs:41
msgctxt "OrchardCore.Environment.Commands.DefaultCommandManager"
msgid "No command found matching arguments \"{0}\". Commands available: {1}."
msgstr "没有找到匹配参数“{0}”。命令可用： {1}。"

#. await Context.Output.WriteLineAsync(S["List of available commands:"]);
#: OrchardCore.Infrastructure\Commands\Builtin\HelpCommand.cs:25
msgctxt "OrchardCore.Environment.Commands.Builtin.HelpCommand"
msgid "List of available commands:"
msgstr "可用命令列表："

#. await Context.Output.WriteLineAsync(S["Command {0} doesn't exist",
#. command]);
#: OrchardCore.Infrastructure\Commands\Builtin\HelpCommand.cs:49
msgctxt "OrchardCore.Environment.Commands.Builtin.HelpCommand"
msgid "Command {0} doesn't exist"
msgstr "命令 {0} 不存在"

#. return S["{0}.{1}: no help text",
#. descriptor.MethodInfo.DeclaringType?.FullName, descriptor.MethodInfo.Name];
#: OrchardCore.Infrastructure\Commands\Builtin\HelpCommand.cs:70
msgctxt "OrchardCore.Environment.Commands.Builtin.HelpCommand"
msgid "{0}.{1}: no help text"
msgstr "{0}.{1}: 没有帮助文本"

#: ErrorHandling/ApiProblemDetailsMiddleware.cs
msgctxt "OrchardCore.Infrastructure.ErrorHandling.ApiProblemDetailsMiddleware"
msgid "Access forbidden"
msgstr "禁止访问"

#: ErrorHandling/ApiProblemDetailsMiddleware.cs
msgctxt "OrchardCore.Infrastructure.ErrorHandling.ApiProblemDetailsMiddleware"
msgid ""
"Access to this resource is forbidden or you do not have sufficient "
"permissions to perform this action."
msgstr "此资源禁止访问，或者您没有足够的权限执行此操作。"

#: ErrorHandling/ApiProblemDetailsMiddleware.cs
msgctxt "OrchardCore.Infrastructure.ErrorHandling.ApiProblemDetailsMiddleware"
msgid ""
"Authentication is required to access this resource. Additional details may "
"be found in the WWW-Authenticate HTTP response header."
msgstr "访问此资源需要身份验证。有关其他详细信息，请参阅 WWW-Authenticate HTTP 响应标头。"

#: ErrorHandling/ApiProblemDetailsMiddleware.cs
msgctxt "OrchardCore.Infrastructure.ErrorHandling.ApiProblemDetailsMiddleware"
msgid "Authentication required"
msgstr "需要身份验证"
