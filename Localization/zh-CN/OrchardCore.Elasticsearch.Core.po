#: Handlers/ElasticsearchIndexProfileHandler.cs
msgctxt ""
"OrchardCore.Elasticsearch.Core.Handlers.ElasticsearchIndexProfileHandler"
msgid ""
"Invalid index name: it must be lowercase, under 255 bytes, not start with -,"
" _, or +, and must not contain , /, *, ?, \", <, >, |, space, ,, or #, nor "
"be \".\" or \"..\"."
msgstr ""
"索引名称无效：必须为小写且长度不得超过 255 字节，不得以 -、_ 或 + 开头，不得包含 "
",、/、*、?、\"、<、>、|、空格、#，也不能是“.”或“..”。"

