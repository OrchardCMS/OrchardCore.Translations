#: Shell/Removing/ShellRemovalManager.cs
msgctxt "OrchardCore.Environment.Shell.Removing.ShellRemovalManager"
msgid "Failed to acquire a lock before executing the host handlers."
msgstr "Απέτυχε η απόκτηση κλειδώματος πριν από την εκτέλεση των κεντρικών χειριστών."

#: Shell/Removing/ShellRemovalManager.cs
msgctxt "OrchardCore.Environment.Shell.Removing.ShellRemovalManager"
msgid "Failed to acquire a lock before executing the tenant handlers."
msgstr "Απέτυχε η απόκτηση κλειδώματος πριν από την εκτέλεση των χειριστών ενοικιαστών."

#: Shell/Removing/ShellRemovalManager.cs
msgctxt "OrchardCore.Environment.Shell.Removing.ShellRemovalManager"
msgid "Failed to create a 'ShellContext' before removing the tenant."
msgstr "Αποτυχία δημιουργίας \"ShellContext\" πριν από την κατάργηση του ενοικιαστή."

#. Format arguments: {0}: type
#: Shell/Removing/ShellRemovalManager.cs
#, csharp-format
msgctxt "OrchardCore.Environment.Shell.Removing.ShellRemovalManager"
msgid "Failed to execute the host handler '{0}'."
msgstr "Απέτυχε η εκτέλεση του προγράμματος χειρισμού κεντρικού υπολογιστή \"{0}\"."

#. Format arguments: {0}: type
#: Shell/Removing/ShellRemovalManager.cs
#, csharp-format
msgctxt "OrchardCore.Environment.Shell.Removing.ShellRemovalManager"
msgid "Failed to execute the tenant handler '{0}'."
msgstr "Απέτυχε η εκτέλεση του προγράμματος χειρισμού ενοικιαστή \"{0}\"."

#. Format arguments: {0}: shellSettings.Name
#: Shell/Removing/ShellRemovalManager.cs
#, csharp-format
msgctxt "OrchardCore.Environment.Shell.Removing.ShellRemovalManager"
msgid "The tenant '{0}' should be 'Disabled' or 'Uninitialized'."
msgstr "Ο ενοικιαστής \"{0}\" θα πρέπει να είναι \"Απενεργοποιημένος\" ή \"Μη αρχικοποιημένος\"."

#. Format arguments: {0}: ShellSettings.DefaultShellName
#: Shell/Removing/ShellRemovalManager.cs
#, csharp-format
msgctxt "OrchardCore.Environment.Shell.Removing.ShellRemovalManager"
msgid "The tenant should not be the '{0}' tenant."
msgstr "Ο ενοικιαστής δεν πρέπει να είναι ο ενοικιαστής \"{0}\"."

#: Shell/Removing/ShellSettingsRemovingHandler.cs
msgctxt "OrchardCore.Environment.Shell.Removing.ShellSettingsRemovingHandler"
