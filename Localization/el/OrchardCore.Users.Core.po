msgid "Email '{0}' is already used."
msgstr "Το email \"{0}\" χρησιμοποιείται ήδη."

#. Format arguments: {0}: user.Email
#: Services/UserService.cs
#, csharp-format
msgctxt "OrchardCore.Users.Services.UserService"
msgid "Email '{0}' is invalid."
msgstr "Η διεύθυνση ηλεκτρονικού ταχυδρομείου '{0}' δεν είναι έγκυρη."

#: Services/UserService.cs
msgctxt "OrchardCore.Users.Services.UserService"
msgid "Incorrect password."
msgstr "Λανθασμένος κωδικός πρόσβασης."

#: Services/UserService.cs
msgctxt "OrchardCore.Users.Services.UserService"
msgid "Local login is disabled."
msgstr ""

#. Format arguments: {0}: _identityOptions.Password.RequiredLength
#: Services/UserService.cs
#, csharp-format
msgctxt "OrchardCore.Users.Services.UserService"
msgid "Passwords must be at least {0} characters."
msgstr "Οι κωδικοί πρόσβασης πρέπει να είναι τουλάχιστον {0} χαρακτήρες."

#. Format arguments: {0}: _identityOptions.Password.RequiredUniqueChars
#: Services/UserService.cs
#, csharp-format
msgctxt "OrchardCore.Users.Services.UserService"
msgid "Passwords must contain at least {0} unique characters."
msgstr "Οι κωδικοί πρόσβασης πρέπει να περιέχουν τουλάχιστον {0} μοναδικούς χαρακτήρες."

#: Services/UserService.cs
msgctxt "OrchardCore.Users.Services.UserService"
msgid "Passwords must have at least one digit character ('0'-'9')."
msgstr "Οι κωδικοί πρόσβασης πρέπει να έχουν τουλάχιστον ένα ψηφίο χαρακτήρα ('0' - '9')."

#: Services/UserService.cs
msgctxt "OrchardCore.Users.Services.UserService"
msgid "Passwords must have at least one lowercase character ('a'-'z')."
msgstr "Οι κωδικοί πρόσβασης πρέπει να έχουν τουλάχιστον έναν πεζά χαρακτήρα ('a' - 'z')."

#: Services/UserService.cs
msgctxt "OrchardCore.Users.Services.UserService"
msgid "Passwords must have at least one non letter or digit character."
msgstr "Οι κωδικοί πρόσβασης πρέπει να έχουν τουλάχιστον ένα χαρακτήρα που να μην είναι γράμμα ή ψηφίο."

#: Services/UserService.cs
msgctxt "OrchardCore.Users.Services.UserService"
msgid "Passwords must have at least one uppercase character ('A'-'Z')."
msgstr "Οι κωδικοί πρόσβασης πρέπει να έχουν τουλάχιστον ένα κεφαλαίο χαρακτήρα ('A' - 'Z')."

#: Services/UserService.cs
msgctxt "OrchardCore.Users.Services.UserService"
msgid "The reset token is invalid. Please request a new token."
msgstr ""

#: Services/UserService.cs
msgctxt "OrchardCore.Users.Services.UserService"
msgid "The specified user is not allowed to sign in using password authentication."
msgstr "Ο συγκεκριμένος χρήστης δεν επιτρέπεται να πραγματοποιεί είσοδο χρησιμοποιώντας έλεγχο ταυτότητας με κωδικό πρόσβασης."

#: Services/UserService.cs
msgctxt "OrchardCore.Users.Services.UserService"
msgid "The specified user is not allowed to sign in."
msgstr "Ο συγκεκριμένος χρήστης δεν επιτρέπεται να συνδεθεί."

#: Services/UserService.cs
msgctxt "OrchardCore.Users.Services.UserService"
msgid "The specified username/password couple is invalid."
msgstr "Το συγκεκριμένο ζεύγος ονόματος χρήστη / κωδικού πρόσβασης δεν είναι έγκυρο."

#: Services/UserService.cs
msgctxt "OrchardCore.Users.Services.UserService"
msgid "The user is locked out."
msgstr ""

