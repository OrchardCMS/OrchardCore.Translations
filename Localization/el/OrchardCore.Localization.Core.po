msgid "'{0}' and '{1}' do not match."
msgstr "'{0}' και '{1}' δεν ταιριάζουν."

#: DataAnnotations/DataAnnotationsDefaultErrorMessages.cs
msgctxt "OrchardCore.Localization.DataAnnotations.DataAnnotationsDefaultErrorMessages"
msgid "Both ErrorMessageResourceType and ErrorMessageResourceName need to be set on this attribute."
msgstr "Τόσο το ErrorMessageResourceType όσο και το ErrorMessageResourceName πρέπει να οριστούν σε αυτό το χαρακτηριστικό."

#. Format arguments: {0}; {1}; {2}
#: DataAnnotations/DataAnnotationsDefaultErrorMessages.cs
#, csharp-format
msgctxt "OrchardCore.Localization.DataAnnotations.DataAnnotationsDefaultErrorMessages"
msgid "Cannot retrieve property '{0}' because localization failed.  Type '{1}' is not public or does not contain a public static string property with the name '{2}'."
msgstr "Δεν είναι δυνατή η ανάκτηση της ιδιότητας \"{0}\" επειδή η τοπικοποίηση απέτυχε. Ο τύπος '{1}' δεν είναι δημόσιος ή δεν περιέχει μια δημόσια ιδιότητα στατικής συμβολοσειράς με το όνομα '{2}'."

#. Format arguments: {0}; {1}; {2}; {3}
#: DataAnnotations/DataAnnotationsDefaultErrorMessages.cs
#, csharp-format
msgctxt "OrchardCore.Localization.DataAnnotations.DataAnnotationsDefaultErrorMessages"
msgid "Could not convert the value of type '{0}' to '{1}' as expected by method {2}.{3}."
msgstr "Δεν ήταν δυνατή η μετατροπή της τιμής του τύπου \"{0}\" σε \"{1}\" όπως αναμενόταν με τη μέθοδο {2}. {3}."

#. Format arguments: {0}
#: DataAnnotations/DataAnnotationsDefaultErrorMessages.cs
#, csharp-format
msgctxt "OrchardCore.Localization.DataAnnotations.DataAnnotationsDefaultErrorMessages"
msgid "Could not find a property named {0}."
msgstr "Δεν ήταν δυνατή η εύρεση μιας ιδιότητας με όνομα {0}."

#: DataAnnotations/DataAnnotationsDefaultErrorMessages.cs
msgctxt "OrchardCore.Localization.DataAnnotations.DataAnnotationsDefaultErrorMessages"
msgid "Either ErrorMessageString or ErrorMessageResourceName must be set, but not both."
msgstr "Πρέπει να οριστεί είτε το ErrorMessageString είτε το ErrorMessageResourceName, αλλά όχι και τα δύο."

#: DataAnnotations/DataAnnotationsDefaultErrorMessages.cs
msgctxt "OrchardCore.Localization.DataAnnotations.DataAnnotationsDefaultErrorMessages"
msgid "IsValid(object value) has not been implemented by this class. The preferred entry point is GetValidationResult() and classes should override IsValid(object value, ValidationContext context)."
msgstr "Το IsValid(object value) δεν έχει εφαρμοστεί από αυτήν την κλάση. Το προτιμώμενο σημείο εισόδου είναι το GetValidationResult() και οι κλάσεις θα πρέπει να αντικαταστήσουν το IsValid(object value, ValidationContext context)."

#: DataAnnotations/DataAnnotationsDefaultErrorMessages.cs
msgctxt "OrchardCore.Localization.DataAnnotations.DataAnnotationsDefaultErrorMessages"
msgid "MaxLengthAttribute must have a Length value that is greater than zero. Use MaxLength() without parameters to indicate that the string or array can have the maximum allowable length."
msgstr "Το MaxLengthAttribute πρέπει να έχει τιμή μήκους μεγαλύτερη από το μηδέν. Χρησιμοποιήστε το MaxLength() χωρίς παραμέτρους για να υποδείξετε ότι η συμβολοσειρά ή ο πίνακας μπορεί να έχει το μέγιστο επιτρεπόμενο μήκος."

#: DataAnnotations/DataAnnotationsDefaultErrorMessages.cs
msgctxt "OrchardCore.Localization.DataAnnotations.DataAnnotationsDefaultErrorMessages"
msgid "MetadataClassType cannot be null."
msgstr "Το MetadataClassType δεν μπορεί να είναι null."

#: DataAnnotations/DataAnnotationsDefaultErrorMessages.cs
msgctxt "OrchardCore.Localization.DataAnnotations.DataAnnotationsDefaultErrorMessages"
msgid "MinLengthAttribute must have a Length value that is zero or greater."
msgstr "Το MinLengthAttribute πρέπει να έχει τιμή μήκους που είναι μηδέν ή μεγαλύτερη."

#. Format arguments: {0}; {1}
#: DataAnnotations/DataAnnotationsDefaultErrorMessages.cs
#, csharp-format
msgctxt "OrchardCore.Localization.DataAnnotations.DataAnnotationsDefaultErrorMessages"
msgid "The CustomValidationAttribute method '{0}' does not exist in type '{1}' or is not public and static."
msgstr "Η μέθοδος CustomValidationAttribute \"{0}\" δεν υπάρχει στον τύπο \"{1}\" ή δεν είναι δημόσια και στατική."

#. Format arguments: {0}; {1}
#: DataAnnotations/DataAnnotationsDefaultErrorMessages.cs
#, csharp-format
msgctxt "OrchardCore.Localization.DataAnnotations.DataAnnotationsDefaultErrorMessages"
msgid "The CustomValidationAttribute method '{0}' in type '{1}' must match the expected signature: public static ValidationResult {0}(object value, ValidationContext context). The value can be strongly typed. The ValidationContext parameter is optional."
msgstr "Η μέθοδος CustomValidationAttribute \"{0}\" στον τύπο \"{1}\" πρέπει να ταιριάζει με την αναμενόμενη υπογραφή: public static ValidationResult {0} (object value, ValidationContext context). Η τιμή μπορεί να εισαχθεί υποχρεωτικά. Η παράμετρος ValidationContext είναι προαιρετική."

#. Format arguments: {0}; {1}
#: DataAnnotations/DataAnnotationsDefaultErrorMessages.cs
#, csharp-format
msgctxt "OrchardCore.Localization.DataAnnotations.DataAnnotationsDefaultErrorMessages"
msgid "The CustomValidationAttribute method '{0}' in type '{1}' must return System.ComponentModel.DataAnnotations.ValidationResult.  Use System.ComponentModel.DataAnnotations.ValidationResult.Success to represent success."
msgstr "Η μέθοδος CustomValidationAttribute \"{0}\" στον τύπο \"{1}\" πρέπει να επιστρέψει το System.ComponentModel.DataAnnotations.ValidationResult. Χρησιμοποίησε το System.ComponentModel.DataAnnotations.ValidationResult.Success για να παραστήσεις την επιτυχία."

#: DataAnnotations/DataAnnotationsDefaultErrorMessages.cs
msgctxt "OrchardCore.Localization.DataAnnotations.DataAnnotationsDefaultErrorMessages"
msgid "The CustomValidationAttribute.Method was not specified."
msgstr "Το CustomValidationAttribute.Method δεν καθορίστηκε."

#: DataAnnotations/DataAnnotationsDefaultErrorMessages.cs
msgctxt "OrchardCore.Localization.DataAnnotations.DataAnnotationsDefaultErrorMessages"
msgid "The CustomValidationAttribute.ValidatorType was not specified."
msgstr "Το CustomValidationAttribute.ValidatorType δεν καθορίστηκε."

#: DataAnnotations/DataAnnotationsDefaultErrorMessages.cs
msgctxt "OrchardCore.Localization.DataAnnotations.DataAnnotationsDefaultErrorMessages"
msgid "The OperandType must be set when strings are used for minimum and maximum values."
msgstr "Το OperandType πρέπει να οριστεί όταν χρησιμοποιούνται συμβολοσειρές για ελάχιστες και μέγιστες τιμές."

#. Format arguments: {0}; {1}
#: DataAnnotations/DataAnnotationsDefaultErrorMessages.cs
#, csharp-format
msgctxt "OrchardCore.Localization.DataAnnotations.DataAnnotationsDefaultErrorMessages"
msgid "The associated metadata type for type '{0}' contains the following unknown properties or fields: {1}. Please make sure that the names of these members match the names of the properties on the main type."
msgstr "Ο συσχετισμένος τύπος μεταδεδομένων για τον τύπο \"{0}\" περιέχει τις ακόλουθες άγνωστες ιδιότητες ή πεδία: {1}. Βεβαιωθείτε ότι τα ονόματα αυτών των μελών ταιριάζουν με τα ονόματα των ιδιοτήτων στον κύριο τύπο."

#: DataAnnotations/DataAnnotationsDefaultErrorMessages.cs
msgctxt "OrchardCore.Localization.DataAnnotations.DataAnnotationsDefaultErrorMessages"
msgid "The custom DataType string cannot be null or empty."
msgstr "Η προσαρμοσμένη συμβολοσειρά DataType δεν μπορεί να είναι null ή κενή."

#. Format arguments: {0}
#: DataAnnotations/DataAnnotationsDefaultErrorMessages.cs
#, csharp-format
msgctxt "OrchardCore.Localization.DataAnnotations.DataAnnotationsDefaultErrorMessages"
msgid "The custom validation type '{0}' must be public."
msgstr "Ο προσαρμοσμένος τύπος επικύρωσης \"{0}\" πρέπει να είναι δημόσιος."

#. Format arguments: {0}
#: DataAnnotations/DataAnnotationsDefaultErrorMessages.cs
#, csharp-format
msgctxt "OrchardCore.Localization.DataAnnotations.DataAnnotationsDefaultErrorMessages"
msgid "The field of type {0} must be a string, array or ICollection type."
msgstr "Το πεδίο τύπου {0} πρέπει να είναι συμβολοσειρά, πίνακας ή τύπος ICollection."

#. Format arguments: {0}
#: DataAnnotations/DataAnnotationsDefaultErrorMessages.cs
#, csharp-format
msgctxt "OrchardCore.Localization.DataAnnotations.DataAnnotationsDefaultErrorMessages"
msgid "The field {0} is invalid."
msgstr "Το πεδίο {0} δεν είναι έγκυρο."

#. Format arguments: {0}; {1}
#: DataAnnotations/DataAnnotationsDefaultErrorMessages.cs
#, csharp-format
msgctxt "OrchardCore.Localization.DataAnnotations.DataAnnotationsDefaultErrorMessages"
msgid "The field {0} must be a string or array type with a maximum length of '{1}'."
msgstr "Το πεδίο {0} πρέπει να είναι συμβολοσειρά ή τύπος πίνακα με μέγιστο μήκος \"{1}\"."

#. Format arguments: {0}; {1}
#: DataAnnotations/DataAnnotationsDefaultErrorMessages.cs
#, csharp-format
msgctxt "OrchardCore.Localization.DataAnnotations.DataAnnotationsDefaultErrorMessages"
msgid "The field {0} must be a string or array type with a minimum length of '{1}'."
msgstr "Το πεδίο {0} πρέπει να είναι συμβολοσειρά ή τύπος πίνακα με ελάχιστο μήκος \"{1}\"."

#. Format arguments: {0}; {1}
#: DataAnnotations/DataAnnotationsDefaultErrorMessages.cs
#, csharp-format
msgctxt "OrchardCore.Localization.DataAnnotations.DataAnnotationsDefaultErrorMessages"
msgid "The field {0} must be a string with a maximum length of {1}."
msgstr "Το πεδίο {0} πρέπει να είναι συμβολοσειρά με μέγιστο μήκος {1}."

#. Format arguments: {0}; {1}; {2}
#: DataAnnotations/DataAnnotationsDefaultErrorMessages.cs
#, csharp-format
msgctxt "OrchardCore.Localization.DataAnnotations.DataAnnotationsDefaultErrorMessages"
msgid "The field {0} must be a string with a minimum length of {2} and a maximum length of {1}."
msgstr "Το πεδίο {0} πρέπει να είναι συμβολοσειρά με ελάχιστο μήκος {2} και μέγιστο μήκος {1}."

#. Format arguments: {0}; {1}; {2}
#: DataAnnotations/DataAnnotationsDefaultErrorMessages.cs
#, csharp-format
msgctxt "OrchardCore.Localization.DataAnnotations.DataAnnotationsDefaultErrorMessages"
msgid "The field {0} must be between {1} and {2}."
msgstr "Το πεδίο {0} πρέπει να είναι μεταξύ {1} και {2}."

#. Format arguments: {0}; {1}
#: DataAnnotations/DataAnnotationsDefaultErrorMessages.cs
#, csharp-format
msgctxt "OrchardCore.Localization.DataAnnotations.DataAnnotationsDefaultErrorMessages"
msgid "The field {0} must match the regular expression '{1}'."
msgstr "Το πεδίο {0} πρέπει να αντιστοιχεί στην τακτική έκφραση \"{1}\"."

#: DataAnnotations/DataAnnotationsDefaultErrorMessages.cs
msgctxt "OrchardCore.Localization.DataAnnotations.DataAnnotationsDefaultErrorMessages"
msgid "The instance provided must match the ObjectInstance on the ValidationContext supplied."
msgstr "Η υπόδειξη που παρέχεται πρέπει να ταιριάζει με το ObjectInstance στο παρεχόμενο κείμενο ValidationContext."

#. Format arguments: {0}
#: DataAnnotations/DataAnnotationsDefaultErrorMessages.cs
#, csharp-format
msgctxt "OrchardCore.Localization.DataAnnotations.DataAnnotationsDefaultErrorMessages"
msgid "The key parameter at position {0} is null. Every key control parameter must be a string."
msgstr "Η παράμετρος του κλειδιού στη θέση {0} είναι null. Κάθε παράμετρος ελέγχου κλειδιού πρέπει να είναι string."

#. Format arguments: {0}; {1}
#: DataAnnotations/DataAnnotationsDefaultErrorMessages.cs
#, csharp-format
msgctxt "OrchardCore.Localization.DataAnnotations.DataAnnotationsDefaultErrorMessages"
msgid "The key parameter at position {0} with value '{1}' is not a string. Every key control parameter must be a string."
msgstr "Η παράμετρος του κλειδιού στη θέση {0} με την τιμή \"{1}\" δεν είναι string. Κάθε παράμετρος ελέγχου κλειδιού πρέπει να είναι string."

#. Format arguments: {0}; {1}
#: DataAnnotations/DataAnnotationsDefaultErrorMessages.cs
#, csharp-format
msgctxt "OrchardCore.Localization.DataAnnotations.DataAnnotationsDefaultErrorMessages"
msgid "The key parameter at position {0} with value '{1}' occurs more than once."
msgstr "Η παράμετρος του κλειδιού στη θέση {0} με την τιμή \"{1}\" εμφανίζεται περισσότερες από μία φορές."

#: DataAnnotations/DataAnnotationsDefaultErrorMessages.cs
msgctxt "OrchardCore.Localization.DataAnnotations.DataAnnotationsDefaultErrorMessages"
msgid "The maximum length must be a nonnegative integer."
msgstr "Το μέγιστο μήκος πρέπει να είναι μη αρνητικός ακέραιος."

#. Format arguments: {0}; {1}
#: DataAnnotations/DataAnnotationsDefaultErrorMessages.cs
#, csharp-format
msgctxt "OrchardCore.Localization.DataAnnotations.DataAnnotationsDefaultErrorMessages"
msgid "The maximum value '{0}' must be greater than or equal to the minimum value '{1}'."
msgstr "Η μέγιστη τιμή \"{0}\" πρέπει να είναι μεγαλύτερη ή ίση με την ελάχιστη τιμή \"{1}\"."

#: DataAnnotations/DataAnnotationsDefaultErrorMessages.cs
msgctxt "OrchardCore.Localization.DataAnnotations.DataAnnotationsDefaultErrorMessages"
msgid "The minimum and maximum values must be set."
msgstr "Οι ελάχιστες και μέγιστες τιμές πρέπει να οριστούν."

#: DataAnnotations/DataAnnotationsDefaultErrorMessages.cs
msgctxt "OrchardCore.Localization.DataAnnotations.DataAnnotationsDefaultErrorMessages"
msgid "The number of control parameters must be even."
msgstr "Ο αριθμός των παραμέτρων ελέγχου πρέπει να είναι ζυγός."

#: DataAnnotations/DataAnnotationsDefaultErrorMessages.cs
msgctxt "OrchardCore.Localization.DataAnnotations.DataAnnotationsDefaultErrorMessages"
msgid "The pattern must be set to a valid regular expression."
msgstr "Το μοτίβο πρέπει να οριστεί σε μια έγκυρη κανονική έκφραση (regular expression)."

#. Format arguments: {0}; {1}
#: DataAnnotations/DataAnnotationsDefaultErrorMessages.cs
#, csharp-format
msgctxt "OrchardCore.Localization.DataAnnotations.DataAnnotationsDefaultErrorMessages"
msgid "The property '{0}' on resource type '{1}' is not a string type."
msgstr "Η ιδιότητα \"{0}\" στον τύπο πόρου \"{1}\" δεν είναι τύπος string."

#. Format arguments: {0}; {1}
#: DataAnnotations/DataAnnotationsDefaultErrorMessages.cs
#, csharp-format
msgctxt "OrchardCore.Localization.DataAnnotations.DataAnnotationsDefaultErrorMessages"
msgid "The property {0}.{1} could not be found."
msgstr "Η ιδιότητα {0}. {1} δεν μπορεί να βρεθεί."

#. Format arguments: {0}; {1}
#: DataAnnotations/DataAnnotationsDefaultErrorMessages.cs
#, csharp-format
msgctxt "OrchardCore.Localization.DataAnnotations.DataAnnotationsDefaultErrorMessages"
msgid "The resource type '{0}' does not have an accessible static property named '{1}'."
msgstr "Ο τύπος πόρου \"{0}\" δεν έχει προσβάσιμη στατική ιδιότητα με το όνομα \"{1}\"."

#. Format arguments: {0}; {1}
#: DataAnnotations/DataAnnotationsDefaultErrorMessages.cs
#, csharp-format
msgctxt "OrchardCore.Localization.DataAnnotations.DataAnnotationsDefaultErrorMessages"
msgid "The type '{0}' does not contain a public property named '{1}'."
msgstr "Ο τύπος \"{0}\" δεν περιέχει μια δημόσια ιδιότητα που ονομάζεται \"{1}\"."

#. Format arguments: {0}
#: DataAnnotations/DataAnnotationsDefaultErrorMessages.cs
#, csharp-format
msgctxt "OrchardCore.Localization.DataAnnotations.DataAnnotationsDefaultErrorMessages"
msgid "The type '{0}' needs to represent an enumeration type."
msgstr "Ο τύπος \"{0}\" πρέπει να αντιπροσωπεύει έναν τύπο απαρίθμησης."

#: DataAnnotations/DataAnnotationsDefaultErrorMessages.cs
msgctxt "OrchardCore.Localization.DataAnnotations.DataAnnotationsDefaultErrorMessages"
msgid "The type provided for EnumDataTypeAttribute cannot be null."
msgstr "Ο τύπος που παρέχεται για το EnumDataTypeAttribute δεν μπορεί να είναι null."

#. Format arguments: {0}; {1}
#: DataAnnotations/DataAnnotationsDefaultErrorMessages.cs
#, csharp-format
msgctxt "OrchardCore.Localization.DataAnnotations.DataAnnotationsDefaultErrorMessages"
msgid "The type {0} must implement {1}."
msgstr "Ο τύπος {0} πρέπει να εφαρμόσει {1}."

#. Format arguments: {0}; {1}
#: DataAnnotations/DataAnnotationsDefaultErrorMessages.cs
#, csharp-format
msgctxt "OrchardCore.Localization.DataAnnotations.DataAnnotationsDefaultErrorMessages"
msgid "The value for property '{0}' must be of type '{1}'."
msgstr "Η τιμή για την ιδιότητα \"{0}\" πρέπει να είναι τύπου \"{1}\"."

#. Format arguments: {0}
#: DataAnnotations/DataAnnotationsDefaultErrorMessages.cs
#, csharp-format
