msgstr "Το πεδίο {0} δεν είναι έγκυρος αριθμός πιστωτικής κάρτας."

#. Format arguments: {0}
#: DataAnnotations/DataAnnotationsDefaultErrorMessages.cs
#, csharp-format
msgctxt "OrchardCore.Localization.DataAnnotations.DataAnnotationsDefaultErrorMessages"
msgid "The {0} field is not a valid e-mail address."
msgstr "Το πεδίο {0} δεν είναι έγκυρη διεύθυνση ηλεκτρονικού ταχυδρομείου."

#. Format arguments: {0}
#: DataAnnotations/DataAnnotationsDefaultErrorMessages.cs
#, csharp-format
msgctxt "OrchardCore.Localization.DataAnnotations.DataAnnotationsDefaultErrorMessages"
msgid "The {0} field is not a valid fully-qualified http, https, or ftp URL."
msgstr "Το πεδίο {0} δεν είναι έγκυρη διεύθυνση http, https ή ftp για σωστό URL."

#. Format arguments: {0}
#: DataAnnotations/DataAnnotationsDefaultErrorMessages.cs
#, csharp-format
msgctxt "OrchardCore.Localization.DataAnnotations.DataAnnotationsDefaultErrorMessages"
msgid "The {0} field is not a valid phone number."
msgstr "Το πεδίο {0} δεν είναι έγκυρος αριθμός τηλεφώνου."

#. Format arguments: {0}
#: DataAnnotations/DataAnnotationsDefaultErrorMessages.cs
#, csharp-format
msgctxt "OrchardCore.Localization.DataAnnotations.DataAnnotationsDefaultErrorMessages"
msgid "The {0} field is required."
msgstr "Το πεδίο {0} είναι υποχρεωτικό."

#. Format arguments: {0}; {1}
#: DataAnnotations/DataAnnotationsDefaultErrorMessages.cs
#, csharp-format
msgctxt "OrchardCore.Localization.DataAnnotations.DataAnnotationsDefaultErrorMessages"
msgid "The {0} field only accepts files with the following extensions: {1}."
msgstr "Το πεδίο {0} δέχεται μόνο αρχεία με τις ακόλουθες επεκτάσεις: {1}."

#. Format arguments: {0}; {1}
#: DataAnnotations/DataAnnotationsDefaultErrorMessages.cs
#, csharp-format
msgctxt "OrchardCore.Localization.DataAnnotations.DataAnnotationsDefaultErrorMessages"
msgid "The {0} property has not been set.  Use the {1} method to get the value."
msgstr "Η ιδιότητα {0} δεν έχει οριστεί. Χρησιμοποίησε τη μέθοδο {1} για να λάβεις την τιμή."

#. Format arguments: {0}
#: DataAnnotations/DataAnnotationsDefaultErrorMessages.cs
#, csharp-format
