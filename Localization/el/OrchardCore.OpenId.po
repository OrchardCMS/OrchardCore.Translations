#: Services/OpenIdServerService.cs
msgctxt "OrchardCore.OpenId.Services.OpenIdServerService"
msgid "Access token encryption can only be disabled when using JWT tokens."
msgstr "Η πρόσβαση στη κρυπτογράφησης συμβόλου (token) μπορεί να απενεργοποιηθεί μόνο όταν χρησιμοποιείτε JWT σύμβολα (token)."

#: Services/OpenIdServerService.cs
msgctxt "OrchardCore.OpenId.Services.OpenIdServerService"
msgid "At least one OpenID Connect flow must be enabled."
msgstr "Πρέπει να ενεργοποιηθεί τουλάχιστον μία ροή σύνδεσης OpenID."

#: Services/OpenIdServerService.cs
msgctxt "OrchardCore.OpenId.Services.OpenIdServerService"
msgid "The authority cannot contain a query string or a fragment."
msgstr "Η αρχή εξουσιοδότησης δεν μπορεί να περιέχει μια συμβολοσειρά ερωτήματος ή ένα fragment."

#: Services/OpenIdServerService.cs
msgctxt "OrchardCore.OpenId.Services.OpenIdServerService"
msgid "The authority must be a valid absolute URL."
msgstr "Η αρχή εξουσιοδότησης πρέπει να είναι μια έγκυρη απόλυτη διεύθυνση URL."

#: Services/OpenIdServerService.cs
msgctxt "OrchardCore.OpenId.Services.OpenIdServerService"
msgid "The authorization code flow cannot be enabled when the authorization and token endpoints are disabled."
msgstr "Η ροή κώδικα εξουσιοδότησης δεν μπορεί να ενεργοποιηθεί όταν τα τελικά σημεία εξουσιοδότησης και συμβολοσειρών (token) είναι απενεργοποιημένα."

#: Services/OpenIdServerService.cs
msgctxt "OrchardCore.OpenId.Services.OpenIdServerService"
msgid "The certificate cannot be found."
msgstr "Δεν είναι δυνατή η εύρεση του πιστοποιητικού."

#: Services/OpenIdServerService.cs
msgctxt "OrchardCore.OpenId.Services.OpenIdServerService"
msgid "The certificate doesn't contain the required private key."
msgstr "Το πιστοποιητικό δεν περιέχει το απαιτούμενο ιδιωτικό κλειδί."

#: Services/OpenIdServerService.cs
msgctxt "OrchardCore.OpenId.Services.OpenIdServerService"
msgid "The certificate is not valid because it is marked as archived."
msgstr "Το πιστοποιητικό δεν είναι έγκυρο επειδή έχει επισημανθεί ως αρχειοθετημένο."

#: Services/OpenIdServerService.cs
msgctxt "OrchardCore.OpenId.Services.OpenIdServerService"
msgid "The certificate is not valid for current date."
msgstr "Το πιστοποιητικό δεν ισχύει για την τρέχουσα ημερομηνία."

#: Services/OpenIdServerService.cs
msgctxt "OrchardCore.OpenId.Services.OpenIdServerService"
msgid "The client credentials flow cannot be enabled when the token endpoint is disabled."
msgstr "Η ροή διαπιστευτηρίων πελάτη δεν μπορεί να ενεργοποιηθεί όταν το τελικό σημείο συμβολού (token) είναι απενεργοποιημένο."

#: Services/OpenIdServerService.cs
msgctxt "OrchardCore.OpenId.Services.OpenIdServerService"
msgid "The hybrid flow cannot be enabled when the authorization and token endpoints are disabled."
msgstr "Η υβριδική ροή δεν μπορεί να ενεργοποιηθεί όταν είναι απενεργοποιημένα τα τελικά σημεία εξουσιοδότησης και συμβόλων (token)."

#: Services/OpenIdServerService.cs
msgctxt "OrchardCore.OpenId.Services.OpenIdServerService"
msgid "The implicit flow cannot be enabled when the authorization endpoint is disabled."
msgstr "Η υπονοούμενη ροή δεν μπορεί να ενεργοποιηθεί όταν το τελικό σημείο εξουσιοδότησης είναι απενεργοποιημένο."

#: Services/OpenIdServerService.cs
msgctxt "OrchardCore.OpenId.Services.OpenIdServerService"
msgid "The password flow cannot be enabled when the token endpoint is disabled."
msgstr "Η ροή του κωδικού πρόσβασης δεν μπορεί να ενεργοποιηθεί όταν το τελικό σημείο σύμβολου (token) είναι απενεργοποιημένο."

#: Services/OpenIdServerService.cs
msgctxt "OrchardCore.OpenId.Services.OpenIdServerService"
msgid "The pushed authorization endpoint can only be enabled when the authorization endpoint is enabled."
msgstr ""

#: Services/OpenIdServerService.cs
msgctxt "OrchardCore.OpenId.Services.OpenIdServerService"
msgid "The pushed authorization endpoint must be enabled when enforcing pushed authorization requests."
msgstr ""

#: Services/OpenIdServerService.cs
msgctxt "OrchardCore.OpenId.Services.OpenIdServerService"
msgid "The refresh token flow can only be enabled if the password, authorization code or hybrid flows are enabled."
msgstr "Η ροή ανανέωσης συμβόλου (token) μπορεί να ενεργοποιηθεί μόνο εάν είναι ενεργοποιημένος ο κωδικός πρόσβασης, ο κωδικός εξουσιοδότησης ή οι υβριδικές ροές."

#: Services/OpenIdServerService.cs
msgctxt "OrchardCore.OpenId.Services.OpenIdServerService"
msgid "The refresh token flow cannot be enabled when the token endpoint is disabled."
msgstr "Η ανανέωση της ροή συμβόλου (token) δεν μπορεί να ενεργοποιηθεί όταν το τελικό σημείο συμβόλου (token) είναι απενεργοποιημένο."

#: Services/OpenIdValidationService.cs
msgctxt "OrchardCore.OpenId.Services.OpenIdValidationService"
msgid "An audience must be set when configuring the authority."
msgstr "Κατά τη διαμόρφωση της αρχής εξουσιοδότησης πρέπει να οριστεί ακροατήριο."

#: Services/OpenIdValidationService.cs
msgctxt "OrchardCore.OpenId.Services.OpenIdValidationService"
msgid "Either a tenant or an authority must be registered."
msgstr "Πρέπει να εγγραφεί ένας ενοικιαστής ή μια αρχή εξουσιοδότησης."

#: Services/OpenIdValidationService.cs
msgctxt "OrchardCore.OpenId.Services.OpenIdValidationService"
msgid "No appropriate scope was found."
msgstr "Δεν βρέθηκε κατάλληλος σκοπός."

#: Services/OpenIdValidationService.cs
msgctxt "OrchardCore.OpenId.Services.OpenIdValidationService"
msgid "No audience can be set when using another tenant."
msgstr "Καμία ακροαματικότητα δεν μπορεί να ρυθμιστεί κατά τη χρήση άλλου ενοικιαστή."

#: Services/OpenIdValidationService.cs
msgctxt "OrchardCore.OpenId.Services.OpenIdValidationService"
msgid "No metatada address can be set when using another tenant."
msgstr "Δεν μπορεί να οριστεί διεύθυνση μεταδεδομένων κατά τη χρήση άλλου ενοικιαστή."

#: Services/OpenIdValidationService.cs
msgctxt "OrchardCore.OpenId.Services.OpenIdValidationService"
msgid "Selecting a server tenant for which reference access tokens are enabled is currently not supported."
msgstr "Η επιλογή ενός ενοικιαστή διακομιστή για τον οποίο είναι ενεργοποιημένα τα σύμβολα (tokes) πρόσβασης αναφοράς δεν υποστηρίζεται αυτήν τη στιγμή."

#: Services/OpenIdValidationService.cs
msgctxt "OrchardCore.OpenId.Services.OpenIdValidationService"
msgid "The audience cannot start with the special 'oct:' prefix."
msgstr "Η ακροαματικότητα δεν μπορεί να ξεκινήσει με το ειδικό πρόθεμα 'oct:'."

#: Services/OpenIdValidationService.cs
msgctxt "OrchardCore.OpenId.Services.OpenIdValidationService"
msgid "The authority cannot contain a query string or a fragment."
msgstr "Η αρχή εξουσιοδότησης δεν μπορεί να περιέχει μια συμβολοσειρά ερωτήματος ή ένα fragment."

#: Services/OpenIdValidationService.cs
msgctxt "OrchardCore.OpenId.Services.OpenIdValidationService"
msgid "The metadata address cannot contain a query string or a fragment."
msgstr "Η διεύθυνση μεταδεδομένων δεν μπορεί να περιέχει μια συμβολοσειρά ερωτήματος ή ένα τμήμα."

#: Services/OpenIdValidationService.cs
msgctxt "OrchardCore.OpenId.Services.OpenIdValidationService"
msgid "The specified authority is not valid."
msgstr "Η καθορισμένη αρχή εξουσιοδότησης δεν είναι έγκυρη."

#: Services/OpenIdValidationService.cs
msgctxt "OrchardCore.OpenId.Services.OpenIdValidationService"
msgid "The specified metadata address is not valid."
msgstr "Η καθορισμένη διεύθυνση μεταδεδομένων δεν είναι έγκυρη."

#: Services/OpenIdValidationService.cs
msgctxt "OrchardCore.OpenId.Services.OpenIdValidationService"
msgid "The specified tenant is not valid."
msgstr "Ο συγκεκριμένος ενοικιαστής δεν είναι έγκυρος."

#: Services/OpenIdValidationService.cs
msgctxt "OrchardCore.OpenId.Services.OpenIdValidationService"
msgid "Token type validation can only be disabled for remote servers."
msgstr "Η επικύρωση του τύπου συμβόλου (token) μπορεί να απενεργοποιηθεί μόνο για απομακρυσμένους διακομιστές."

