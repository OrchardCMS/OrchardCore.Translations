msgid "Custom user settings of {0}."
msgstr "Aangepaste gebruikersinstellingen van {0}."

#: GraphQL/UserType.cs
msgctxt "OrchardCore.Users.GraphQL.UserType"
msgid "Represents a user."
msgstr "Stelt een gebruiker voor."

#: GraphQL/UserType.cs
msgctxt "OrchardCore.Users.GraphQL.UserType"
msgid "The email of the user."
msgstr "Het e-mailadres van de gebruiker."

#: GraphQL/UserType.cs
msgctxt "OrchardCore.Users.GraphQL.UserType"
msgid "The id of the user."
msgstr "Het id van de gebruiker."

#: GraphQL/UserType.cs
msgctxt "OrchardCore.Users.GraphQL.UserType"
msgid "The name of the user."
msgstr "De naam van de gebruiker."

#: GraphQL/UserType.cs
msgctxt "OrchardCore.Users.GraphQL.UserType"
msgid "The phone number of the user."
msgstr "Het telefoonnummer van de gebruiker."

#: Services/UserService.cs
msgctxt "OrchardCore.Users.Services.UserService"
msgid "A password is required."
msgstr "Een wachtwoord is vereist."

#: Services/UserService.cs
msgctxt "OrchardCore.Users.Services.UserService"
msgid "A token is required."
msgstr "Een token is vereist."

#: Services/UserService.cs
msgctxt "OrchardCore.Users.Services.UserService"
msgid "A user name is required."
msgstr "Een gebruikersnaam is vereist."

#: Services/UserService.cs
msgctxt "OrchardCore.Users.Services.UserService"
msgid "A username or email address is required."
msgstr "Een gebruikersnaam of e-mailadres is vereist."

#. Format arguments: {0}: user.Email
#: Services/UserService.cs
#, csharp-format
msgctxt "OrchardCore.Users.Services.UserService"
msgid "Email '{0}' is already used."
msgstr "E-mail '{0}' is al in gebruik."

#. Format arguments: {0}: user.Email
#: Services/UserService.cs
#, csharp-format
msgctxt "OrchardCore.Users.Services.UserService"
msgid "Email '{0}' is invalid."
msgstr "E-mail '{0}' is ongeldig."

#: Services/UserService.cs
msgctxt "OrchardCore.Users.Services.UserService"
msgid "Incorrect password."
msgstr "Onjuist wachtwoord."

#: Services/UserService.cs
msgctxt "OrchardCore.Users.Services.UserService"
msgid "Local login is disabled."
msgstr "Lokale login is uitgeschakeld."

#. Format arguments: {0}: _identityOptions.Password.RequiredLength
#: Services/UserService.cs
#, csharp-format
msgctxt "OrchardCore.Users.Services.UserService"
msgid "Passwords must be at least {0} characters."
msgstr "Wachtwoorden moeten tenminste {0} tekens bevatten."

#. Format arguments: {0}: _identityOptions.Password.RequiredUniqueChars
#: Services/UserService.cs
#, csharp-format
msgctxt "OrchardCore.Users.Services.UserService"
msgid "Passwords must contain at least {0} unique characters."
msgstr "Wachtwoorden moeten tenminste {0} unieke tekens bevatten."

#: Services/UserService.cs
msgctxt "OrchardCore.Users.Services.UserService"
msgid "Passwords must have at least one digit character ('0'-'9')."
msgstr "Wachtwoorden moeten uit minstens één cijfer ('0'-'9') bestaan."

#: Services/UserService.cs
msgctxt "OrchardCore.Users.Services.UserService"
msgid "Passwords must have at least one lowercase character ('a'-'z')."
msgstr "Wachtwoorden moeten tenminste één kleine letter ('a' - 'z') bevatten."

#: Services/UserService.cs
msgctxt "OrchardCore.Users.Services.UserService"
msgid "Passwords must have at least one non letter or digit character."
msgstr "Wachtwoorden moeten minstens één teken bevatten dat geen letter of cijfer is."

#: Services/UserService.cs
msgctxt "OrchardCore.Users.Services.UserService"
msgid "Passwords must have at least one uppercase character ('A'-'Z')."
msgstr "Wachtwoorden moeten minstens één hoofdletter ('A' - 'Z') hebben."

#: Services/UserService.cs
msgctxt "OrchardCore.Users.Services.UserService"
msgid "The reset token is invalid. Please request a new token."
msgstr "De reset token is ongeldig. Vraag een nieuwe token aan."

#: Services/UserService.cs
msgctxt "OrchardCore.Users.Services.UserService"
msgid "The specified user is not allowed to sign in using password authentication."
msgstr "De opgegeven gebruiker mag niet inloggen met behulp van wachtwoordverificatie."

#: Services/UserService.cs
msgctxt "OrchardCore.Users.Services.UserService"
msgid "The specified user is not allowed to sign in."
msgstr "De opgegeven gebruiker mag zich niet aanmelden."

#: Services/UserService.cs
msgctxt "OrchardCore.Users.Services.UserService"
msgid "The specified username/password couple is invalid."
msgstr "Het opgegeven gebruikersnaam/wachtwoord paar is ongeldig."

#: Services/UserService.cs
msgctxt "OrchardCore.Users.Services.UserService"
msgid "The user is locked out."
msgstr "Het account is geblokkeerd."

#. Format arguments: {0}: error.Code
